{
  "name": "solar-singularity",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "audit:ui": "node scripts/ui-audit.mjs",
    "lint": "eslint . --format json -o .eslint-warnings.json && node scripts/check-lint-debt.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stylelint": "stylelint \"src/**/*.css\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "prebuild": "node scripts/build-tokens.mjs --check",
    "policy:ui": "node scripts/check-ui-policy.mjs",
    "budget:ui": "node scripts/check-budgets.mjs",
    "typecheck": "astro sync && tsc --noEmit --skipLibCheck",
    "lint:baseline": "node scripts/update-lint-baseline.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.1",
    "@astrojs/react": "^6.0.2",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260831.1",
    "@eslint/js": "^9.30.0",
    "@types/node": "26.4.0",
    "eslint": "^9.30.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "jsdom": "30.0.1",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^16.20.0",
    "stylelint-config-standard": "^38.0.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4"
  }
}
