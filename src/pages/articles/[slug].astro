---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RibbonCard from "../../components/RibbonCard.astro";
import RetroSticker from "../../components/RetroSticker.astro";
import { createSupabaseServerClient, getCurrentUserProfile } from "../../lib/supabase";
import { RealtimeComments } from "../../components/RealtimeComments";
import { ReactionBar } from "../../components/ReactionBar";
import { BookmarkButton } from "../../components/BookmarkButton";
import { parseMarkdownToHtml } from "../../lib/markdown";

const { slug } = Astro.params;

const supabase = createSupabaseServerClient({
  request: Astro.request,
  cookies: Astro.cookies
});

// Lấy thông tin người dùng hiện tại
const currentUser = await getCurrentUserProfile(supabase);

// Tải thông tin bài viết từ CSDL Supabase
const { data: dbArticle } = await supabase
  .from("articles")
  .select("*, profiles:profiles!author_id(id, full_name, avatar_url)")
  .eq("slug", slug)
  .single();

// Đăng ký Promise song song tải bình luận và bài viết liên quan từ RPC
const [commentsRes, relatedRes] = await Promise.all([
  supabase.rpc("get_comment_tree", { p_article_id: slug || "" }),
  dbArticle 
    ? supabase.rpc("get_related_articles", { p_slug: slug || "", p_limit: 3 })
    : Promise.resolve({ data: [] })
]);

const initialComments = (commentsRes.data || []).map((c: any) => ({
  id: c.id,
  article_id: c.article_id,
  content: c.content,
  created_at: c.created_at,
  parent_id: c.parent_id,
  depth: c.depth,
  profiles: {
    id: c.profile_id,
    full_name: c.full_name,
    avatar_url: c.avatar_url
  }
}));
const relatedData = relatedRes.data || [];

let article: any = null;

if (dbArticle) {
  article = {
    title: dbArticle.title,
    excerpt: dbArticle.excerpt || "Khám phá nghệ thuật hoài cổ Vaporwave...",
    content: dbArticle.body_md,
    cover: dbArticle.cover_url || "https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=1000&auto=format&fit=crop",
    date: new Date(dbArticle.created_at).toLocaleDateString("vi-VN"),
    author: dbArticle.profiles?.full_name || "ADMIN",
    authorId: dbArticle.profiles?.id || null,
    authorAvatar: dbArticle.profiles?.avatar_url,
    tags: dbArticle.tags || [],
    view_count: dbArticle.view_count || 0
  };

  // Tăng lượt xem bài viết
  await supabase
    .from("articles")
    .update({ view_count: (dbArticle.view_count || 0) + 1 })
    .eq("id", dbArticle.id);
} else {
  // Dự phòng các bài viết tĩnh mẫu ban đầu
  if (slug === "retro-computing-aesthetic" || slug === "neon-dreamscape-art") {
    article = {
      title: slug === "retro-computing-aesthetic" 
        ? "Hoài Niệm Windows 95: Vẻ Đẹp Của Hệ Điều Hành Cổ Điển"
        : "Neon Dreamscape: Sự Trỗi Dậy Của Không Gian Màu Neon 3D",
      excerpt: "Tìm hiểu cội nguồn và phong cách hoài cổ đặc thù của văn hóa Vaporwave.",
      content: "Không gian mạng (Cyberspace) và hoài cổ kỹ thuật số luôn là các chủ đề cốt lõi của nghệ thuật Vaporwave. Bằng cách sử dụng các hình ảnh kiến trúc cổ điển Hy Lạp kết hợp với giao diện desktop xám xi măng của Windows 95, các tác phẩm Vaporwave tạo ra cảm giác lơ lửng, hư vô của thời gian. Các đường kẻ CRT ngang màn hình cùng với hoạt ảnh lỗi kỹ thuật (glitch) không chỉ là công cụ trang trí, mà còn là bản tuyên ngôn phản kháng lại tính sắc sảo của thời kỳ đồ họa độ phân giải siêu cao ngày nay...",
      cover: slug === "retro-computing-aesthetic"
        ? "https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=1000&auto=format&fit=crop"
        : "https://images.unsplash.com/photo-1508739773434-c26b3d09e071?w=1000&auto=format&fit=crop",
      date: "20/05/2026",
      author: "AESTHETIC WRITER",
      authorId: null,
      authorAvatar: null,
      tags: ["vaporwave", "retro", "95"],
      view_count: 95
    };
  } else {
    return Astro.redirect("/?error=article-not-found");
  }
}

// 1. Tạo Open Graph Image
let ogImageUrl = article.cover;
if (article.cover.includes("res.cloudinary.com")) {
  ogImageUrl = article.cover.replace("/image/upload/", "/image/upload/w_1200,h_630,c_fill,q_auto,f_auto/");
}

// 2. Structured Data JSON-LD
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": article.title,
  "description": article.excerpt,
  "image": article.cover,
  "datePublished": dbArticle ? dbArticle.published_at || dbArticle.created_at : "2026-05-20T00:00:00Z",
  "author": {
    "@type": "Person",
    "name": article.author,
    "url": article.authorId ? `${Astro.url.origin}/profile/${article.authorId}` : undefined
  },
  "publisher": {
    "@type": "Organization",
    "name": "Vaporwave Art Journal",
    "logo": {
      "@type": "ImageObject",
      "url": `${Astro.url.origin}/favicon.svg`
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": Astro.url.href
  }
};

// 3. Logic bài viết liên quan
let relatedArticles = [];
if (dbArticle && relatedData && relatedData.length > 0) {
  relatedArticles = relatedData.map((art: any) => ({
    slug: art.slug,
    title: art.title,
    excerpt: art.excerpt || "Khám phá nghệ thuật Vaporwave...",
    cover: art.cover_url || "https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=600&auto=format&fit=crop",
    date: new Date(art.created_at).toLocaleDateString("vi-VN")
  }));
} else {
  const fallbackSlug = slug === "retro-computing-aesthetic" ? "neon-dreamscape-art" : "retro-computing-aesthetic";
  relatedArticles = [
    {
      slug: fallbackSlug,
      title: fallbackSlug === "retro-computing-aesthetic" 
        ? "Hoài Niệm Windows 95: Vẻ Đẹp Của Hệ Điều Hành Cổ Điển"
        : "Neon Dreamscape: Sự Trỗi Dậy Của Không Gian Màu Neon 3D",
      excerpt: "Khám phá phong cách thiết kế đồ họa máy tính thời kỳ đầu.",
      cover: fallbackSlug === "retro-computing-aesthetic"
        ? "https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=600&auto=format&fit=crop"
        : "https://images.unsplash.com/photo-1508739773434-c26b3d09e071?w=600&auto=format&fit=crop",
      date: "20/05/2026"
    }
  ];
}
---

<BaseLayout 
  title={`${article.title} // VAPOR JOURNAL`} 
  description={article.excerpt}
  ogImage={ogImageUrl}
  canonicalUrl={Astro.url.href}
  articleJsonLd={articleJsonLd}
  userProfile={currentUser}
>
  <!-- Thanh tiến trình đọc bài viết (Reading Progress Indicator) -->
  <div id="reading-progress-bar" class="fixed top-0 left-0 h-1 bg-gradient-to-r from-vapor-pink via-vapor-purple to-vapor-blue z-50 transition-all duration-150" style="width: 0%;"></div>

  <!-- Header Action Bar -->
  <div class="mb-4 flex justify-between items-center font-retro">
    <a href="/" class="win95-btn text-black px-3 py-1.5 font-bold no-underline" style="min-height: 32px;">
      &lt;&lt; QUAY LẠI TRANG CHỦ
    </a>

    <div class="flex items-center gap-2 flex-wrap justify-end">
      <BookmarkButton client:visible articleId={article.id} isLoggedIn={!!currentUser} />
      <button id="native-share-btn" hidden class="win95-btn text-black px-3 py-1.5 font-bold" style="min-height: 32px;" aria-label="Chia sẻ qua ứng dụng thiết bị">
        📤 CHIA SẺ
      </button>
      <button id="share-article-btn" class="win95-btn text-black px-3 py-1.5 font-bold" style="min-height: 32px;">
        🔗 COPY
      </button>
      <a
        id="share-facebook"
        href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.href)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="win95-btn text-black px-3 py-1.5 font-bold no-underline"
        style="min-height: 32px;"
        aria-label="Chia sẻ lên Facebook"
      >
        📘 FB
      </a>
      <a
        id="share-x"
        href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(Astro.url.href)}&text=${encodeURIComponent((article.title || "") + " — LOVELYYELLOWCAT")}`}
        target="_blank"
        rel="noopener noreferrer"
        class="win95-btn text-black px-3 py-1.5 font-bold no-underline"
        style="min-height: 32px;"
        aria-label="Chia sẻ lên X / Twitter"
      >
        𝕏 POST
      </a>
      <button onclick="window.print()" class="win95-btn text-black px-3 py-1.5 font-bold no-print" style="min-height: 32px;">
        🖨️ IN BÀI
      </button>
    </div>
  </div>

  <!-- Win95 WordPad / Document Viewer Window -->
  <article class="win95-window w-full font-retro mb-8 text-black">
    <!-- Window Titlebar -->
    <div class="win95-header py-1 px-2">
      <div class="flex items-center gap-1.5 truncate">
        <span>📝</span>
        <span class="truncate font-bold text-xs">WORDPAD.EXE - [{article.title}.DOC]</span>
      </div>
      <div class="flex gap-1 shrink-0" aria-hidden="true">
        <button class="win95-btn py-0 px-1 text-[10px]" tabindex="-1" aria-label="Thu nhỏ (trang trí)">_</button>
        <button class="win95-btn py-0 px-1 text-[10px]" tabindex="-1" aria-label="Phóng to (trang trí)">□</button>
        <button class="win95-btn py-0 px-1 text-[10px]" tabindex="-1" aria-label="Đóng (trang trí)">✕</button>
      </div>
    </div>

    <!-- WordPad Menubar -->
    <div class="win95-menubar">
      <span>File</span>
      <span>Edit</span>
      <span>View</span>
      <span>Insert</span>
      <span>Format</span>
      <span>Help</span>
    </div>

    <!-- Interactive WordPad Toolbar -->
    <div class="bg-win-gray border-b border-win-dark p-1.5 flex flex-wrap items-center gap-1.5 text-xs select-none" id="wordpad-toolbar">
      <!-- Font Family Selector -->
      <div class="relative">
        <select
          id="wp-font-select"
          class="font-mono bg-white px-1.5 py-0.5 border border-win-dark text-[10px] text-black cursor-pointer outline-none appearance-none pr-4"
          title="Chọn kiểu chữ hiển thị bài viết"
          style="min-width: 115px;"
        >
          <option value="'Outfit', sans-serif">Outfit (Mặc định)</option>
          <option value="'VT323', monospace">VT323 (Retro)</option>
          <option value="'JetBrains Mono', monospace">JetBrains Mono</option>
          <option value="'Press Start 2P', cursive">Press Start 2P</option>
          <option value="Georgia, serif">Georgia (Serif)</option>
          <option value="'Courier New', monospace">Courier New</option>
          <option value="'Times New Roman', serif">Times New Roman</option>
          <option value="Verdana, sans-serif">Verdana</option>
          <option value="'Comic Sans MS', cursive">Comic Sans MS</option>
        </select>
        <span class="absolute right-1 top-1/2 -translate-y-1/2 text-[10px] text-win-dark pointer-events-none">▼</span>
      </div>

      <!-- Font Size Selector -->
      <select
        id="wp-size-select"
        class="font-mono bg-white px-1 py-0.5 border border-win-dark text-[10px] text-black cursor-pointer outline-none"
        title="Chọn cỡ chữ (pt)"
        style="min-width: 48px;"
      >
        <option value="11">11</option>
        <option value="12">12</option>
        <option value="14" selected>14</option>
        <option value="16">16</option>
        <option value="18">18</option>
        <option value="20">20</option>
        <option value="24">24</option>
      </select>

      <!-- Separator -->
      <div class="h-5 border-l border-win-dark mx-0.5"></div>

      <!-- Format Buttons: Bold, Italic, Underline, Strikethrough -->
      <button
        type="button"
        id="wp-btn-bold"
        class="wp-format-btn win95-btn py-0 px-1.5 font-bold text-black"
        title="In đậm nội dung bài viết (B)"
        style="min-height: 22px; min-width: 22px;"
      >B</button>
      <button
        type="button"
        id="wp-btn-italic"
        class="wp-format-btn win95-btn py-0 px-1.5 italic text-black"
        title="In nghiêng nội dung bài viết (I)"
        style="min-height: 22px; min-width: 22px;"
      >I</button>
      <button
        type="button"
        id="wp-btn-underline"
        class="wp-format-btn win95-btn py-0 px-1.5 underline text-black"
        title="Gạch chân nội dung bài viết (U)"
        style="min-height: 22px; min-width: 22px;"
      >U</button>
      <button
        type="button"
        id="wp-btn-strike"
        class="wp-format-btn win95-btn py-0 px-1.5 line-through text-black"
        title="Gạch ngang nội dung bài viết (S)"
        style="min-height: 22px; min-width: 22px;"
      >S</button>

      <!-- Separator -->
      <div class="h-5 border-l border-win-dark mx-0.5"></div>

      <!-- Text Alignment -->
      <button
        type="button"
        id="wp-btn-align-left"
        class="wp-align-btn win95-btn py-0 px-1.5 text-[10px] text-black win95-sunken"
        title="Căn lề trái"
        data-align="left"
        style="min-height: 22px;"
      >☰ᐊ</button>
      <button
        type="button"
        id="wp-btn-align-center"
        class="wp-align-btn win95-btn py-0 px-1.5 text-[10px] text-black"
        title="Căn giữa"
        data-align="center"
        style="min-height: 22px;"
      >☰</button>
      <button
        type="button"
        id="wp-btn-align-right"
        class="wp-align-btn win95-btn py-0 px-1.5 text-[10px] text-black"
        title="Căn lề phải"
        data-align="right"
        style="min-height: 22px;"
      >ᐅ☰</button>
      <button
        type="button"
        id="wp-btn-align-justify"
        class="wp-align-btn win95-btn py-0 px-1.5 text-[10px] text-black"
        title="Căn đều 2 bên (Justify)"
        data-align="justify"
        style="min-height: 22px;"
      >☰☰</button>

      <!-- Separator -->
      <div class="h-5 border-l border-win-dark mx-0.5"></div>

      <!-- Line Height -->
      <select
        id="wp-line-height"
        class="font-mono bg-white px-1 py-0.5 border border-win-dark text-[10px] text-black cursor-pointer outline-none"
        title="Giãn dòng"
        style="min-width: 40px;"
      >
        <option value="1.4">1.4</option>
        <option value="1.6">1.6</option>
        <option value="1.8" selected>1.8</option>
        <option value="2.0">2.0</option>
        <option value="2.4">2.4</option>
      </select>

      <!-- Separator -->
      <div class="h-5 border-l border-win-dark mx-0.5"></div>

      <!-- Night Mode -->
      <button
        type="button"
        id="wp-btn-nightmode"
        class="win95-btn py-0 px-1.5 text-[10px] text-black flex items-center gap-0.5"
        title="Chế độ đọc ban đêm (tối giản, dễ đọc trong tối)"
        style="min-height: 22px;"
      >🌙</button>

      <!-- Zoom Controls -->
      <button
        type="button"
        id="wp-btn-zoom-out"
        class="win95-btn py-0 px-1 text-[10px] text-black font-bold"
        title="Thu nhỏ nội dung"
        style="min-height: 22px;"
      >−</button>
      <span id="wp-zoom-level" class="text-[10px] font-mono font-bold text-win-darkest w-7 text-center">100%</span>
      <button
        type="button"
        id="wp-btn-zoom-in"
        class="win95-btn py-0 px-1 text-[10px] text-black font-bold"
        title="Phóng to nội dung"
        style="min-height: 22px;"
      >+</button>

      <!-- Reset All -->
      <button
        type="button"
        id="wp-btn-reset"
        class="win95-btn py-0 px-1.5 text-[10px] text-black font-bold"
        title="Khôi phục toàn bộ về mặc định"
        style="min-height: 22px;"
      >↺ Reset</button>
    </div>

    <!-- Document Content Area (Sunken White Page) -->
    <div id="wordpad-document" class="p-4 sm:p-8 bg-white border-2 border-win-darkest shadow-inner my-2 mx-1 sm:mx-2 transition-all duration-200">
      
      <!-- Article Cover Image -->
      {article.cover && (
        <div class="mb-6 border-2 border-black bg-black overflow-hidden shadow-md">
          <img
            src={article.cover}
            alt={article.title}
            class="w-full max-h-[460px] object-cover filter saturate-125 contrast-105"
          />
        </div>
      )}
      
      <!-- Article Header & Metadata -->
      <div class="border-b-2 border-black pb-4 mb-6">
        <div class="flex flex-wrap gap-2 mb-3">
          {article.tags.map((tag: string) => (
            <RetroSticker text={tag} variant="pill" />
          ))}
        </div>

        <h1 class="text-xl sm:text-3xl font-black uppercase tracking-tight text-black leading-tight font-retro">
          {article.title}
        </h1>

        <div class="flex flex-wrap justify-between items-center gap-2 mt-4 pt-3 border-t border-win-dark text-xs font-mono">
          <div class="flex items-center gap-2">
            {article.authorAvatar && (
              <img src={article.authorAvatar} alt="Avatar" class="w-6 h-6 border border-black object-cover filter saturate-150" />
            )}
            <span>
              Tác giả: {article.authorId ? (
                <a href={`/profile/${article.authorId}`} class="text-link-blue hover:underline font-bold">
                  {article.author}
                </a>
              ) : (
                <span class="font-bold">{article.author}</span>
              )}
            </span>
          </div>
          
          <div class="flex items-center gap-3 text-black/70">
            <span>📅 {article.date}</span>
            <span>💾 LƯỢT XEM: {article.view_count}</span>
          </div>
        </div>
      </div>

      <!-- Excerpt Callout Block -->
      {article.excerpt && (
        <div class="border-l-4 border-vapor-purple bg-vapor-pink/10 p-3 sm:p-4 mb-6 text-xs sm:text-sm font-body italic text-black leading-relaxed">
          {article.excerpt}
        </div>
      )}

      <!-- Main Body Markdown -->
      <div id="wordpad-body-content" class="prose prose-neutral max-w-none font-body text-black text-sm sm:text-base leading-relaxed space-y-4 transition-all duration-200">
        <div set:html={parseMarkdownToHtml(article.content)} />
      </div>
    </div>

    <!-- WordPad Statusbar -->
    <div class="win95-statusbar justify-between text-[10px]">
      <span id="wp-statusbar-text">Document loaded successfully. Ready.</span>
      <div class="flex items-center gap-2">
        <span id="wp-word-count" class="win95-statusbar-panel font-mono text-win-dark"></span>
        <span class="win95-statusbar-panel font-mono" id="wp-format-info">Định dạng: Mặc định</span>
      </div>
    </div>
  </article>

  <!-- Reaction Bar -->
  <div class="mb-8">
    <ReactionBar client:visible articleId={slug || "unknown"} currentUser={currentUser} />
  </div>

  <!-- Related Articles Stack -->
  {relatedArticles.length > 0 && (
    <div class="win95-container w-full font-retro mb-10 text-black">
      <div class="win95-header py-1 px-2">
        <div class="flex items-center gap-1.5">
          <span>📑</span>
          <span class="font-bold text-xs">RELATED_ARTICLES.SYS // BÀI VIẾT LIÊN QUAN</span>
        </div>
      </div>
      <div class="p-4 bg-win-gray">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {relatedArticles.map((related: any, i: number) => (
            <RibbonCard
              title={related.title}
              tint={i === 0 ? "salmon" : i === 1 ? "sage" : "periwinkle"}
              imageUrl={related.cover}
              href={`/articles/${related.slug}`}
              date={related.date}
            >
              <p class="text-xs text-black font-body line-clamp-2">
                {related.excerpt}
              </p>
            </RibbonCard>
          ))}
        </div>
      </div>
    </div>
  )}

  <!-- Realtime Comments Island -->
  <div class="max-w-4xl mx-auto mb-16">
    <div class="border-2 border-black bg-gradient-to-r from-vapor-purple to-vapor-pink p-2 text-white font-retro text-center mb-4 shadow-md">
      <h3 class="text-base sm:text-lg font-black uppercase tracking-widest drop-shadow-sm">
        💬 DIỄN ĐÀN THẢO LUẬN NGHỆ THUẬT // REALTIME STREAM
      </h3>
    </div>
    <RealtimeComments
      client:visible
      articleId={slug || "unknown"}
      initialComments={initialComments}
      currentUser={currentUser}
    />
  </div>
</BaseLayout>

<script>
  // ─── Reading Progress Bar ───
  window.addEventListener("scroll", () => {
    const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
    if (totalHeight > 0) {
      const progress = (window.scrollY / totalHeight) * 100;
      const bar = document.getElementById("reading-progress-bar");
      if (bar) bar.style.width = `${progress}%`;
    }
  });

  // ─── Share Article: Web Share API + Copy Link ───
  const shareBtn = document.getElementById("share-article-btn");
  if (shareBtn) {
    shareBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        const originalText = shareBtn.textContent;
        shareBtn.textContent = "✅ ĐÃ COPY!";
        setTimeout(() => {
          shareBtn.textContent = originalText;
        }, 2000);
      } catch (err) {
        import("../../ui/wm95/dialogService").then(function (m) {
          m.uiAlert("Đường dẫn: " + window.location.href, "share-url");
        });
      }
    });
  }

  // Nút chia sẻ hệ thống (hiện trên mobile / trình duyệt hỗ trợ Web Share API)
  const nativeShareBtn = document.getElementById("native-share-btn");
  if (nativeShareBtn && typeof navigator.share === "function") {
    nativeShareBtn.hidden = false;
    nativeShareBtn.addEventListener("click", async () => {
      try {
        await navigator.share({
          title: document.title,
          url: window.location.href,
        });
      } catch (err: any) {
        if (err?.name !== "AbortError") {
          try {
            await navigator.clipboard.writeText(window.location.href);
            nativeShareBtn.textContent = "✅ ĐÃ COPY!";
            setTimeout(() => { nativeShareBtn.textContent = "📤 CHIA SẺ"; }, 2000);
          } catch {}
        }
      }
    });
  }

  // ─── WordPad Interactive Toolbar Engine ───
  (function initWordPadToolbar() {
    const doc = document.getElementById("wordpad-document");
    const body = document.getElementById("wordpad-body-content");
    const statusText = document.getElementById("wp-statusbar-text");
    const formatInfo = document.getElementById("wp-format-info");
    const wordCountEl = document.getElementById("wp-word-count");
    const zoomLabel = document.getElementById("wp-zoom-level");

    if (!doc || !body) return;

    // ─ State ─
    let isNightMode = false;
    let isBold = false;
    let isItalic = false;
    let isUnderline = false;
    let isStrike = false;
    let currentAlign = "left";
    let zoomLevel = 100;

    // ─ Đếm chữ ─
    function updateWordCount() {
      if (!wordCountEl) return;
      const text = body.textContent || "";
      const words = text.trim().split(/\s+/).filter(w => w.length > 0).length;
      wordCountEl.textContent = `${words.toLocaleString("vi-VN")} từ`;
    }
    updateWordCount();

    // ─ Status Bar cập nhật ─
    function updateFormatStatus() {
      if (!formatInfo) return;
      const parts = [];
      if (isBold) parts.push("Đậm");
      if (isItalic) parts.push("Nghiêng");
      if (isUnderline) parts.push("Gạch chân");
      if (isStrike) parts.push("Gạch ngang");
      if (isNightMode) parts.push("🌙 Đêm");

      const alignMap: Record<string, string> = { left: "Trái", center: "Giữa", right: "Phải", justify: "Đều" };
      if (currentAlign !== "left") parts.push(`Căn: ${alignMap[currentAlign] || currentAlign}`);
      if (zoomLevel !== 100) parts.push(`${zoomLevel}%`);

      formatInfo.textContent = parts.length > 0 ? parts.join(" · ") : "Định dạng: Mặc định";
    }

    function flashStatus(msg: string) {
      if (!statusText) return;
      statusText.textContent = msg;
      setTimeout(() => {
        statusText.textContent = "Document loaded successfully. Ready.";
      }, 2000);
    }

    // ─ Toggle Active Visual cho nút ─
    function toggleBtnActive(id: string, active: boolean) {
      const btn = document.getElementById(id);
      if (!btn) return;
      if (active) {
        btn.classList.add("win95-sunken", "bg-white");
      } else {
        btn.classList.remove("win95-sunken", "bg-white");
      }
    }

    // ═══ FONT FAMILY ═══
    const fontSelect = document.getElementById("wp-font-select") as HTMLSelectElement;
    if (fontSelect) {
      fontSelect.addEventListener("change", () => {
        body.style.fontFamily = fontSelect.value;
        const label = fontSelect.options[fontSelect.selectedIndex].text;
        flashStatus(`Kiểu chữ: ${label}`);
        updateFormatStatus();
      });
    }

    // ═══ FONT SIZE ═══
    const sizeSelect = document.getElementById("wp-size-select") as HTMLSelectElement;
    if (sizeSelect) {
      sizeSelect.addEventListener("change", () => {
        body.style.fontSize = `${sizeSelect.value}px`;
        flashStatus(`Cỡ chữ: ${sizeSelect.value}pt`);
        updateFormatStatus();
      });
    }

    // ═══ BOLD ═══
    const boldBtn = document.getElementById("wp-btn-bold");
    if (boldBtn) {
      boldBtn.addEventListener("click", () => {
        isBold = !isBold;
        body.style.fontWeight = isBold ? "bold" : "";
        toggleBtnActive("wp-btn-bold", isBold);
        flashStatus(isBold ? "In đậm: BẬT" : "In đậm: TẮT");
        updateFormatStatus();
      });
    }

    // ═══ ITALIC ═══
    const italicBtn = document.getElementById("wp-btn-italic");
    if (italicBtn) {
      italicBtn.addEventListener("click", () => {
        isItalic = !isItalic;
        body.style.fontStyle = isItalic ? "italic" : "";
        toggleBtnActive("wp-btn-italic", isItalic);
        flashStatus(isItalic ? "In nghiêng: BẬT" : "In nghiêng: TẮT");
        updateFormatStatus();
      });
    }

    // ═══ UNDERLINE ═══
    const underlineBtn = document.getElementById("wp-btn-underline");
    if (underlineBtn) {
      underlineBtn.addEventListener("click", () => {
        isUnderline = !isUnderline;
        body.style.textDecoration = isUnderline && isStrike ? "underline line-through" : isUnderline ? "underline" : isStrike ? "line-through" : "";
        toggleBtnActive("wp-btn-underline", isUnderline);
        flashStatus(isUnderline ? "Gạch chân: BẬT" : "Gạch chân: TẮT");
        updateFormatStatus();
      });
    }

    // ═══ STRIKETHROUGH ═══
    const strikeBtn = document.getElementById("wp-btn-strike");
    if (strikeBtn) {
      strikeBtn.addEventListener("click", () => {
        isStrike = !isStrike;
        body.style.textDecoration = isUnderline && isStrike ? "underline line-through" : isUnderline ? "underline" : isStrike ? "line-through" : "";
        toggleBtnActive("wp-btn-strike", isStrike);
        flashStatus(isStrike ? "Gạch ngang: BẬT" : "Gạch ngang: TẮT");
        updateFormatStatus();
      });
    }

    // ═══ TEXT ALIGNMENT ═══
    const alignBtns = document.querySelectorAll(".wp-align-btn");
    alignBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        const align = btn.getAttribute("data-align") || "left";
        currentAlign = align;
        body.style.textAlign = align;

        // Toggle visual active
        alignBtns.forEach(b => b.classList.remove("win95-sunken"));
        btn.classList.add("win95-sunken");

        const names: Record<string, string> = { left: "Trái", center: "Giữa", right: "Phải", justify: "Đều 2 bên" };
        flashStatus(`Căn lề: ${names[align] || align}`);
        updateFormatStatus();
      });
    });

    // ═══ LINE HEIGHT ═══
    const lineHeightSelect = document.getElementById("wp-line-height") as HTMLSelectElement;
    if (lineHeightSelect) {
      lineHeightSelect.addEventListener("change", () => {
        body.style.lineHeight = lineHeightSelect.value;
        flashStatus(`Giãn dòng: ${lineHeightSelect.value}`);
        updateFormatStatus();
      });
    }

    // ═══ NIGHT MODE ═══
    const nightBtn = document.getElementById("wp-btn-nightmode");
    if (nightBtn) {
      nightBtn.addEventListener("click", () => {
        isNightMode = !isNightMode;
        if (isNightMode) {
          doc.style.backgroundColor = "#1a1a2e";
          doc.style.color = "#e0e0e0";
          doc.style.borderColor = "#333";
          body.style.color = "#d4d4d4";
          // Tìm tất cả các phần tử văn bản bên trong và chuyển sang màu sáng
          body.querySelectorAll("p, span, li, td, th, h1, h2, h3, h4, h5, h6, blockquote, div").forEach(el => {
            (el as HTMLElement).style.color = "#d4d4d4";
          });
          body.querySelectorAll("a").forEach(el => {
            (el as HTMLElement).style.color = "#71bfff";
          });
          body.querySelectorAll("pre, code").forEach(el => {
            (el as HTMLElement).style.backgroundColor = "#0d0d1a";
          });
          nightBtn.textContent = "☀️";
          toggleBtnActive("wp-btn-nightmode", true);
        } else {
          doc.style.backgroundColor = "";
          doc.style.color = "";
          doc.style.borderColor = "";
          body.style.color = "";
          body.querySelectorAll("p, span, li, td, th, h1, h2, h3, h4, h5, h6, blockquote, div").forEach(el => {
            (el as HTMLElement).style.color = "";
          });
          body.querySelectorAll("a").forEach(el => {
            (el as HTMLElement).style.color = "";
          });
          body.querySelectorAll("pre, code").forEach(el => {
            (el as HTMLElement).style.backgroundColor = "";
          });
          nightBtn.textContent = "🌙";
          toggleBtnActive("wp-btn-nightmode", false);
        }
        flashStatus(isNightMode ? "Chế độ ban đêm: BẬT" : "Chế độ ban ngày: BẬT");
        updateFormatStatus();
      });
    }

    // ═══ ZOOM ═══
    const zoomInBtn = document.getElementById("wp-btn-zoom-in");
    const zoomOutBtn = document.getElementById("wp-btn-zoom-out");

    function applyZoom() {
      doc.style.transform = `scale(${zoomLevel / 100})`;
      doc.style.transformOrigin = "top left";
      doc.style.width = `${10000 / zoomLevel}%`;
      if (zoomLabel) zoomLabel.textContent = `${zoomLevel}%`;
      flashStatus(`Thu phóng: ${zoomLevel}%`);
      updateFormatStatus();
    }

    if (zoomInBtn) {
      zoomInBtn.addEventListener("click", () => {
        if (zoomLevel < 150) {
          zoomLevel += 10;
          applyZoom();
        }
      });
    }
    if (zoomOutBtn) {
      zoomOutBtn.addEventListener("click", () => {
        if (zoomLevel > 70) {
          zoomLevel -= 10;
          applyZoom();
        }
      });
    }

    // ═══ RESET ALL ═══
    const resetBtn = document.getElementById("wp-btn-reset");
    if (resetBtn) {
      resetBtn.addEventListener("click", () => {
        // Reset state
        isBold = false; isItalic = false; isUnderline = false; isStrike = false;
        isNightMode = false; currentAlign = "left"; zoomLevel = 100;

        // Reset body styles
        body.style.fontFamily = "";
        body.style.fontSize = "";
        body.style.fontWeight = "";
        body.style.fontStyle = "";
        body.style.textDecoration = "";
        body.style.textAlign = "";
        body.style.lineHeight = "";
        body.style.color = "";

        // Reset doc styles (night mode)
        doc.style.backgroundColor = "";
        doc.style.color = "";
        doc.style.borderColor = "";
        doc.style.transform = "";
        doc.style.transformOrigin = "";
        doc.style.width = "";

        // Reset night mode colors
        body.querySelectorAll("p, span, li, td, th, h1, h2, h3, h4, h5, h6, blockquote, div, a, pre, code").forEach(el => {
          (el as HTMLElement).style.color = "";
          (el as HTMLElement).style.backgroundColor = "";
        });

        // Reset selects
        if (fontSelect) fontSelect.selectedIndex = 0;
        if (sizeSelect) sizeSelect.value = "14";
        if (lineHeightSelect) lineHeightSelect.value = "1.8";
        if (zoomLabel) zoomLabel.textContent = "100%";

        // Reset button visuals
        ["wp-btn-bold", "wp-btn-italic", "wp-btn-underline", "wp-btn-strike", "wp-btn-nightmode"].forEach(id => {
          toggleBtnActive(id, false);
        });
        const nightBtnEl = document.getElementById("wp-btn-nightmode");
        if (nightBtnEl) nightBtnEl.textContent = "🌙";

        alignBtns.forEach(b => b.classList.remove("win95-sunken"));
        const leftBtn = document.getElementById("wp-btn-align-left");
        if (leftBtn) leftBtn.classList.add("win95-sunken");

        flashStatus("✓ Đã khôi phục toàn bộ về mặc định.");
        updateFormatStatus();
      });
    }

    // ─── Keyboard Shortcuts ───
    document.addEventListener("keydown", (e) => {
      // Chỉ kích hoạt khi không đang nhập liệu
      if ((e.target as HTMLElement).tagName === "INPUT" || (e.target as HTMLElement).tagName === "TEXTAREA") return;

      if (e.ctrlKey || e.metaKey) {
        if (e.key === "b" || e.key === "B") {
          e.preventDefault();
          boldBtn?.click();
        } else if (e.key === "i" || e.key === "I") {
          e.preventDefault();
          italicBtn?.click();
        } else if (e.key === "u" || e.key === "U") {
          e.preventDefault();
          underlineBtn?.click();
        } else if (e.key === "=" || e.key === "+") {
          e.preventDefault();
          zoomInBtn?.click();
        } else if (e.key === "-") {
          e.preventDefault();
          zoomOutBtn?.click();
        } else if (e.key === "0") {
          e.preventDefault();
          resetBtn?.click();
        }
      }
    });
  })();
</script>
