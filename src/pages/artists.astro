---
import BaseLayout from "../layouts/BaseLayout.astro";
import RetroSticker from "../components/RetroSticker.astro";
import { createSupabaseServerClient, getCurrentUserProfile } from "../lib/supabase";

const supabase = createSupabaseServerClient({
  request: Astro.request,
  cookies: Astro.cookies
});

// Tải thông tin phiên người dùng hiện tại
const userProfile = await getCurrentUserProfile(supabase);

// Tải danh sách nghệ sĩ hoạt động từ view thống kê public.artist_stats
const { data: artists } = await supabase
  .from("artist_stats")
  .select("*");

const activeArtists = artists || [];
---

<BaseLayout
  title="COMMUNITY_ARTISTS.EXE // VAPOR MAGAZINE"
  description="Khám phá và kết nối với các nghệ sĩ kỹ thuật số tích cực nhất trong cộng đồng nghệ thuật hoài cổ Vaporwave."
  userProfile={userProfile}
>
  <!-- Hero Section -->
  <div class="text-center py-6">
    <h1 class="hero-title text-glitch-soft">
      Aesthetic Creators
    </h1>
    <p class="text-[10px] sm:text-xs tracking-[0.2em] text-vapor-blue mt-3 font-mono uppercase">
      // NETWORK NEIGHBORHOOD // CYBER ARTIST DIRECTORY //
    </p>
  </div>

  <!-- Network Neighborhood Container -->
  <div class="mt-4 win95-window p-3 sm:p-4">
    <div class="win95-header py-1 px-2 mb-4 bg-gradient-to-r from-win-titlebar to-vapor-blue-dark">
      <div class="flex items-center gap-1.5">
        <span>👥</span>
        <span class="font-bold text-xs">NETWORK_NEIGHBORHOOD.EXE - [DANH SÁCH THÀNH VIÊN SÁNG TẠO]</span>
      </div>
      <div class="flex items-center gap-1 text-[10px] font-mono">
        <span class="bg-black text-vapor-green px-1.5 py-0.5">{activeArtists.length} NGHỆ SĨ</span>
      </div>
    </div>

    <!-- Status & Info Callout -->
    <div class="win95-sunken bg-white p-3 mb-6 font-retro text-xs text-black flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
      <div>
        <span class="font-bold text-vapor-purple">● Mạng lưới kết nối nghệ thuật trực tuyến:</span> Khám phá hồ sơ cá nhân, bộ sưu tập tranh và tương tác cùng các tác giả tài năng.
      </div>
      <a href="/submit" class="win95-btn py-1 px-3 bg-vapor-green/20 border border-black font-bold text-black no-underline shrink-0" style="min-height: 28px;">
        🎨 Đăng Ký Trở Thành Nghệ Sĩ
      </a>
    </div>

    {activeArtists.length === 0 ? (
      <div class="win95-container bg-win-gray p-12 text-center text-win-dark font-bold space-y-3">
        <p class="text-4xl">👥</p>
        <p class="text-xs uppercase text-black font-mono">CHƯA CÓ NGHỆ SĨ NÀO TRONG MẠNG LƯỚI</p>
        <p class="text-[10px] text-win-darkest max-w-sm mx-auto">
          Hãy là người đầu tiên đăng tải tác phẩm và khởi tạo hồ sơ nghệ sĩ trên Cybernet!
        </p>
        <a href="/submit" class="win95-btn inline-block mt-2 px-6 py-2 no-underline text-black font-bold uppercase" style="min-height: 36px;">
          🎨 Gửi Tác Phẩm Đầu Tiên
        </a>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {activeArtists.map((artist: { username: string; last_active: string; works?: number }, idx: number) => {
          const formattedLastActive = new Date(artist.last_active).toLocaleDateString("vi-VN", {
            month: "short",
            day: "numeric"
          });

          return (
            <div class="ribbon-card relative overflow-hidden bg-white">
              <!-- Top Ribbon Header -->
              <div class="ribbon-card-header bg-white border-b-2 border-black flex justify-between items-center py-1.5 px-3">
                <span class="font-bold text-xs truncate">ID_CARD: #{String(idx + 1).padStart(3, "0")}</span>
                <RetroSticker text="VERIFIED" variant="cyber" />
              </div>

              <!-- Banner & Cyber Avatar Block -->
              <div class="relative h-24 bg-gradient-to-r from-vapor-purple via-cosmic-black to-vapor-pink border-b-2 border-black overflow-hidden">
                {artist.banner_url && (
                  <img
                    src={artist.banner_url}
                    alt="Banner"
                    class="w-full h-full object-cover filter saturate-125 brightness-75 contrast-105"
                    loading="lazy"
                  />
                )}
                <div class="absolute inset-0 opacity-15 bg-[repeating-linear-gradient(to_bottom,transparent_0px,transparent_2px,rgba(0,0,0,0.4)_2px,rgba(0,0,0,0.4)_4px)] pointer-events-none" />
              </div>

              <!-- Avatar & Identity Info -->
              <div class="px-3 -mt-8 relative z-10 flex items-end gap-3 mb-2">
                <img
                  src={artist.avatar_url || "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=120&auto=format&fit=crop"}
                  alt={artist.full_name}
                  class="w-16 h-16 border-2 border-black bg-win-gray object-cover filter saturate-150 shadow-md shrink-0"
                  loading="lazy"
                />
                <div class="min-w-0 pb-1 font-retro">
                  <h3 class="text-sm font-black text-black truncate uppercase">
                    {artist.full_name}
                  </h3>
                  <span class="text-[10px] font-mono font-bold text-vapor-purple">
                    ● CYBER CITIZEN
                  </span>
                </div>
              </div>

              <!-- Artist Bio in Sunken Container -->
              <div class="px-3 mb-3">
                <div class="win95-sunken bg-win-gray p-2 text-[10px] font-body text-black/90 h-16 overflow-y-auto leading-relaxed">
                  {artist.bio || "Thành viên tích cực đóng góp cho tạp chí Vaporwave. Thiết kế kỹ thuật số hoài cổ là cội nguồn của mọi nguồn cảm hứng sáng tạo."}
                </div>
              </div>

              <!-- Statistics Matrix -->
              <div class="px-3 pb-3 space-y-3">
                <div class="grid grid-cols-3 gap-1.5 text-center font-mono font-bold text-[10px]">
                  <div class="border border-black bg-web-gray-light p-1 shadow-inner">
                    <span class="block text-[10px] text-win-darkest">🎨 TRANH</span>
                    <span class="text-xs text-black font-extrabold">{artist.artwork_count}</span>
                  </div>
                  <div class="border border-black bg-web-gray-light p-1 shadow-inner">
                    <span class="block text-[10px] text-win-darkest">💜 TIM</span>
                    <span class="text-xs text-vapor-purple font-extrabold">{artist.total_reactions}</span>
                  </div>
                  <div class="border border-black bg-web-gray-light p-1 shadow-inner">
                    <span class="block text-[10px] text-win-darkest">⚡ ACTIVE</span>
                    <span class="text-[10px] text-vapor-blue font-bold">{formattedLastActive}</span>
                  </div>
                </div>

                <a
                  href={`/profile/${artist.id}`}
                  class="win95-btn block text-center py-2 text-xs font-bold no-underline text-black uppercase bg-vapor-green/25 border border-black hover:bg-vapor-green/40"
                  style="min-height: 36px;"
                >
                  📁 XEM HỒ SƠ & BỘ SƯU TẬP &gt;&gt;
                </a>
              </div>
            </div>
          );
        })}
      </div>
    )}

    <!-- Statusbar -->
    <div class="win95-statusbar justify-between mt-6 text-[10px]">
      <span>Danh bạ thành viên mạng lưới Cybernet đã đồng bộ.</span>
      <span class="win95-statusbar-panel font-mono">STATUS: 200 OK</span>
    </div>
  </div>
</BaseLayout>
