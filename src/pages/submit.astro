---
import BaseLayout from "../layouts/BaseLayout.astro";
import { createSupabaseServerClient, getCurrentUserProfile } from "../lib/supabase";
import { SubmissionWizard } from "../components/SubmissionWizard";

const supabase = createSupabaseServerClient({
  request: Astro.request,
  cookies: Astro.cookies
});

// Lấy thông tin người dùng hiện tại
const currentUser = await getCurrentUserProfile(supabase);

// Nạp khóa Site Key động tại thời điểm chạy (Runtime) tránh phụ thuộc vào GitHub build
import { env } from "cloudflare:workers";
const recaptchaSitekey = (env as unknown as Record<string, string | undefined>)?.PUBLIC_RECAPTCHA_SITEKEY || import.meta.env.PUBLIC_RECAPTCHA_SITEKEY || "";
---

<BaseLayout title="VAPORWAVE MAGAZINE // GỬI TRANH NGHỆ THUẬT CỘNG ĐỒNG" userProfile={currentUser}>

  <!-- Inject reCAPTCHA sitekey as window global for client-side React component -->
  <script define:vars={{ recaptchaSitekey }}>
    window.__RECAPTCHA_SITEKEY__ = recaptchaSitekey;
  </script>

  <!-- Main Wizard Component -->
  <div class="py-4">
    <SubmissionWizard client:visible currentUser={currentUser} />
  </div>
</BaseLayout>
