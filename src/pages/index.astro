---
import BaseLayout from "../layouts/BaseLayout.astro";
import RibbonCard from "../components/RibbonCard.astro";
import CrtMonitorFrame from "../components/CrtMonitorFrame.astro";
import ServerStatusWidget from "../components/ServerStatusWidget.astro";
import CatAiGreetingBanner from "../components/CatAiGreetingBanner.astro";
import PixelText from "../components/PixelText.astro";
  import GameDock from "../components/games/GameDock.astro";
import VaporCanvasHero from "../components/VaporCanvasHero.astro";
import { createSupabaseServerClient, getCurrentUserProfile } from "../lib/supabase";

const supabase = createSupabaseServerClient({
  request: Astro.request,
  cookies: Astro.cookies
});

// Lấy thông tin người dùng hiện tại
const userProfile = await getCurrentUserProfile(supabase);

// Tải danh sách bài viết từ CSDL Supabase
const { data: dbArticles } = await supabase
  .from("articles")
  .select("*")
  .eq("status", "published")
  .order("created_at", { ascending: false });

// Tải 3 tác phẩm mới nhất để hiển thị Spotlight CRT
const { data: dbSpotlights } = await supabase
  .from("submissions")
  .select("*, profiles:profiles!author_id(full_name, avatar_url)")
  .eq("status", "approved")
  .order("created_at", { ascending: false })
  .limit(3);

let articles = [];
if (dbArticles && dbArticles.length > 0) {
  articles = dbArticles.map(a => ({
    slug: a.slug,
    title: a.title,
    description: a.excerpt || "Khám phá phong cách thiết kế đồ họa máy tính thời kỳ đầu, cội nguồn của làn sóng nghệ thuật hoài cổ Vaporwave.",
    cover: a.cover_url || "https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=600&auto=format&fit=crop",
    date: new Date(a.created_at).toLocaleDateString("vi-VN"),
    category: a.tags?.[0] || "AESTHETIC"
  }));
} else {
  // Dữ liệu mẫu chuẩn bị sẵn
  articles = [
    {
      slug: "retro-computing-aesthetic",
      title: "Hoài Niệm Windows 95: Vẻ Đẹp Của Hệ Điều Hành Cổ Điển",
      description: "Khám phá phong cách thiết kế đồ họa máy tính thời kỳ đầu, cội nguồn của làn sóng nghệ thuật hoài cổ Vaporwave.",
      cover: "https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=600&auto=format&fit=crop",
      date: "20/05/2026",
      category: "WIN95"
    },
    {
      slug: "neon-dreamscape-art",
      title: "Neon Dreamscape: Sự Trỗi Dậy Của Không Gian Màu Neon 3D",
      description: "Tại sao những gam màu hồng rực rỡ và xanh điện tử tiếp tục thống trị nghệ thuật kỹ thuật số hiện đại.",
      cover: "https://images.unsplash.com/photo-1508739773434-c26b3d09e071?w=600&auto=format&fit=crop",
      date: "18/05/2026",
      category: "SYNTHWAVE"
    }
  ];
}

const tints: Array<"sage" | "salmon" | "peach" | "lime" | "sky" | "steel" | "periwinkle" | "olive"> = [
  "periwinkle", "salmon", "sage", "peach", "sky", "lime"
];
type Row = { [key: string]: unknown };

---

<BaseLayout title="VAPORWAVE ART JOURNAL // A CYBERNETIC OASIS" userProfile={userProfile}>
  <!-- ══════════════════════════════════════════
     HERO SECTION: Perspective Grid & Sun Aesthetic
     ══════════════════════════════════════════ -->
  <section class="vapor-grid-bg win95-container bg-cosmic-deep py-5 sm:py-6 px-4 sm:px-8 mb-6 text-center relative border-2 border-win-dark shadow-2xl overflow-hidden">
    <!-- ═══ NỀN CANVAS2D ĐỘNG (mặc định — nhẹ hơn video, tự pause thông minh) ═══ -->
    <VaporCanvasHero />

    <!-- ═══ VIDEO VHS (tùy chọn qua nút VHS — lớp trên canvas) ═══ -->
    <video
      id="hero-video-bg"
      loop
      muted
      playsinline
      preload="metadata"
      poster="/favicon.svg"
      class="absolute inset-0 w-full h-full object-cover z-[1] opacity-0 pointer-events-none"
      style="filter: saturate(1.3) contrast(1.1);"
    >
      <source src="/videos/hero-bg.mp4" type="video/mp4" />
    </video>

    <!-- Lớp phủ gradient tối giữ text luôn đọc rõ -->
    <div class="absolute inset-0 z-[1] bg-gradient-to-b from-vapor-dark-alt/70 via-transparent to-vapor-dark-alt/80 pointer-events-none"></div>

    <!-- Nội dung Hero phía trên video -->
    <div class="relative z-10 flex flex-col items-center max-w-3xl mx-auto">
      <!-- Pixel Reveal Typography Title (Canvas) -->
      <PixelText
        text="Vapor Journal"
        pixelSize={3}
        revealDuration={10000}
        holdDuration={5000}
        dissolveDuration={5000}
        fontWeight={700}
        fontFamily="'VT323', 'Press Start 2P', monospace"
        class="my-1"
      />
      
      <p class="text-[11px] sm:text-xs tracking-[0.25em] text-vapor-blue font-mono uppercase bg-black/60 px-3 py-1 border border-vapor-purple/40 shadow-md">
        // A CYBERNETIC OASIS OF DIGITAL NOSTALGIA 1995-2026 //
      </p>

    </div>

    <!-- Nút bật/tắt video (góc dưới phải, phong cách Win95) -->
    <button
      id="hero-video-toggle"
      class="absolute bottom-2 right-2 z-20 win95-btn py-0.5 px-2 text-[10px] font-mono font-bold text-black opacity-60 hover:opacity-100 transition-opacity"
      title="Bật / Tắt video nền"
    >
      ⏸ VHS
    </button>
  </section>

  <!-- ARCADE.SYS — dock 2 game retro, click chơi toàn màn hình -->
  <GameDock />

  <!-- ══════════════════════════════════════════
     ENTERPRISE 2-COLUMN CATALOG LAYOUT (DESIGN-dell-1996)
     Left Rail: 28% Navigation & System Status
     Right Rail: 72% Content Feeds & Spotlight
     ══════════════════════════════════════════ -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 xl:gap-6 items-start">
    
    <!-- LEFT COLUMN (4 / 12 cols = ~33% desktop) -->
    <aside class="lg:col-span-4 xl:col-span-3 space-y-5 order-2 lg:order-1">
      
      <!-- Server Status Monitor Widget (Live API) -->
      <ServerStatusWidget />

      <!-- Call-To-Action Dell-Red Panel (Enterprise 1996 Inspired) -->
      <div class="border-2 border-black bg-gradient-to-br from-sticker-red to-seal-red p-3 text-white font-retro shadow-lg relative overflow-hidden">
        <div class="absolute -bottom-4 -right-4 opacity-20 text-6xl select-none font-mono">
          📼
        </div>
        <div class="relative z-10 space-y-2">
          <h3 class="text-sm sm:text-base font-extrabold uppercase leading-tight drop-shadow-md">
            Gia nhập cộng đồng sáng tạo nghệ thuật số
          </h3>
          <p class="text-[11px] font-body leading-relaxed text-white/90">
            Nơi trưng bày các tác phẩm Retro 90s, Synthwave, Cyberpunk và thẩm mỹ hoài cổ đỉnh cao.
          </p>
          <a href="/submit" class="win95-btn w-full py-2 text-center text-black font-extrabold uppercase bg-white border-2 border-black block no-underline text-xs" style="min-height: 36px;">
            🎨 GỬI TRANH NGAY HÔM NAY &gt;&gt;
          </a>
        </div>
      </div>

    </aside>

    <!-- RIGHT COLUMN (8 / 12 cols = ~67% desktop) -->
    <main class="lg:col-span-8 xl:col-span-9 space-y-6 order-1 lg:order-2">
      
      <!-- Top AI Greeting Message from Mèo Vàng Cybernetic -->
      <CatAiGreetingBanner />

      <!-- Eyebrow Section Block: Featured Articles -->
      <div id="journal" class="border-2 border-black bg-olive-alias p-3 text-black font-retro shadow-[4px_4px_0_#000]">
        <div class="flex justify-between items-center">
          <h2 class="text-base sm:text-lg font-black uppercase tracking-wider text-white drop-shadow-[1px_1px_0_#000]">
            📰 BÀI VIẾT NỔI BẬT // FEATURED ARTICLES
          </h2>
          <span class="text-[10px] font-mono font-bold bg-black text-white px-2 py-0.5">
            VOL. 1996
          </span>
        </div>
      </div>

      <!-- Ribbon Card Stack -->
      <div class="space-y-5">
        {articles.map((article, idx) => (
          <RibbonCard
            title={article.title}
            tint={tints[idx % tints.length]}
            eyebrow={article.category}
            stickerText={idx === 0 ? "NEW ISSUE!" : undefined}
            imageUrl={article.cover}
            imageAlt={article.title}
            href={`/articles/${article.slug}`}
            date={article.date}
            badge={`DOC_${idx + 1}.EXE`}
          >
            <p class="text-xs sm:text-sm text-black font-body leading-relaxed line-clamp-3">
              {article.description}
            </p>
          </RibbonCard>
        ))}
      </div>

      <!-- Spotlight Artworks Section inside CRT Monitor Frame -->
      <div class="mt-6">
        <div class="border-2 border-black bg-sticker-purple p-3 text-white font-retro shadow-[4px_4px_0_#000] mb-4">
          <div class="flex justify-between items-center">
            <h2 class="text-base sm:text-lg font-black uppercase tracking-wider drop-shadow-[1px_1px_0_#000]">
              📺 TÁC PHẨM TÂM ĐIỂM // SPOTLIGHT CRT
            </h2>
            <a href="/gallery" class="text-xs font-mono font-bold text-vapor-yellow hover:underline no-underline">
              XEM TOÀN BỘ TRIỂN LÃM &gt;&gt;
            </a>
          </div>
        </div>

        {dbSpotlights && dbSpotlights.length > 0 ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
            {dbSpotlights.map((item: Row) => (
              <CrtMonitorFrame title={item.title}>
                <a href={`/gallery`} class="block relative aspect-video bg-black group overflow-hidden">
                  <img
                    src={item.image_url}
                    alt={item.title}
                    class="w-full h-full object-cover filter saturate-125 contrast-105 group-hover:scale-110 transition-transform duration-300"
                    loading="lazy"
                  />
                  <div class="absolute bottom-0 inset-x-0 bg-black/85 px-2 py-1 text-center font-retro text-[10px] text-white truncate border-t border-win-dark">
                    {item.title}
                  </div>
                </a>
              </CrtMonitorFrame>
            ))}
          </div>
        ) : (
          <CrtMonitorFrame title="COMMUNITY ARTWORKS">
            <div class="aspect-video bg-black flex flex-col items-center justify-center p-6 text-center text-vapor-blue font-mono">
              <span class="text-3xl mb-2">🖼️</span>
              <p class="text-xs uppercase font-bold">MẠNG LƯỚI TRIỂN LÃM ĐANG HOẠT ĐỘNG</p>
              <p class="text-[10px] text-text-muted mt-1">Ghé thăm phòng tranh cộng đồng để thưởng thức các kiệt tác nghệ thuật số.</p>
              <a href="/gallery" class="win95-btn mt-3 text-black font-bold text-xs no-underline py-1 px-4">
                VÀO PHÒNG TRANH &gt;&gt;
              </a>
            </div>
          </CrtMonitorFrame>
        )}
      </div>

    </main>
  </div>
</BaseLayout>

<script>
  // ─── Hero Background Controller: chu kỳ CANVAS → VIDEO → OFF ───
  (function initHeroVideo() {
    const video = document.getElementById("hero-video-bg") as HTMLVideoElement;
    const toggleBtn = document.getElementById("hero-video-toggle");
    if (!video || !toggleBtn) return;

    function mode(): "canvas" | "video" | "off" {
      const v = localStorage.getItem("hero-video-paused");
      if (v === "video") return "video";
      if (v === "off") return "off";
      return "canvas";
    }

    function apply() {
      const m = mode();
      if (m === "video") {
        video.style.opacity = "0.35";
        video.play().catch(() => {});
        toggleBtn.textContent = "📼 VHS: ON";
      } else {
        video.pause();
        video.style.opacity = "0";
        toggleBtn.textContent = m === "off" ? "🎨 FX: OFF" : "📼 VHS: OFF";
      }
      window.dispatchEvent(new CustomEvent("lyc-hero-mode"));
    }

    toggleBtn.addEventListener("click", () => {
      const m = mode();
      const next = m === "canvas" ? "video" : m === "video" ? "off" : "canvas";
      localStorage.setItem("hero-video-paused", next);
      apply();
    });

    // Save-Data: không bao giờ giữ chế độ video nặng
    const connection = (navigator as { connection?: { effectiveType?: string; saveData?: boolean } }).connection;
    if (connection?.saveData && mode() === "video") {
      localStorage.setItem("hero-video-paused", "canvas");
    }

    apply();

    // Video tạm dừng khi hero cuộn khỏi viewport
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        ([entry]) => {
          if (mode() !== "video") return;
          if (!entry.isIntersecting) video.pause();
          else video.play().catch(() => {});
        },
        { threshold: 0.1 }
      ).observe(video.closest("section") || video);
    }
  })();
</script>

    <!-- v5 Phase 2: hero video policy dựa trên preference + capability (ADR-0003) -->
    <script>
      (function () {
        try {
          // computeFxLevel (duplicated inline để tránh import build)
          const STORAGE_KEY = "lyc_prefs_v1";
          let parsed = null;
          try { const raw = localStorage.getItem(STORAGE_KEY); if (raw) parsed = JSON.parse(raw); } catch {}
          const uiMode = (parsed && parsed.uiMode) || "catalog";
          const reducedMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          let saveData = false;
          const conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
          if (conn) saveData = conn.saveData || false;
          const fxOff = uiMode === "access" || reducedMotion || saveData;
          const videoEl = document.getElementById("hero-video-bg");
          if (!videoEl) return;
          if (fxOff) {
            videoEl.style.display = "none";
          } else {
            videoEl.style.display = "";
            const play = videoEl.play ? videoEl.play() : Promise.resolve();
            if (play) { play.catch(function() {}); }
          }
        } catch {
          // graceful degradation: video hiện với preload mặc định
        }
      })();
    </script>

