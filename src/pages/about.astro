---
import BaseLayout from "../layouts/BaseLayout.astro";
import { createSupabaseServerClient, getCurrentUserProfile } from "../lib/supabase";

const supabase = createSupabaseServerClient({
  request: Astro.request,
  cookies: Astro.cookies
});

const userProfile = await getCurrentUserProfile(supabase);

const pillars = [
  {
    icon: "🎨",
    label: "THE GALLERY",
    title: "Sân chơi nghệ thuật",
    copy: "Một phòng triển lãm cộng đồng sống động: masonry vô tận, lightbox shader và những tác phẩm được gửi về từ khắp nơi.",
    tone: "pink"
  },
  {
    icon: "📰",
    label: "THE JOURNAL",
    title: "Tạp chí có hồn",
    copy: "Bài viết mở ra trong khung WordPad, có mục lục scrollspy, bookmark, RSS và những đoạn văn dành cho việc đọc chậm.",
    tone: "blue"
  },
  {
    icon: "⚡",
    label: "THE SIGNAL",
    title: "Realtime toàn phần",
    copy: "Bình luận lồng nhau, reaction nổ hạt neon, thông báo 8-bit và kết nối tự phục hồi bằng exponential backoff.",
    tone: "green"
  },
  {
    icon: "🕹",
    label: "THE CONTROL ROOM",
    title: "Admin = hệ điều hành",
    copy: "Control Panel 98 với moderation hub, recycle bin, media explorer và audit log — quản trị cũng là một trải nghiệm.",
    tone: "purple"
  }
];

const stack = [
  {
    id: "edge",
    icon: "⚡",
    title: "Cloudflare Workers",
    short: "ASTRO SSR / EDGE",
    copy: "Request được kết xuất tại edge gần người đọc nhất. Astro giữ trải nghiệm nhẹ, nhanh và có thể sống tốt trên free tier.",
    metric: "100K req / ngày",
    tone: "orange"
  },
  {
    id: "data",
    icon: "🐘",
    title: "Supabase",
    short: "POSTGRES / RLS / REALTIME",
    copy: "Database giữ phần logic nặng: 14 bảng, trigger XP, recursive comments, full-text search và WebSocket realtime.",
    metric: "14 bảng dữ liệu",
    tone: "green"
  },
  {
    id: "media",
    icon: "🖼",
    title: "Cloudinary",
    short: "IMAGE CDN / VAULT",
    copy: "Kho ảnh chuyên biệt cho upload, transform f_auto và q_auto. Ảnh đi thẳng đến người xem từ CDN, không đi vòng qua app.",
    metric: "25GB media vault",
    tone: "blue"
  },
  {
    id: "cat",
    icon: "🐱",
    title: "CAT_AI.EXE",
    short: "GEMINI / SERVER PROXY",
    copy: "Bốn persona AI cùng tồn tại trong trạm mèo vàng. API key hệ thống ở lại server; BYOK là lựa chọn riêng của người dùng.",
    metric: "4 persona AI",
    tone: "purple"
  }
];

const experiences = [
  {
    number: "01",
    icon: "🖼",
    title: "Phòng triển lãm",
    copy: "Explorer, List hoặc CRT. Chạm vào tác phẩm để mở lightbox với 7 bộ lọc: CRT, VHS, GameBoy, Cyberpunk, PC-98 và Vapor Marble.",
    link: "/gallery",
    action: "Vào triển lãm",
    accent: "pink"
  },
  {
    number: "02",
    icon: "📼",
    title: "WordPad Journal",
    copy: "Những bài viết về thẩm mỹ số, retro-computing và văn hóa Internet được đặt trong một cửa sổ đọc như bước ra từ năm 1996.",
    link: "/#journal",
    action: "Đọc tạp chí",
    accent: "blue"
  },
  {
    number: "03",
    icon: "🐱",
    title: "Trạm CAT_AI",
    copy: "Gặp mèo vàng cybernetic, giáo sư V.A.P.O.R, CYBER_GHOST_95 hoặc DJ NEON PULSE — mỗi persona có một nhịp nói riêng.",
    link: "/ai",
    action: "Mở trạm AI",
    accent: "yellow"
  }
];

const modules = [
  {
    id: "mission",
    icon: "🏠",
    name: "Mission Control",
    tag: "OVERVIEW",
    copy: "Sparkline 30 ngày, activity feed realtime và các quick action cho phiên trực đầu tiên.",
    tasks: ["Xem nhịp tăng trưởng", "Theo dõi activity", "Mở nhanh queue"]
  },
  {
    id: "articles",
    icon: "📚",
    name: "Article Manager",
    tag: "PUBLISHING",
    copy: "Lọc, sort, phân trang server-side; bulk publish/archive; nhân bản và chọn bài lên trang chủ.",
    tasks: ["Lọc & phân trang", "Bulk publish", "Curate trang chủ"]
  },
  {
    id: "moderation",
    icon: "🖼",
    name: "Moderation Hub",
    tag: "OUTLOOK EXPRESS",
    copy: "Duyệt tranh theo trạng thái, lưu lý do từ chối, gắn sao nổi bật và trao XP tự động.",
    tasks: ["A / R / X bằng phím tắt", "Lưu lý do từ chối", "Xem preview tác phẩm"]
  },
  {
    id: "media",
    icon: "🗃",
    name: "Media Explorer",
    tag: "CLOUDINARY",
    copy: "Quét tham chiếu tranh, bài viết và hồ sơ để tìm ảnh mồ côi trước khi dọn kho.",
    tasks: ["Search media API", "Lọc ảnh mồ côi", "Xóa hàng loạt có kiểm soát"]
  },
  {
    id: "trash",
    icon: "🗑",
    name: "Recycle Bin",
    tag: "RECOVERY",
    copy: "Soft-delete và khôi phục một chạm. Những bản ghi quá hạn mới bị purge sau 30 ngày.",
    tasks: ["Restore 1-click", "Theo dõi thời hạn", "Purge có lịch"]
  }
];

const security = [
  {
    layer: "LAYER 01",
    icon: "🚪",
    title: "Middleware",
    copy: "Kiểm session, role và maintenance gate trước mọi route /admin. UI không được quyền tự quyết định ai là admin.",
    tone: "pink"
  },
  {
    layer: "LAYER 02",
    icon: "🛡",
    title: "Postgres RLS",
    copy: "Policy nằm cạnh dữ liệu. Editor chỉ sửa bài của mình; audit log chỉ được đọc và ghi bởi admin.",
    tone: "blue"
  },
  {
    layer: "LAYER 03",
    icon: "🔒",
    title: "Database triggers",
    copy: "Trigger chặn client tự sửa role hoặc ban, tính XP, chống spam và bảo vệ admin cuối cùng.",
    tone: "green"
  }
];
---

<BaseLayout
  title="SYSTEM MAP // LOVELYYELLOWCAT"
  description="Bản đồ tương tác của LovelyYellowCat — tạp chí nghệ thuật Vaporwave, phòng triển lãm cộng đồng và cybernetic oasis chạy trên Edge."
  userProfile={userProfile}
  showMarquee={false}
>
  <div class="about-shell">
    <div class="about-noise" aria-hidden="true"></div>

    <section class="about-hero" id="top" aria-labelledby="about-title">
      <div class="about-hero-grid" aria-hidden="true"></div>
      <div class="about-hero-sun" aria-hidden="true"></div>
      <div class="about-hero-glow about-hero-glow-one" aria-hidden="true"></div>
      <div class="about-hero-glow about-hero-glow-two" aria-hidden="true"></div>

      <div class="about-hero-copy">
        <div class="about-eyebrow"><span class="about-pulse"></span> PROJECT DOSSIER / PUBLIC CHANNEL</div>
        <p class="about-kicker">EST. 1995 · BUDGET: $0 · EDGE-RENDERED</p>
        <h1 id="about-title"><span>Lovely</span><span>YellowCat</span></h1>
        <p class="about-lede">
          Một cybernetic oasis cho nghệ thuật số — nơi gallery, tạp chí, cộng đồng và một chú mèo AI cùng chạy trong chiếc máy tính tưởng tượng năm 1995.
        </p>
        <div class="about-hero-actions">
          <a class="about-primary-action" href="/gallery"><span>▶</span> BƯỚC VÀO TRIỂN LÃM</a>
          <a class="about-secondary-action" href="https://github.com/nongtiensonpro/lovelyyellowcat" target="_blank" rel="noopener noreferrer"><span>⌘</span> XEM SOURCE ↗</a>
        </div>
        <div class="about-stat-row" aria-label="Thông số dự án">
          <div><strong>14</strong><span>DB TABLES</span></div>
          <div><strong>03</strong><span>SECURITY LAYERS</span></div>
          <div><strong>04</strong><span>AI PERSONAS</span></div>
          <div><strong>$0</strong><span>MONTHLY COST</span></div>
        </div>
      </div>

      <div class="about-terminal" aria-label="Trình mô phỏng khởi động hệ thống">
        <div class="about-terminal-titlebar">
          <span><span class="about-terminal-icon">▣</span> LOVELYYELLOWCAT.BIOS</span>
          <span class="about-window-buttons"><i>_</i><i>□</i><i>×</i></span>
        </div>
        <div class="about-terminal-meta"><span>FILE</span><span>EDIT</span><span>VIEW</span><span>HELP</span><b>● ONLINE</b></div>
        <div class="about-terminal-screen">
          <div class="about-terminal-logo">L<span>Y</span>C<span class="about-cat-pixel">🐱</span></div>
          <p class="about-terminal-line"><em>[BOOT]</em> VAPORWAVE.SYS ................ <strong>OK</strong></p>
          <p class="about-terminal-line"><em>[LINK]</em> SUPABASE REALTIME ........... <strong>OK</strong></p>
          <p class="about-terminal-line"><em>[VAULT]</em> CLOUDINARY MEDIA .......... <strong>OK</strong></p>
          <p class="about-terminal-line"><em>[MEOW]</em> CAT_AI.EXE ................ <strong>READY</strong></p>
          <div class="about-terminal-divider"></div>
          <p class="about-terminal-prompt">C:\CYBER_OASIS&gt; <span>run welcome.exe</span><b>▋</b></p>
        </div>
        <div class="about-terminal-status"><span>MEM 640K OK</span><span>CPU: VIBE CORE</span><span>NET: EDGE</span></div>
      </div>
    </section>

    <nav class="about-jumpbar" aria-label="Điều hướng trong bản đồ hệ thống">
      <span class="about-jump-label">EXPLORE DOSSIER</span>
      <a href="#origin" class="is-active">01 ORIGIN</a>
      <a href="#architecture">02 ARCHITECTURE</a>
      <a href="#experience">03 EXPERIENCE</a>
      <a href="#control-panel">04 CONTROL PANEL</a>
      <a href="#security">05 SECURITY</a>
    </nav>

    <section class="about-section about-origin" id="origin" aria-labelledby="origin-title">
      <div class="about-section-heading">
        <span class="about-section-number">01</span>
        <div><p>THE ORIGIN STORY</p><h2 id="origin-title">Không chỉ là một website.</h2></div>
        <span class="about-heading-line"></span>
      </div>

      <div class="about-origin-layout">
        <div class="about-manifesto">
          <div class="about-manifesto-stamp">A CYBERNETIC<br />OASIS</div>
          <p class="about-quote">“Hãy tưởng tượng bạn bước vào một tiệm điện tử bỏ hoang năm 1995 — CRT còn sáng, băng VHS vẫn quay, và trên tường là tranh do cộng đồng gửi về.”</p>
          <p class="about-body-copy">LovelyYellowCat được xây như một nơi chốn, không phải một trang danh sách. Mọi màn hình đều có một chút ma sát, một chút bất ngờ và đủ khoảng trống để người xem muốn ở lại lâu hơn.</p>
          <div class="about-manifesto-footer"><span>MANIFESTO.TXT</span><span>READ TIME: 01:30</span></div>
        </div>
        <div class="about-pillars">
          {pillars.map((pillar, index) => (
            <article class={`about-pillar about-tone-${pillar.tone}`} style={`--item-delay: ${index * 90}ms`}>
              <div class="about-pillar-top"><span class="about-pillar-icon">{pillar.icon}</span><span>{pillar.label}</span></div>
              <h3>{pillar.title}</h3>
              <p>{pillar.copy}</p>
              <span class="about-pillar-arrow">↗</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="about-section" id="architecture" aria-labelledby="architecture-title">
      <div class="about-section-heading">
        <span class="about-section-number">02</span>
        <div><p>THE FREE-TIER ENGINE</p><h2 id="architecture-title">Mọi thứ kết nối ở Edge.</h2></div>
        <span class="about-heading-line"></span>
      </div>

      <div class="about-architecture-window">
        <div class="about-window-header"><span>🛰️ ARCHITECTURE.EXE</span><span class="about-window-path">C:\SYSTEM\NETWORK\TOPOLOGY</span><span>×</span></div>
        <div class="about-architecture-body">
          <div class="about-architecture-intro">
            <p class="about-label">CLICK A NODE TO INSPECT</p>
            <p class="about-body-copy">Không một dịch vụ nào cần gánh cả thế giới. Mỗi nhánh làm đúng việc của mình — nhẹ, chuyên biệt và nằm gọn trong hạn mức miễn phí.</p>
            <div class="about-architecture-legend"><span><i class="legend-dot legend-live"></i> LIVE LINK</span><span><i class="legend-dot legend-secure"></i> SERVER-SIDE</span></div>
          </div>
          <div class="about-node-map" aria-label="Sơ đồ kiến trúc hệ thống">
            <div class="about-node-connector connector-one"></div><div class="about-node-connector connector-two"></div><div class="about-node-connector connector-three"></div>
            <div class="about-browser-node"><span>🖥️</span><b>YOUR BROWSER</b><small>HTTPS / WEBSOCKET</small></div>
            <div class="about-stack-nodes">
              {stack.map((node, index) => (
                <button
                  type="button"
                  class={`about-stack-node about-tone-${node.tone} ${index === 0 ? "is-selected" : ""}`}
                  data-node={node.id}
                  data-title={node.title}
                  data-copy={node.copy}
                  data-metric={node.metric}
                  aria-pressed={index === 0 ? "true" : "false"}
                >
                  <span class="about-stack-node-icon">{node.icon}</span><span><b>{node.title}</b><small>{node.short}</small></span><i>↗</i>
                </button>
              ))}
            </div>
          </div>
          <div class="about-architecture-console" id="architecture-console" aria-live="polite">
            <span class="about-label">NODE INSPECTOR / ACTIVE</span>
            <h3 id="architecture-console-title">Cloudflare Workers</h3>
            <p id="architecture-console-copy">Request được kết xuất tại edge gần người đọc nhất. Astro giữ trải nghiệm nhẹ, nhanh và có thể sống tốt trên free tier.</p>
            <strong id="architecture-console-metric">100K req / ngày</strong>
          </div>
        </div>
        <div class="about-window-status"><span>● 4 NODES ONLINE</span><span>LATENCY: LOW</span><span>DEPENDENCY: LOOSE</span></div>
      </div>
    </section>

    <section class="about-section" id="experience" aria-labelledby="experience-title">
      <div class="about-section-heading">
        <span class="about-section-number">03</span>
        <div><p>THE PUBLIC INTERFACE</p><h2 id="experience-title">Một tạp chí để chạm vào.</h2></div>
        <span class="about-heading-line"></span>
      </div>
      <div class="about-experience-grid">
        {experiences.map((experience, index) => (
          <article class={`about-experience-card about-tone-${experience.accent}`} style={`--item-delay: ${index * 110}ms`}>
            <div class="about-experience-top"><span class="about-experience-number">{experience.number}</span><span class="about-experience-icon">{experience.icon}</span></div>
            <div class="about-experience-visual" aria-hidden="true"><span></span><span></span><span></span></div>
            <h3>{experience.title}</h3>
            <p>{experience.copy}</p>
            <a href={experience.link}>{experience.action} <span>↗</span></a>
          </article>
        ))}
      </div>
      <div class="about-shortcuts"><span class="about-label">SYSTEM SHORTCUTS</span><kbd>CTRL</kbd><b>+</b><kbd>K</kbd><span>Tìm kiếm toàn cục</span><span class="shortcut-separator">·</span><kbd>ESC</kbd><span>Đóng overlay</span><span class="shortcut-separator">·</span><kbd>←</kbd><kbd>→</kbd><span>Chuyển ảnh</span></div>
    </section>

    <section class="about-section" id="control-panel" aria-labelledby="control-title">
      <div class="about-section-heading">
        <span class="about-section-number">04</span>
        <div><p>THE CONTROL ROOM</p><h2 id="control-title">Admin cũng là một thế giới.</h2></div>
        <span class="about-heading-line"></span>
      </div>

      <div class="about-control-window">
        <div class="about-window-header about-control-header"><span>🪟 CONTROL PANEL 98</span><span class="about-window-path">C:\ADMIN\MISSION_CONTROL</span><span>×</span></div>
        <div class="about-control-layout">
          <aside class="about-control-sidebar" aria-label="Các module Control Panel">
            <div class="about-control-user"><span class="about-avatar">YC</span><span><b>ADMINISTRATOR</b><small>CYBER_OASIS</small></span></div>
            <p class="about-label">MODULES</p>
            <div class="about-module-list" role="tablist" aria-label="Module quản trị">
              {modules.map((module, index) => (
                <button type="button" class={`about-module-button ${index === 0 ? "is-active" : ""}`} data-module={module.id} role="tab" aria-selected={index === 0 ? "true" : "false"} aria-controls={`module-panel-${module.id}`}>
                  <span>{module.icon}</span>{module.name}<i>{index === 0 ? "●" : ""}</i>
                </button>
              ))}
            </div>
          </aside>
          <div class="about-control-content">
            <div class="about-control-toolbar"><span>▣ MISSION CONTROL</span><span class="about-toolbar-filter">FILTER: <b>ALL ACTIVITY</b> ▾</span></div>
            {modules.map((module, index) => (
              <article class="about-module-panel" id={`module-panel-${module.id}`} data-module-panel={module.id} role="tabpanel" hidden={index !== 0}>
                <div class="about-module-heading"><div><span class="about-label">{module.tag}</span><h3>{module.icon} {module.name}</h3></div><span class="about-module-live">● LIVE</span></div>
                <p class="about-module-copy">{module.copy}</p>
                <div class="about-module-tasks">{module.tasks.map((task, taskIndex) => <div><span>0{taskIndex + 1}</span><b>{task}</b><i>✓</i></div>)}</div>
                <div class="about-fake-graph"><div class="about-graph-grid"></div><svg viewBox="0 0 600 110" preserveAspectRatio="none" aria-label="Sparkline activity"><polyline points="0,88 44,76 78,82 118,56 160,67 202,43 244,52 286,25 332,44 368,20 415,35 452,16 495,28 540,9 600,18" fill="none" stroke="currentColor" stroke-width="3" vector-effect="non-scaling-stroke" /></svg><span>ACTIVITY // 30 DAYS</span></div>
              </article>
            ))}
          </div>
        </div>
        <div class="about-window-status"><span>▣ 10 MODULES AVAILABLE</span><span>DB SYNC: OK</span><span>LAST AUDIT: JUST NOW</span></div>
      </div>
    </section>

    <section class="about-section about-security-section" id="security" aria-labelledby="security-title">
      <div class="about-section-heading">
        <span class="about-section-number">05</span>
        <div><p>THE TRUST LAYER</p><h2 id="security-title">Đẹp ở ngoài. Chắc ở bên trong.</h2></div>
        <span class="about-heading-line"></span>
      </div>
      <div class="about-security-grid">
        {security.map((item, index) => (
          <article class={`about-security-card about-tone-${item.tone}`}>
            <span class="about-security-layer">{item.layer}</span>
            <div class="about-security-icon">{item.icon}</div>
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
            <div class="about-security-bar"><span style={`--bar-width: ${70 + index * 10}%`}></span></div>
          </article>
        ))}
      </div>
      <div class="about-security-note"><span>✓</span><p><b>KEY RULE:</b> API key hệ thống không bao giờ rời server. Mọi mutation quản trị đều để lại dấu vết trong audit log đa đối tượng.</p></div>
    </section>

    <section class="about-final-cta" aria-labelledby="cta-title">
      <div class="about-final-sun" aria-hidden="true"></div>
      <div class="about-final-copy"><p class="about-kicker">THE OASIS IS LIVE</p><h2 id="cta-title">Ready to enter<br /><span>the signal?</span></h2><p>Không cần đọc hết bản đồ. Chọn một cánh cửa và để hệ thống dẫn đường.</p></div>
      <div class="about-final-actions"><a class="about-primary-action" href="/gallery"><span>▶</span> ENTER GALLERY</a><a class="about-secondary-action" href="/ai"><span>🐱</span> MEET CAT_AI</a><button type="button" class="about-copy-button" id="copy-install"><span>⌘</span> COPY INSTALL</button><small id="copy-feedback" aria-live="polite">npm install · npm run dev</small></div>
    </section>

    <div class="about-bottom-line"><span>LOVELYYELLOWCAT // SYSTEM MAP v1.0</span><span>MADE WITH ART, CODE &amp; A LITTLE NOSTALGIA 🐱</span><a href="#top">BACK TO TOP ↑</a></div>
  </div>
</BaseLayout>

<script>
  const archButtons = document.querySelectorAll<HTMLButtonElement>(".about-stack-node");
  const archTitle = document.getElementById("architecture-console-title");
  const archCopy = document.getElementById("architecture-console-copy");
  const archMetric = document.getElementById("architecture-console-metric");

  archButtons.forEach((button) => {
    button.addEventListener("click", () => {
      archButtons.forEach((node) => {
        node.classList.remove("is-selected");
        node.setAttribute("aria-pressed", "false");
      });
      button.classList.add("is-selected");
      button.setAttribute("aria-pressed", "true");
      if (archTitle) archTitle.textContent = button.dataset.title || "";
      if (archCopy) archCopy.textContent = button.dataset.copy || "";
      if (archMetric) archMetric.textContent = button.dataset.metric || "";
    });
  });

  const moduleButtons = document.querySelectorAll<HTMLButtonElement>(".about-module-button");
  const modulePanels = document.querySelectorAll<HTMLElement>("[data-module-panel]");

  moduleButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const target = button.dataset.module;
      moduleButtons.forEach((item) => {
        const active = item === button;
        item.classList.toggle("is-active", active);
        item.setAttribute("aria-selected", String(active));
        const dot = item.querySelector("i");
        if (dot) dot.textContent = active ? "●" : "";
      });
      modulePanels.forEach((panel) => {
        panel.hidden = panel.dataset.modulePanel !== target;
      });
    });
  });

  const jumpLinks = document.querySelectorAll<HTMLAnchorElement>(".about-jumpbar a");
  const jumpSections = document.querySelectorAll<HTMLElement>(".about-section");
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      jumpLinks.forEach((link) => link.classList.toggle("is-active", link.getAttribute("href") === `#${entry.target.id}`));
    });
  }, { rootMargin: "-25% 0px -60% 0px", threshold: 0 });
  jumpSections.forEach((section) => observer.observe(section));

  const copyButton = document.getElementById("copy-install");
  const copyFeedback = document.getElementById("copy-feedback");
  copyButton?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText("npm install && npm run dev");
      if (copyFeedback) copyFeedback.textContent = "✓ COMMAND COPIED TO CLIPBOARD";
    } catch {
      if (copyFeedback) copyFeedback.textContent = "npm install && npm run dev";
    }
    window.setTimeout(() => {
      if (copyFeedback) copyFeedback.textContent = "npm install · npm run dev";
    }, 2400);
  });
</script>

