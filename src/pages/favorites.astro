---
import BaseLayout from "../layouts/BaseLayout.astro";
import { createSupabaseServerClient, getCurrentUserProfile } from "../lib/supabase";
import { GalleryGrid } from "../components/GalleryGrid";

const supabase = createSupabaseServerClient({
  request: Astro.request,
  cookies: Astro.cookies
});

// Lấy thông tin người dùng đăng nhập hiện tại
const userProfile = await getCurrentUserProfile(supabase);
let initialSubmissions: any[] = [];

if (userProfile) {
  // Lấy các tác phẩm đã lưu trong mục yêu thích
  const { data: dbFavorites } = await supabase
    .from("favorites")
    .select(`
      saved_at,
      submissions:submissions!submission_id(
        *,
        profiles:profiles!author_id(full_name, avatar_url)
      )
    `)
    .eq("profile_id", userProfile.id)
    .order("saved_at", { ascending: false });

  if (dbFavorites) {
    initialSubmissions = dbFavorites
      .map((f: any) => f.submissions)
      .filter((s) => s !== null && s.status === "approved");
  }
}
---

<BaseLayout
  title="MY_SAVED_ARCHIVES.EXE // VAPOR MAGAZINE"
  description="Bộ sưu tập nghệ thuật hoài cổ riêng tư được lưu trữ của bạn."
  userProfile={userProfile}
>
  {!userProfile ? (
    <div class="max-w-md mx-auto my-16 font-retro text-black">
      <div class="win95-window">
        <div class="win95-header py-1 px-2 bg-gradient-to-r from-red-800 to-red-600 text-white">
          <div class="flex items-center gap-1.5 font-bold text-xs">
            <span>⚠️</span>
            <span>SYSTEM_SECURITY_ERROR.SYS</span>
          </div>
          <button class="win95-btn py-0 px-1 text-[10px] font-bold">✕</button>
        </div>

        <div class="p-4 bg-win-gray space-y-4">
          <div class="flex items-start gap-4">
            <span class="text-4xl filter drop-shadow">🔒</span>
            <div class="space-y-1">
              <h4 class="font-extrabold text-sm uppercase text-red-800">
                Truy Cập Bị Từ Chối (Error 401)
              </h4>
              <p class="text-xs leading-relaxed text-black">
                Khu vực đĩa lưu trữ cá nhân yêu cầu xác thực tài khoản. Vui lòng đăng nhập để mở khóa các tác phẩm và bài viết đã lưu.
              </p>
            </div>
          </div>

          <div class="win95-sunken bg-white p-2 text-[10px] font-mono font-bold text-win-darkest uppercase">
            // SECURE_COMMUNICATION_LINK_OFFLINE //
          </div>

          <div class="flex justify-end gap-2 pt-2 border-t border-win-dark">
            <a href="/" class="win95-btn px-4 py-1.5 font-bold no-underline text-black text-xs" style="min-height: 32px;">
              Quay Lại
            </a>
            <a href="/api/auth/signin" class="win95-btn px-4 py-1.5 font-bold bg-[#fffb96]/40 border-2 border-black no-underline text-black text-xs" style="min-height: 32px;">
              🔑 Đăng Nhập Google
            </a>
          </div>
        </div>

        <div class="win95-statusbar justify-between text-[10px]">
          <span>Auth Service: Waiting for session</span>
          <span class="win95-statusbar-panel font-mono text-red-700 font-bold">LOCKED</span>
        </div>
      </div>
    </div>
  ) : (
    <div>
      <div class="text-center py-6">
        <h1 class="hero-title text-glitch-soft">
          My Favorites
        </h1>
        <p class="text-[10px] sm:text-xs tracking-[0.2em] text-vapor-pink mt-3 font-mono uppercase">
          // 3.5 INCH FLOPPY DISK ARCHIVE // PRIVATE VAULT //
        </p>
      </div>

      <div class="mt-4 win95-window p-3 sm:p-4">
        <div class="win95-header py-1 px-2 mb-4 bg-gradient-to-r from-vapor-purple to-vapor-pink text-white">
          <div class="flex items-center gap-1.5">
            <span>💾</span>
            <span class="font-bold text-xs">FLOPPY_DRIVE_A:\FAVORITES\ [TỦ TRANH YÊU THÍCH]</span>
          </div>
          <span class="font-mono text-[10px] bg-black text-vapor-green px-1.5 py-0.5">
            {initialSubmissions.length} TÁC PHẨM
          </span>
        </div>

        <div class="win95-sunken bg-white p-3 mb-6 font-retro text-xs text-black leading-relaxed">
          <span class="font-bold text-vapor-purple">● Bộ nhớ lưu trữ cá nhân bảo mật:</span> Bạn đã đánh dấu yêu thích <span class="text-vapor-pink font-extrabold">{initialSubmissions.length}</span> tác phẩm nghệ thuật. Danh sách này được lưu trữ riêng biệt trên tài khoản của bạn.
        </div>

        {initialSubmissions.length === 0 ? (
          <div class="win95-container bg-win-gray p-16 text-center text-win-dark font-bold space-y-3">
            <p class="text-4xl">🤍</p>
            <p class="text-xs uppercase text-black font-mono font-bold">KỆ LƯU TRỮ ĐANG TRỐNG</p>
            <p class="text-[10px] text-win-darkest max-w-sm mx-auto">
              Bạn chưa lưu tác phẩm nào. Hãy ghé thăm phòng triển lãm và nhấn biểu tượng 💜 để lưu các kiệt tác yêu thích vào kệ này!
            </p>
            <a href="/gallery" class="win95-btn inline-block mt-2 px-6 py-2 no-underline text-black font-bold uppercase" style="min-height: 36px;">
              🌐 Đến Phòng Triển Lãm
            </a>
          </div>
        ) : (
          <GalleryGrid
            client:load
            initialSubmissions={initialSubmissions}
            currentUser={userProfile}
            isFavoritesOnly={true}
          />
        )}

        <div class="win95-statusbar justify-between mt-6 text-[10px]">
          <span>Drive A: 1.44MB Available</span>
          <span class="win95-statusbar-panel font-mono text-vapor-green font-bold">READY</span>
        </div>
      </div>
    </div>
  )}
</BaseLayout>
