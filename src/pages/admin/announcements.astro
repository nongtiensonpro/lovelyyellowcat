---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { createSupabaseServerClient } from "../../lib/supabase";
import { logAdminAction } from "../../lib/adminAudit";

const supabase = createSupabaseServerClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

const {
  data: { user },
} = await supabase.auth.getUser();
let userProfile: { role?: string } | null = null;
if (user) {
  const { data } = await supabase.from("profiles").select("*").eq("id", user.id).single();
  userProfile = data;
}

if (!user || !userProfile || userProfile.role !== "admin") {
  return Astro.redirect("/admin?error=admin-only");
}

let actionResult: { success: boolean; message: string } | null = null;

// ── Mutations ──
if (Astro.request.method === "POST" && user) {
  const formData = await Astro.request.formData();
  const action = String(formData.get("action") || "");
  const id = String(formData.get("announcementId") || "");

  try {
    if (action === "create") {
      const title = String(formData.get("title") || "").trim();
      const body = String(formData.get("body") || "").trim();
      const type = ["banner", "marquee", "popup"].includes(String(formData.get("type")))
        ? String(formData.get("type"))
        : "marquee";
      const days = Math.min(365, Math.max(1, parseInt(String(formData.get("days") || "7"))));

      if (!title) {
        actionResult = { success: false, message: "Vui lòng nhập tiêu đề thông báo." };
      } else {
        const endAt = new Date(Date.now() + days * 86400000).toISOString();
        const { error } = await supabase.from("site_announcements").insert({
          title,
          body,
          type,
          end_at: endAt,
          created_by: user.id,
        });
        if (error) throw new Error(error.message);
        await logAdminAction(supabase, {
          adminId: user.id,
          action: "announcement_create",
          targetType: "profile",
          targetId: user.id,
          details: { title, type, days },
        });
        actionResult = {
          success: true,
          message: `Đã phát thông báo "${title}" (hiển thị ${days} ngày).`,
        };
      }
    } else if (action === "toggle" && id) {
      const { data: current } = await supabase
        .from("site_announcements")
        .select("is_active, title")
        .eq("id", id)
        .single();
      if (current) {
        const nextValue = !current.is_active;
        const { error } = await supabase
          .from("site_announcements")
          .update({ is_active: nextValue })
          .eq("id", id);
        if (error) throw new Error(error.message);
        await logAdminAction(supabase, {
          adminId: user.id,
          action: "announcement_toggle",
          targetType: "profile",
          targetId: user.id,
          details: { announcement_id: id, active: nextValue },
        });
        actionResult = {
          success: true,
          message: nextValue ? "Đã kích hoạt lại thông báo." : "Đã tạm dừng thông báo.",
        };
      }
    } else if (action === "delete" && id) {
      const { error } = await supabase.from("site_announcements").delete().eq("id", id);
      if (error) throw new Error(error.message);
      await logAdminAction(supabase, {
        adminId: user.id,
        action: "announcement_delete",
        targetType: "profile",
        targetId: user.id,
        details: { announcement_id: id },
      });
      actionResult = { success: true, message: "Đã xóa vĩnh viễn thông báo." };
    }
  } catch (err) {
    console.error(
      "[ANNOUNCEMENTS] Mutation failed:",
      err instanceof Error ? err.message : String(err),
    );
    actionResult = {
      success: false,
      message: "Sự cố hệ thống khi xử lý thông báo. Kiểm tra migration upgrade_v3 đã chạy chưa.",
    };
  }
}

// ── Danh sách thông báo (mọi trạng thái cho admin xem) ──
const { data: announcements } = await supabase
  .from("site_announcements")
  .select("*")
  .order("created_at", { ascending: false })
  .limit(30);

// Thống kê nhanh + preview marquee (pure module dùng chung với public site)
const allRows = (announcements || []) as Array<Record<string, unknown>>;
const liveRows = allRows.filter(
  (a) => a.is_active === true && !(a.end_at && new Date(String(a.end_at)) <= new Date()),
);
const stats = {
  total: allRows.length,
  live: liveRows.length,
  expired: allRows.filter((a) => a.end_at && new Date(String(a.end_at)) <= new Date()).length,
  paused: allRows.filter((a) => a.is_active === false).length,
};

function formatAnnouncementDate(d: string | null) {
  return d ? new Date(d).toLocaleString("vi-VN") : "—";
}
type Row = { [key: string]: unknown };
---

<AdminLayout
  title="VAPORWAVE MAGAZINE // TRẠM PHÁT THÔNG BÁO"
  userProfile={userProfile}
  activePath="/admin/announcements"
>
  {
    actionResult && (
      <div
        class={`win95-container mb-5 font-retro text-xs ${actionResult.success ? "border-vapor-green" : "border-red-600"}`}
      >
        <div
          class={`win95-header ${actionResult.success ? "bg-gradient-to-r from-green-700 to-green-600" : "bg-gradient-to-r from-red-800 to-red-600"}`}
        >
          <span>{actionResult.success ? "✅ WINPOPUP.SENT" : "❌ SYSTEM_ALERT.ERR"}</span>
        </div>
        <div
          class={`p-3 text-black font-bold ${actionResult.success ? "bg-green-100" : "bg-red-100"}`}
        >
          {actionResult.message}
        </div>
      </div>
    )
  }

  <div class="text-center py-4 mb-4">
    <h1
      class="text-2xl sm:text-3xl font-extrabold uppercase tracking-widest text-vapor-orange font-retro"
    >
      📣 WINPOPUP STATION
    </h1>
    <p class="text-[11px] tracking-wider text-text-secondary mt-1 font-retro uppercase">
      -- Phát thông báo toàn site kiểu WinPopUp 1995 --
    </p>
  </div>

  <!-- Thống kê nhanh -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6 font-retro text-black">
    {
      [
        { label: "ĐANG PHÁT", value: stats.live, cls: "text-vapor-green" },
        { label: "TẠM DỪNG", value: stats.paused, cls: "text-win-dark" },
        { label: "HẾT HẠN", value: stats.expired, cls: "text-vapor-orange" },
        { label: "TỔNG", value: stats.total, cls: "text-vapor-purple" },
      ].map((s) => (
        <div class="win95-container">
          <div class="win95-header py-0.5">
            <span class="text-[10px]">{s.label}</span>
          </div>
          <div class={`p-2 bg-win-gray text-center text-xl font-extrabold ${s.cls}`}>{s.value}</div>
        </div>
      ))
    }
  </div>

  <!-- PREVIEW.ALL: mô phỏng cả 3 kiểu hiển thị, cập nhật live theo form -->
  <div class="win95-container mb-6 font-retro text-black" id="ann-preview-box">
    <div class="win95-header py-0.5 flex items-center justify-between">
      <span>👁 PREVIEW.ALL — XEM TRƯỚC CẢ 3 KIỂU</span>
      <span id="ann-preview-active-label" class="text-[9px] text-win-darkest font-mono"
        >KIỂU ĐANG CHỌN: 🎞️ MARQUEE</span
      >
    </div>
    <div class="p-3 bg-win-gray space-y-3">
      <!-- 1. MARQUEE: đúng cấu trúc ticker trên site -->
      <div data-preview-type="marquee" class="ann-preview-card win95-sunken border border-win-dark">
        <div class="flex items-center justify-between px-2 pt-1">
          <span class="text-[9px] font-bold text-win-dark font-mono"
            >① 🎞️ MARQUEE — chữ chạy đầu trang</span
          >
          <span data-selected-badge class="hidden ann-selected-badge">✔ ĐANG CHỌN</span>
        </div>
        <div
          class="m-2 win95-sunken bg-cosmic-black text-vapor-orange font-mono text-[10px] py-1 px-2 overflow-hidden flex items-center"
        >
          <span
            class="font-bold font-retro tracking-wider shrink-0 pr-2 border-r border-vapor-purple/40 mr-2 text-vapor-pink"
            >PREVIEW:</span
          >
          <div class="overflow-hidden relative w-full flex">
            <div class="animate-marquee marquee-pausable whitespace-nowrap flex gap-12">
              <span data-preview-marquee-text>[THÔNG BÁO] (nhập tiêu đề để xem trước...)</span>
              <span aria-hidden="true" data-preview-marquee-text-2
                >[THÔNG BÁO] (nhập tiêu đề để xem trước...)</span
              >
            </div>
          </div>
        </div>
        <p class="px-2 pb-1 text-[8px] text-win-darkest font-mono">
          Rê chuột lên dòng để tạm dừng.
        </p>
      </div>

      <!-- 2. BANNER: đúng cấu trúc banner header trên site -->
      <div data-preview-type="banner" class="ann-preview-card win95-sunken border border-win-dark">
        <div class="flex items-center justify-between px-2 pt-1">
          <span class="text-[9px] font-bold text-win-dark font-mono"
            >② 🚩 BANNER — dải màu nổi bật</span
          >
          <span data-selected-badge class="hidden ann-selected-badge">✔ ĐANG CHỌN</span>
        </div>
        <div class="m-2 win95-container text-black" role="presentation">
          <div class="flex items-stretch">
            <div
              class="win95-header bg-gradient-to-r from-vapor-orange to-vapor-pink px-3 py-2 flex items-center gap-2 shrink-0"
            >
              <span aria-hidden="true">🚩</span>
              <span class="font-bold text-[10px]">THÔNG BÁO</span>
            </div>
            <div class="flex-1 bg-win-gray px-3 py-2 min-w-0 flex items-center gap-2">
              <p data-preview-banner-title class="text-xs font-bold truncate flex-1">
                (nhập tiêu đề để xem trước...)
              </p>
              <span
                class="win95-btn px-1.5 py-0 text-[10px] font-bold shrink-0 opacity-60"
                aria-hidden="true">✕</span
              >
            </div>
          </div>
        </div>
        <p class="px-2 pb-1 text-[8px] text-win-darkest font-mono">
          Visitor bấm ✕ để ẩn trong phiên (session).
        </p>
      </div>

      <!-- 3. POPUP: cửa sổ Win95 như visitor thấy -->
      <div data-preview-type="popup" class="ann-preview-card win95-sunken border border-win-dark">
        <div class="flex items-center justify-between px-2 pt-1">
          <span class="text-[9px] font-bold text-win-dark font-mono"
            >③ 🪟 POPUP — cửa sổ Win95 một lần mỗi phiên</span
          >
          <span data-selected-badge class="hidden ann-selected-badge">✔ ĐANG CHỌN</span>
        </div>
        <div
          class="m-2 relative bg-[repeating-linear-gradient(45deg,#e8e4d8_0_10px,#dcd8cc_10px_20px)] min-h-28 flex items-center justify-center p-3"
        >
          <div class="win95-container text-black w-full max-w-xs relative" role="presentation">
            <div class="win95-header flex items-center justify-between">
              <span class="text-[10px] font-bold flex items-center gap-1"
                ><span aria-hidden="true">📣</span> THÔNG BÁO HỆ THỐNG</span
              >
              <span class="win95-btn px-1 py-0 text-[9px] opacity-60" aria-hidden="true">✕</span>
            </div>
            <div class="p-3 bg-win-gray text-center">
              <p data-preview-popup-icon class="text-lg leading-none mb-1">📣</p>
              <p data-preview-popup-title class="text-xs font-extrabold mb-2 break-words">
                (nhập tiêu đề để xem trước...)
              </p>
              <div
                data-preview-popup-body-wrap
                class="hidden win95-sunken bg-white px-2 py-1.5 mb-2 max-h-16 overflow-y-auto"
              >
                <p data-preview-popup-body class="text-[10px] text-left break-words"></p>
              </div>
              <button
                type="button"
                tabindex="-1"
                class="win95-btn px-3 py-1 text-[10px] font-bold w-full"
                aria-hidden="true">OK</button
              >
              <p class="text-[8px] text-win-darkest mt-1.5 font-mono">MỖI PHIÊN TRUY CẬP MỘT LẦN</p>
            </div>
          </div>
        </div>
      </div>

      <p class="text-[9px] text-win-darkest font-mono">
        💡 Cả 3 khung cập nhật trực tiếp theo Tiêu đề + Nội dung. Chọn "Kiểu hiển thị" ở form bên
        dưới → khung tương ứng sáng viền neon.
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-5 gap-5 mb-10 items-start">
    <!-- Form tạo mới -->
    <form
      method="POST"
      action="/admin/announcements"
      class="lg:col-span-2 win95-container font-retro text-black"
    >
      <input type="hidden" name="action" value="create" />
      <div class="win95-header"><span>✉️ NEW_BROADCAST.MSG</span></div>
      <div class="p-4 bg-win-gray space-y-3">
        <div>
          <label for="ann-title" class="block text-[10px] font-bold uppercase mb-1"
            >Tiêu đề (hiện trên banner) *</label
          >
          <input
            id="ann-title"
            name="title"
            maxlength="120"
            required
            placeholder="VD: Triển lãm Mùa Hè Neon mở cửa!"
            class="w-full px-2 py-1.5 border-2 bg-white text-xs font-retro"
            style="border-color: #808080 #fff #fff #808080;"
          />
        </div>
        <div>
          <label for="ann-body" class="block text-[10px] font-bold uppercase mb-1"
            >Nội dung phụ (tùy chọn)</label
          >
          <textarea
            id="ann-body"
            name="body"
            rows="3"
            maxlength="300"
            placeholder="Chi tiết thêm hiển thị trong popup..."
            class="w-full px-2 py-1.5 border-2 bg-white text-xs font-retro"
            style="border-color: #808080 #fff #fff #808080; resize: vertical;"></textarea>
        </div>
        <div class="flex gap-3">
          <div class="flex-1">
            <label for="ann-type" class="block text-[10px] font-bold uppercase mb-1"
              >Kiểu hiển thị</label
            >
            <select
              id="ann-type"
              name="type"
              class="w-full px-2 py-1.5 border-2 bg-white text-xs font-retro"
              style="border-color: #808080 #fff #fff #808080;"
            >
              <option value="marquee">🎞️ Marquee — chữ chạy đầu trang</option>
              <option value="banner">🚩 Banner — dải màu nổi bật</option>
              <option value="popup">🪟 Popup — cửa sổ Win95 một lần</option>
            </select>
          </div>
          <div class="w-28">
            <label for="ann-days" class="block text-[10px] font-bold uppercase mb-1">Số ngày</label>
            <input
              id="ann-days"
              name="days"
              type="number"
              min="1"
              max="365"
              value="7"
              class="w-full px-2 py-1.5 border-2 bg-white text-xs font-retro"
              style="border-color: #808080 #fff #fff #808080;"
            />
          </div>
        </div>
        <button type="submit" class="win95-btn w-full font-bold text-xs py-2 bg-vapor-orange/25">
          📢 PHÁT THÔNG BÁO
        </button>
      </div>
    </form>

    <!-- Danh sách -->
    <div class="lg:col-span-3 win95-container font-retro text-black">
      <div class="win95-header"><span>📋 BROADCAST_HISTORY.LOG</span></div>
      <div class="m-1 border-2 border-win-dark bg-white divide-y divide-web-gray-panel min-h-40">
        {
          !announcements || announcements.length === 0 ? (
            <p class="p-8 text-center text-win-dark font-bold text-xs">
              CHƯA CÓ THÔNG BÁO NÀO. SOẠN TIN ĐẦU TIÊN NGAY!
            </p>
          ) : (
            announcements.map((a: Row) => {
              const expired = a.end_at && new Date(a.end_at) < new Date();
              return (
                <div
                  class={`p-3 flex flex-wrap sm:flex-nowrap items-center gap-3 ${!a.is_active || expired ? "opacity-60" : ""}`}
                >
                  <span aria-hidden="true">
                    {a.type === "popup" ? "🪟" : a.type === "banner" ? "🚩" : "🎞️"}
                  </span>
                  <div class="min-w-0 flex-1">
                    <p class="font-bold text-xs truncate">{a.title}</p>
                    <p class="text-[10px] text-win-dark">
                      Hết hạn: {formatAnnouncementDate(a.end_at)} ·{" "}
                      {expired ? "⚠️ CŨ" : a.is_active ? "🟢 ĐANG CHẠY" : "⏸ TẠM DỪNG"}
                    </p>
                  </div>
                  <div class="flex gap-1.5 shrink-0">
                    <form method="POST" class="m-0">
                      <input type="hidden" name="action" value="toggle" />
                      <input type="hidden" name="announcementId" value={a.id} />
                      <button type="submit" class="win95-btn text-[10px] px-2 py-1 font-bold">
                        {a.is_active ? "⏸ DỪNG" : "▶ CHẠY"}
                      </button>
                    </form>
                    <form method="POST" class="m-0">
                      <input type="hidden" name="action" value="delete" />
                      <input type="hidden" name="announcementId" value={a.id} />
                      <button
                        type="submit"
                        class="win95-btn btn-danger text-[10px] px-2 py-1 font-bold"
                        data-confirm="Xóa vĩnh viễn thông báo này?"
                      >
                        ❌
                      </button>
                    </form>
                  </div>
                </div>
              );
            })
          )
        }
      </div>
    </div>
  </div>

  <style>
    /* Khung preview được chọn sáng viền neon; khung khác mờ nhẹ */
    .ann-preview-card {
      opacity: 0.55;
      transition:
        opacity 0.15s ease,
        box-shadow 0.15s ease;
    }
    .ann-preview-card.ann-preview-active {
      opacity: 1;
      box-shadow:
        0 0 0 2px var(--vapor-cyan, #00f0ff),
        0 0 12px rgba(0, 240, 255, 0.45);
    }
    .ann-selected-badge {
      font-size: 8px;
      font-weight: 700;
      padding: 1px 6px;
      background: #000;
      color: var(--vapor-cyan, #00f0ff);
      font-family: var(--font-retro, monospace);
      letter-spacing: 0.05em;
    }
  </style>
  <script>
    // PREVIEW.ALL — wiring tách vào src/lib/announcementPreview.ts (unit-test được).
    import { initAnnouncementPreview } from "../../lib/announcementPreview";
    initAnnouncementPreview(document);
  </script>
</AdminLayout>
