---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { createSupabaseServerClient } from "../../lib/supabase";

let hasServerError = false;
let userProfile: { role?: string } | null = null;
let recentArticles: Array<Record<string, unknown>> | null = null;
let commentsCount: number | null = 0;
let pendingSubmissionsCount: number | null = 0;
let totalSubmissionsCount: number | null = 0;
let totalArticles = 0;
let publishedArticles = 0;
let draftArticles = 0;
let totalUsersCount: number | null = 0;
let bannedUsersCount: number | null = 0;

try {
  const supabase = createSupabaseServerClient({
    request: Astro.request,
    cookies: Astro.cookies
  });

  // Bước 1: Lấy thông tin người dùng và profile
  const { data: userData } = await supabase.auth.getUser();
  const user = userData?.user;

  if (user) {
    const { data: profileData } = await supabase
      .from("profiles")
      .select("*")
      .eq("id", user.id)
      .single();
    userProfile = profileData;
  }

  // Bước 2: Thống kê tổng quan (head-count rẻ)
  const { count: cc } = await supabase
    .from("comments")
    .select("*", { count: "exact", head: true });
  commentsCount = cc;

  const { count: psc } = await supabase
    .from("submissions")
    .select("*", { count: "exact", head: true })
    .eq("status", "pending");
  pendingSubmissionsCount = psc;

  const { count: tsc } = await supabase
    .from("submissions")
    .select("*", { count: "exact", head: true });
  totalSubmissionsCount = tsc;

  const { count: ta } = await supabase
    .from("articles")
    .select("*", { count: "exact", head: true });
  totalArticles = ta || 0;

  const { count: pa } = await supabase
    .from("articles")
    .select("*", { count: "exact", head: true })
    .eq("status", "published");
  publishedArticles = pa || 0;

  const { count: da } = await supabase
    .from("articles")
    .select("*", { count: "exact", head: true })
    .eq("status", "draft");
  draftArticles = da || 0;

  // Bước 3: 5 bài viết mới nhất cho khối RECENT_FILES
  const { data: recentData } = await supabase
    .from("articles")
    .select("id, title, slug, status, view_count, created_at")
    .order("created_at", { ascending: false })
    .limit(5);
  recentArticles = recentData;

  // Bước 4: Thống kê người dùng (chỉ admin)
  if (userProfile?.role === 'admin') {
    const { count: _totalUsers } = await supabase
      .from("profiles")
      .select("*", { count: "exact", head: true });
    totalUsersCount = _totalUsers;

    try {
      const { count: _bannedUsers } = await supabase
        .from("profiles")
        .select("*", { count: "exact", head: true })
        .eq("is_banned", true);
      bannedUsersCount = _bannedUsers;
    } catch {
      bannedUsersCount = 0; // cột is_banned chưa tồn tại nếu chưa chạy migration
    }
  }

} catch (err) {
  console.error("[ADMIN] Dashboard render crash:", err);
  hasServerError = true;
}
---

<AdminLayout title="VAPORWAVE MAGAZINE // ADMIN MISSION CONTROL" userProfile={userProfile} activePath="/admin">
  <!-- Thông báo lỗi server chung (không lộ stack trace) -->
  {hasServerError && (
    <div class="win95-container mb-6 font-retro text-xs border-red-600">
      <div class="win95-header bg-gradient-to-r from-red-800 to-red-600">
        <span>❌ SYSTEM_ALERT.ERR</span>
      </div>
      <div class="p-4 bg-red-50 text-black">
        <p class="font-bold">Trang quản trị gặp sự cố khi tải dữ liệu phía máy chủ.</p>
        <p class="mt-2 text-[10px] text-red-700">
          Chi tiết kỹ thuật đã được ghi vào Cloudflare Workers Logs. Hãy kiểm tra tab Logs trên Dashboard Cloudflare.
        </p>
      </div>
    </div>
  )}

  <!-- Header -->
  <div class="text-center py-6">
    <h1 class="text-4xl font-extrabold uppercase tracking-widest text-vapor-green font-retro">
      🎛️ CONTROL PANEL
    </h1>
    <p class="text-xs tracking-wider text-vapor-pink mt-2 font-retro uppercase">
      -- QUẢN TRỊ NỘI DUNG & THÀNH VIÊN VAPORWAVE --
    </p>
  </div>

  <!-- Stats Grid -->
  <div class="grid md:grid-cols-3 gap-6 mb-8 font-retro">
    <!-- Stat Item 1: Articles -->
    <div class="win95-container text-black">
      <div class="win95-header">
        <span>ARTICLE_STATS.DLL</span>
      </div>
      <div class="p-4 bg-win-gray flex items-center justify-between">
        <div>
          <h3 class="text-xs font-bold uppercase mb-1">Tổng Số Bài Viết</h3>
          <p class="text-3xl font-black text-vapor-purple">{totalArticles}</p>
          <p class="text-[10px] text-black/70 mt-1">
            Đã đăng: {publishedArticles} | Nháp: {draftArticles}
          </p>
        </div>
        <span class="text-4xl">📝</span>
      </div>
    </div>

    <!-- Stat Item 2: Comments -->
    <div class="win95-container text-black">
      <div class="win95-header">
        <span>COMMENT_STATS.DLL</span>
      </div>
      <div class="p-4 bg-win-gray flex items-center justify-between">
        <div>
          <h3 class="text-xs font-bold uppercase mb-1">Tổng Bình Luận</h3>
          <p class="text-3xl font-black text-vapor-blue">{commentsCount || 0}</p>
          <a href="/admin/comments" class="text-[10px] text-blue-800 underline mt-1 block">
            Quản lý bình luận & spam &gt;&gt;
          </a>
        </div>
        <span class="text-4xl">💬</span>
      </div>
    </div>

    <!-- Stat Item 3: Submissions -->
    <div class="win95-container text-black">
      <div class="win95-header">
        <span>GALLERY_STATS.DLL</span>
      </div>
      <div class="p-4 bg-win-gray flex items-center justify-between">
        <div>
          <h3 class="text-xs font-bold uppercase mb-1">Tranh Cộng Đồng</h3>
          <p class="text-3xl font-black text-vapor-pink">{totalSubmissionsCount || 0}</p>
          <p class="text-[10px] text-black/70 mt-1">
            Đang chờ duyệt: <span class="text-red-600 font-bold">{pendingSubmissionsCount || 0}</span>
          </p>
        </div>
        <span class="text-4xl">🖼️</span>
      </div>
    </div>

    <!-- Stat Item 4: Users (chỉ hiển thị cho admin) -->
    {userProfile?.role === 'admin' && (
      <div class="win95-container text-black">
        <div class="win95-header">
          <span>USER_STATS.DLL</span>
        </div>
        <div class="p-4 bg-win-gray flex items-center justify-between">
          <div>
            <h3 class="text-xs font-bold uppercase mb-1">Người Dùng</h3>
            <p class="text-3xl font-black text-vapor-green">{totalUsersCount || 0}</p>
            <p class="text-[10px] text-black/70 mt-1">
              Bị cấm: <span class={`font-bold ${(bannedUsersCount || 0) > 0 ? 'text-red-600' : 'text-green-700'}`}>{bannedUsersCount || 0}</span>
            </p>
            <a href="/admin/users" class="text-[10px] text-blue-800 underline mt-1 block">
              Quản lý người dùng &gt;&gt;
            </a>
          </div>
          <span class="text-4xl">👥</span>
        </div>
      </div>
    )}
  </div>

  <!-- Recent Files: 5 bài mới nhất — quản lý đầy đủ tại /admin/articles -->
  <div class="win95-container font-retro text-black mb-10">
    <div class="win95-header">
      <span>RECENT_FILES.EXE</span>
      <a href="/admin/articles" class="win95-btn text-xs font-bold py-0 px-2 no-underline text-black bg-win-gray border border-white">
        📚 MỞ ARTICLE MANAGER
      </a>
    </div>

    <div class="bg-white border-2 border-win-dark p-1">
      {!recentArticles || recentArticles.length === 0 ? (
        <p class="p-8 text-center text-win-dark font-bold">
          CHƯA CÓ BÀI VIẾT NÀO ĐƯỢC KHỞI TẠO. HÃY NHẤN "VIẾT BÀI MỚI" ĐỂ BẮT ĐẦU.
        </p>
      ) : (
        <ul class="divide-y divide-web-gray-panel">
          {recentArticles.map((article) => (
            <li class="flex flex-wrap items-center gap-2 px-3 py-2 hover:bg-web-gray-input text-xs">
              <span aria-hidden="true">📄</span>
              <a href={`/articles/${article.slug}`} target="_blank" rel="noopener" class="font-bold text-black no-underline hover:underline min-w-0 truncate">
                {article.title}
              </a>
              {article.status === "published" && <span class="badge badge-success shrink-0">Published</span>}
              {article.status === "draft" && <span class="badge badge-warning shrink-0">Draft</span>}
              {article.status !== "published" && article.status !== "draft" && <span class="badge badge-info shrink-0">{article.status}</span>}
              <span class="ml-auto text-[10px] text-win-dark whitespace-nowrap">
                👁 {article.view_count || 0} · {new Date(article.created_at).toLocaleDateString("vi-VN")}
              </span>
            </li>
          ))}
        </ul>
      )}
    </div>
    <p class="p-1.5 bg-win-gray border-t border-white text-[10px] text-win-dark font-retro flex justify-between">
      <span>RECENT_FILES.SYS v3.0</span>
      <a href="/admin/articles" class="text-blue-800 underline">Quản lý toàn bộ bài viết (lọc, nhân bản, hàng loạt...) &gt;&gt;</a>
    </p>
  </div>
</AdminLayout>
