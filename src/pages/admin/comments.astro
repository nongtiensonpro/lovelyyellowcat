---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { deleteCommentThread } from "../../lib/adminModeration";
import { logAdminAction } from "../../lib/adminAudit";
import { sendCommentDeletedEmail } from "../../lib/emailNotification";
import { createSupabaseServerClient } from "../../lib/supabase";
import { env } from "cloudflare:workers";
// Phase 7: pure admin table helpers (unit-tested)
import { parsePage, calcPage, buildAdminUrl } from "../../components/admin/adminTable";

const PAGE_SIZE = 20;

const supabase = createSupabaseServerClient({
  request: Astro.request,
  cookies: Astro.cookies
});

// Lấy thông tin người dùng hiện tại
const { data: { user } } = await supabase.auth.getUser();
let userProfile = null;
if (user) {
  const { data } = await supabase
    .from("profiles")
    .select("*")
    .eq("id", user.id)
    .single();
  userProfile = data;
}

// ── Query params: tìm kiếm + phân trang (Phase 7: qua adminTable helpers) ──
const url = new URL(Astro.request.url);
const search = url.searchParams.get("search")?.trim() || "";
const page = parsePage(url.searchParams.get("page"));
const buildUrl = (params: Record<string, string>) => buildAdminUrl("/admin/comments", Astro.url.origin, params);

// Xử lý các hành động POST từ Admin (Xóa bình luận)
let actionResult: { success: boolean; message: string } | null = null;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const action = formData.get("action");
  const commentId = formData.get("commentId") as string;
  const deleteReason = formData.get("deleteReason") as string || "";

  if (action === "delete" && commentId) {
    // Lấy thông tin bình luận + tác giả TRƯỚC khi xóa (để gửi email)
    let commentData: { profiles?: { full_name?: string; avatar_url?: string } | null } | null = null;
    try {
      const { data } = await supabase
        .from("comments")
        .select("content, profile_id, profiles(email, full_name)")
        .eq("id", commentId)
        .single();
      commentData = data;
    } catch {}

    try {
      actionResult = await deleteCommentThread(supabase, commentId);
    } catch (err) {
      actionResult = { success: false, message: `Sự cố hệ thống: ${err instanceof Error ? err.message : String(err)}` };
    }

    // Ghi audit log cho thao tác xóa bình luận
    if (actionResult?.success && user) {
      await logAdminAction(supabase, {
        adminId: user.id,
        action: "comment_delete",
        targetType: "comment",
        targetId: commentId,
        details: { reason: deleteReason || null },
      });
    }

    // Gửi email thông báo nếu xóa thành công
    if (actionResult?.success && commentData?.profiles) {
      const profile = commentData.profiles;
      if (profile?.email) {
        try {
          await sendCommentDeletedEmail({
            recipientEmail: profile.email,
            recipientName: profile.full_name || profile.email,
            commentContent: commentData.content || "",
            reason: deleteReason || "Vi phạm quy tắc cộng đồng.",
            contactEmail: "nongtiensonpro@gmail.com",
          }, env);
        } catch (emailErr) {
          console.error("[COMMENTS] Email error:", emailErr instanceof Error ? emailErr.message : String(emailErr));
        }
      }
    }
  } else {
    actionResult = { success: false, message: "Hành động không hợp lệ hoặc thiếu thông tin bình luận." };
  }
}

// Lấy danh sách bình luận (phân trang + tìm kiếm nội dung/tác giả)
let commentsQuery = supabase
  .from("comments")
  .select(`
    id,
    content,
    created_at,
    article_id,
    profile_id,
    profiles (
      full_name,
      avatar_url
    )
  `, { count: "exact" });

if (search) {
  commentsQuery = commentsQuery.or(`content.ilike.%${search}%,profiles.full_name.ilike.%${search}%`);
}

commentsQuery = commentsQuery.order("created_at", { ascending: false });

// Phase 7: pagination qua adminTable (unit-tested) — from/to từ page, totalPages sau khi có count
const pageFrom = (page - 1) * PAGE_SIZE;
const { data: comments, count: commentsCount, error: fetchError } =
  await commentsQuery.range(pageFrom, pageFrom + PAGE_SIZE - 1);

const pageCalc = calcPage(commentsCount || 0, page, PAGE_SIZE);
const totalPages = pageCalc.totalPages;

// Tra tiêu đề bài viết cho các bình luận trong trang hiện tại
// (comments.article_id là TEXT — có thể là uuid hoặc slug cũ)
const articleLookup = new Map<string, { title: string; slug: string }>();
if (comments && comments.length > 0) {
  const rawIds = Array.from(new Set(comments.map((c: { article_id: string }) => String(c.article_id)).filter(Boolean)));
  const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
  const uuidIds = rawIds.filter((id) => UUID_RE.test(id));
  const slugIds = rawIds.filter((id) => !UUID_RE.test(id));

  if (uuidIds.length > 0) {
    const { data } = await supabase.from("articles").select("id, title, slug").in("id", uuidIds);
    (data || []).forEach((a: { id: string }) => articleLookup.set(a.id, a));
  }
  if (slugIds.length > 0) {
    const { data } = await supabase.from("articles").select("id, title, slug").in("slug", slugIds);
    (data || []).forEach((a: { slug: string }) => articleLookup.set(a.slug, a));
  }
}
type Row = { [key: string]: unknown };

---

<AdminLayout title="VAPORWAVE MAGAZINE // QUẢN LÝ BÌNH LUẬN" userProfile={userProfile} activePath="/admin/comments">
  <!-- Thông báo kết quả hành động -->
  {actionResult && (
    <div class={`win95-container mb-6 font-retro text-xs ${actionResult.success ? "border-vapor-green" : "border-red-600"}`}>
      <div class={`win95-header ${actionResult.success ? "bg-gradient-to-r from-green-700 to-green-600" : "bg-gradient-to-r from-red-800 to-red-600"}`}>
        <span>{actionResult.success ? "✅ SYSTEM_LOG.OK" : "❌ SYSTEM_ALERT.ERR"}</span>
        <span class="text-[10px]">{new Date().toLocaleTimeString("vi-VN", { hour: '2-digit', minute: '2-digit', second: '2-digit' })}</span>
      </div>
      <div class={`p-3 text-black font-bold ${actionResult.success ? "bg-green-100" : "bg-red-100"}`}>
        <span class="mr-2">{actionResult.success ? "🟢" : "🔴"}</span>
        {actionResult.message}
      </div>
    </div>
  )}

  <!-- Thông báo lỗi tải dữ liệu -->
  {fetchError && (
    <div class="win95-container mb-6 font-retro text-xs border-red-600">
      <div class="win95-header bg-gradient-to-r from-red-800 to-red-600">
        <span>❌ DATABASE_ERROR.ERR</span>
      </div>
      <div class="p-3 text-black font-bold bg-red-100">
        🔴 Không thể tải danh sách bình luận: {fetchError.message}
      </div>
    </div>
  )}

  <!-- Header -->
  <div class="text-center py-6">
    <h1 class="text-3xl font-extrabold uppercase tracking-widest text-vapor-blue font-retro">
      💬 COMMENT MODERATION
    </h1>
    <p class="text-xs tracking-wider text-vapor-pink mt-2 font-retro uppercase">
      -- KIỂM DUYỆT VÀ ĐIỀU PHỐI CUỘC TRÒ CHUYỆN CỘNG ĐỒNG --
    </p>
  </div>

  <!-- Thanh tìm kiếm -->
  <form method="GET" action="/admin/comments" class="win95-container font-retro text-black mb-4">
    <div class="win95-header"><span>🔍 SEARCH_COMMENTS.DLL</span></div>
    <div class="p-3 bg-win-gray flex flex-wrap gap-3 items-end">
      <div class="flex-1 min-w-[220px]">
        <label for="search" class="block text-[10px] font-bold uppercase mb-1">Tìm theo nội dung bình luận / tên tác giả</label>
        <input id="search" name="search" value={search} placeholder="Nhập từ khóa..."
          class="w-full px-2 py-1.5 border-2 bg-white text-xs font-retro" style="border-color: #808080 #fff #fff #808080;" />
      </div>
      <div class="flex gap-2">
        <button type="submit" class="win95-btn font-bold text-xs px-4 py-1.5">🔍 TÌM</button>
        {search && (
          <a href="/admin/comments" class="win95-btn font-bold text-xs px-3 py-1.5 no-underline">🔄 RESET</a>
        )}
      </div>
    </div>
  </form>

  <!-- Comments Moderation Table Area -->
  <div class="win95-container font-retro text-black mb-6">
    <div class="win95-header">
      <span>COMMENTS_DATABASE.DB</span>
      <span class="text-[10px] text-vapor-green">TỔNG: {commentsCount || 0} BẢN GHI · TRANG {page}/{totalPages}</span>
    </div>

    <div class="bg-white overflow-x-auto border-2 border-win-dark p-1">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="bg-win-gray border-b border-win-dark">
            <th class="p-2 border-r border-win-dark font-bold w-48">NGƯỜI GỬI</th>
            <th class="p-2 border-r border-win-dark font-bold w-52">BÀI VIẾT</th>
            <th class="p-2 border-r border-win-dark font-bold">NỘI DUNG BÌNH LUẬN</th>
            <th class="p-2 border-r border-win-dark font-bold w-36">NGÀY GỬI</th>
            <th class="p-2 font-bold w-32 text-center">HÀNH ĐỘNG</th>
          </tr>
        </thead>
        <tbody>
          {!comments || comments.length === 0 ? (
            <tr>
              <td colspan="5" class="p-8 text-center text-win-dark font-bold">
                <span class="text-2xl block mb-2">💾</span>
                CHƯA CÓ BÌNH LUẬN NÀO ĐƯỢC GỬI TRÊN HỆ THỐNG.
              </td>
            </tr>
          ) : (
            comments.map((comment: Row) => (
              <tr class="border-b border-web-gray-panel hover:bg-paper-soft">
                <td class="p-2 border-r border-web-gray-panel font-bold text-black">
                  <div class="flex items-center gap-2">
                    <img src={comment.profiles?.avatar_url || "/images/default-avatar.png"} class="w-6 h-6 border border-win-dark object-cover" alt="" />
                    <span class="break-all">{comment.profiles?.full_name || "Anonymous"}</span>
                  </div>
                </td>
                <td class="p-2 border-r border-web-gray-panel">
                  {(() => {
                    const art = articleLookup.get(String(comment.article_id));
                    return art ? (
                      <a href={`/articles/${art.slug}`} class="text-[10px] font-bold text-vapor-purple hover:underline no-underline" target="_blank" rel="noopener">
                        📄 {art.title}
                      </a>
                    ) : (
                      <a href={`/articles/${comment.article_id}`} class="font-mono text-[10px] text-win-dark hover:underline no-underline break-all" target="_blank" rel="noopener">
                        #{String(comment.article_id).slice(0, 12)}…
                      </a>
                    );
                  })()}
                </td>
                <td class="p-2 border-r border-web-gray-panel text-black italic max-w-md">
                  <div class="break-words line-clamp-3">"{comment.content}"</div>
                </td>
                <td class="p-2 border-r border-web-gray-panel text-win-dark text-[10px]">
                  {new Date(comment.created_at).toLocaleString("vi-VN")}
                </td>
                <td class="p-2 text-center">
                  <details class="relative">
                    <summary class="win95-btn font-bold text-red-700 text-[10px] px-3 py-1 hover:bg-red-100 cursor-pointer list-none">
                      ❌ XÓA
                    </summary>
                    <div class="absolute right-0 top-full z-50 mt-1 w-64 bg-win-gray border-2 shadow-lg p-2 font-retro" style="border-color: #fff #808080 #808080 #fff;">
                      <form method="POST" class="m-0">
                        <input type="hidden" name="action" value="delete" />
                        <input type="hidden" name="commentId" value={comment.id} />
                        <label class="block text-[10px] font-bold mb-1 text-black">📋 Lý do xóa:</label>
                        <select name="deleteReasonPreset" class="w-full text-[10px] p-1 border border-win-dark bg-white mb-1 font-retro"
                          onchange={`this.form.deleteReason.value = this.value`}>
                          <option value="">-- Chọn lý do --</option>
                          <option value="Vi phạm quy tắc cộng đồng (ngôn từ không phù hợp).">Ngôn từ không phù hợp</option>
                          <option value="Spam hoặc nội dung quảng cáo.">Spam / Quảng cáo</option>
                          <option value="Nội dung gây hiểu lầm hoặc thông tin sai lệch.">Thông tin sai lệch</option>
                          <option value="Quấy rối hoặc bắt nạt người dùng khác.">Quấy rối</option>
                          <option value="Nội dung không liên quan đến chủ đề.">Không liên quan</option>
                        </select>
                        <textarea name="deleteReason" placeholder="Hoặc nhập lý do khác..." rows="2" class="w-full text-[10px] p-1 border border-win-dark bg-white mb-2 font-retro" style="resize:vertical;"></textarea>
                        <button type="submit" class="win95-btn w-full font-bold text-red-700 text-[10px] py-1 hover:bg-red-100" data-confirm="⚠️ Xác nhận xóa bình luận này?">
                          ❌ Xác nhận xóa
                        </button>
                      </form>
                    </div>
                  </details>
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    {totalPages > 1 && (
      <nav class="pagination-bar my-4" aria-label="Phân trang bình luận">
        {page > 1 ? (
          <a href={buildUrl({ page: String(page - 1), search })} class="win95-btn no-underline font-bold">◀ Trước</a>
        ) : (
          <span class="win95-btn text-win-dark">◀ Trước</span>
        )}
        <span class="page-info">Trang {page} / {totalPages}</span>
        {page < totalPages ? (
          <a href={buildUrl({ page: String(page + 1), search })} class="win95-btn no-underline font-bold">Sau ▶</a>
        ) : (
          <span class="win95-btn text-win-dark">Sau ▶</span>
        )}
      </nav>
    )}

    <!-- Status Bar -->
    <div class="p-1.5 bg-win-gray border-t border-white text-[10px] text-win-dark font-retro flex justify-between">
      <span>COMMENT_MODERATION.SYS v3.0</span>
      <span>{commentsCount || 0} bình luận | Cập nhật: {new Date().toLocaleTimeString("vi-VN", { hour: '2-digit', minute: '2-digit' })}</span>
    </div>
  </div>
</AdminLayout>
