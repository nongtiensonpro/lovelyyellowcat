---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { logAdminAction } from "../../lib/adminAudit";
import { createSupabaseServerClient } from "../../lib/supabase";
import { sendSubmissionApprovedEmail, sendSubmissionRejectedEmail } from "../../lib/emailNotification";
import { env } from "cloudflare:workers";

const runtimeEnv = env;

const supabase = createSupabaseServerClient({
  request: Astro.request,
  cookies: Astro.cookies
});

// Lấy thông tin người dùng hiện tại
const { data: { user } } = await supabase.auth.getUser();
let userProfile = null;
if (user) {
  const { data } = await supabase
    .from("profiles")
    .select("*")
    .eq("id", user.id)
    .single();
  userProfile = data;
}

// Xử lý các hành động Duyệt bài (Approve / Reject / Delete)
let actionResult: { success: boolean; message: string } | null = null;

if (Astro.request.method === "POST" && user) {
  const formData = await Astro.request.formData();
  const action = formData.get("action");
  const submissionId = formData.get("submissionId") as string;
  const rejectReason = formData.get("rejectReason") as string || "";

  if (submissionId && (action === "approve" || action === "reject")) {
    const status = action === "approve" ? "approved" : "rejected";
    
    // Cập nhật trạng thái duyệt tranh (lưu luôn rejection_reason khi từ chối)
    const { data: updatedSubmission, error: errUpdate } = await supabase
      .from("submissions")
      .update({
        status,
        reviewed_by: user.id,
        reviewed_at: new Date().toISOString(),
        ...(status === "rejected" ? { rejection_reason: rejectReason || null } : {})
      })
      .eq("id", submissionId)
      .select("id, author_id, title")
      .maybeSingle<{ id: string; author_id: string | null; title: string }>();

    // Ghi audit log cho thao tác duyệt / từ chối
    if (!errUpdate && updatedSubmission && user) {
      await logAdminAction(supabase, {
        adminId: user.id,
        action: action === "approve" ? "submission_approve" : "submission_reject",
        targetType: "submission",
        targetId: submissionId,
        details: { title: updatedSubmission.title || null, reason: status === "rejected" ? rejectReason || null : undefined },
      });
    }

    if (errUpdate) {
      actionResult = { success: false, message: `Lỗi khi ${action === "approve" ? "duyệt" : "từ chối"} tranh: ${errUpdate.message}` };
    } else if (!updatedSubmission) {
      actionResult = {
        success: false,
        message: "Không tìm thấy tranh hoặc bạn không có quyền cập nhật. Nếu đang dùng tài khoản editor, hãy chạy migration supabase_admin_moderation_fixes.sql để cập nhật RLS."
      };
    } else if (action === "approve") {
      const warnings: string[] = [];

      if (updatedSubmission.author_id) {
        const { error: xpError } = await supabase.rpc("award_xp", {
          p_profile_id: updatedSubmission.author_id,
          p_xp_amount: 50
        });

        if (xpError) {
          warnings.push(`không cộng được XP: ${xpError.message}`);
        }

        // Tạo thông báo in-app cho tác giả
        const { error: notificationError } = await supabase
          .from("notifications")
          .insert({
            recipient: updatedSubmission.author_id,
            type: "submission_approved",
            payload: {
              submission_id: submissionId,
              message: "Tác phẩm nghệ thuật của bạn đã được ban biên tập phê duyệt công khai! (+50 XP)"
            }
          });

        if (notificationError) {
          warnings.push(`không gửi được thông báo: ${notificationError.message}`);
        }

        // Gửi email thông báo duyệt tranh
        try {
          const { data: authorProfile } = await supabase
            .from("profiles")
            .select("email, full_name")
            .eq("id", updatedSubmission.author_id)
            .single();

          if (authorProfile?.email) {
            const emailResult = await sendSubmissionApprovedEmail({
              recipientEmail: authorProfile.email,
              recipientName: authorProfile.full_name || authorProfile.email,
              submissionTitle: updatedSubmission.title || "Tác phẩm nghệ thuật",
              contactEmail: "nongtiensonpro@gmail.com",
            }, runtimeEnv);
            if (!emailResult.success) {
              warnings.push(`email: ${emailResult.message}`);
            }
          }
        } catch (emailErr: any) {
          warnings.push(`không gửi được email: ${emailErr.message}`);
        }
      }

      actionResult = {
        success: true,
        message: warnings.length > 0
          ? `Đã duyệt tác phẩm, nhưng ${warnings.join("; ")}.`
          : "Đã duyệt tác phẩm thành công! Tác giả được thưởng +50 XP, đã nhận thông báo và email."
      };
    } else {
      const warnings: string[] = [];

      if (updatedSubmission.author_id) {
        // Tạo thông báo từ chối in-app cho tác giả
        const { error: notificationError } = await supabase
          .from("notifications")
          .insert({
            recipient: updatedSubmission.author_id,
            type: "submission_rejected",
            payload: {
              submission_id: submissionId,
              message: rejectReason || "Rất tiếc, tác phẩm nghệ thuật của bạn chưa phù hợp tiêu chí chất lượng của tạp chí lần này."
            }
          });

        if (notificationError) {
          warnings.push(`không gửi được thông báo: ${notificationError.message}`);
        }

        // Gửi email thông báo từ chối tranh
        try {
          const { data: authorProfile } = await supabase
            .from("profiles")
            .select("email, full_name")
            .eq("id", updatedSubmission.author_id)
            .single();

          if (authorProfile?.email) {
            const emailResult = await sendSubmissionRejectedEmail({
              recipientEmail: authorProfile.email,
              recipientName: authorProfile.full_name || authorProfile.email,
              submissionTitle: updatedSubmission.title || "Tác phẩm nghệ thuật",
              reason: rejectReason || "Tác phẩm chưa phù hợp tiêu chí chất lượng của tạp chí.",
              contactEmail: "nongtiensonpro@gmail.com",
            }, runtimeEnv);
            if (!emailResult.success) {
              warnings.push(`email: ${emailResult.message}`);
            }
          }
        } catch (emailErr: any) {
          warnings.push(`không gửi được email: ${emailErr.message}`);
        }
      }

      actionResult = {
        success: true,
        message: warnings.length > 0
          ? `Đã từ chối tác phẩm, nhưng ${warnings.join("; ")}.`
          : "Đã từ chối tác phẩm. Tác giả đã được thông báo qua hệ thống và email."
      };
    }
  } else if (submissionId && action === "toggle_featured" && user) {
    const { data: current } = await supabase
      .from("submissions")
      .select("is_featured, title, author_id")
      .eq("id", submissionId)
      .single();

    if (current) {
      const nextValue = !(current.is_featured ?? false);
      const { error } = await supabase
        .from("submissions")
        .update({ is_featured: nextValue })
        .eq("id", submissionId);

      if (!error) {
        await logAdminAction(supabase, {
          adminId: user.id,
          action: "submission_feature_toggle",
          targetType: "submission",
          targetId: submissionId,
          details: { featured: nextValue, title: current.title },
        });
        actionResult = { success: true, message: nextValue
          ? `Đã đưa "${current.title || "tác phẩm"}" vào mục 🏆 TRANH NỔI BẬT trang chủ.`
          : `Đã gỡ khỏi mục nổi bật.` };
      } else {
        actionResult = { success: false, message: `Lỗi cập nhật: ${error.message}` };
      }
    }
  } else if (submissionId && action === "delete" && user) {
    try {
      // Soft-delete: gạt status rejected + đóng dấu deleted_at → khôi phục được từ Thùng Rác
      const { error } = await supabase
        .from("submissions")
        .update({ deleted_at: new Date().toISOString(), status: "rejected" })
        .eq("id", submissionId);

      if (!error) {
        await logAdminAction(supabase, {
          adminId: user.id,
          action: "submission_soft_delete",
          targetType: "submission",
          targetId: submissionId,
        });
        actionResult = { success: true, message: "Đã đưa tranh vào Thùng Rác (khôi phục được trong 30 ngày)." };
      } else {
        actionResult = { success: false, message: `Lỗi khi xóa: ${error.message}` };
      }
    } catch (err: any) {
      actionResult = { success: false, message: `Sự cố hệ thống: ${err.message}` };
    }
  }
}

// ── Tab trạng thái + phân trang ──
const listUrl = new URL(Astro.request.url);
const statusTab = listUrl.searchParams.get("status") || "pending";
const page = Math.max(1, parseInt(listUrl.searchParams.get("page") || "1"));
const PAGE_SIZE = 12;

function buildSubmissionUrl(params: Record<string, string>) {
  const u = new URL("/admin/submissions", Astro.url.origin);
  Object.entries(params).forEach(([k, v]) => {
    if (v) u.searchParams.set(k, v);
    else u.searchParams.delete(k);
  });
  return u.pathname + u.search;
}

// Lấy danh sách tác phẩm theo tab hiện tại
let submissionsQuery = supabase
  .from("submissions")
  .select(`
    id,
    title,
    description,
    image_url,
    status,
    rejection_reason,
    is_featured,
    created_at,
    profiles:profiles!author_id (
      full_name,
      avatar_url
    )
  `, { count: "exact" });

if (["pending", "approved", "rejected"].includes(statusTab)) {
  submissionsQuery = submissionsQuery.eq("status", statusTab);
}
submissionsQuery = submissionsQuery.is("deleted_at", null);
submissionsQuery = submissionsQuery.order("created_at", { ascending: true });

const subFrom = (page - 1) * PAGE_SIZE;
const { data: submissions, count: tabTotal } =
  await submissionsQuery.range(subFrom, subFrom + PAGE_SIZE - 1);

const subTotalPages = Math.max(1, Math.ceil((tabTotal || 0) / PAGE_SIZE));

// Đếm nhanh từng nhãn cho tab bar
const { count: pendingSubmissionsCount } = await supabase
  .from("submissions")
  .select("*", { count: "exact", head: true })
  .eq("status", "pending");

const { count: approvedCount } = await supabase
  .from("submissions")
  .select("*", { count: "exact", head: true })
  .eq("status", "approved");

const { count: rejectedCount } = await supabase
  .from("submissions")
  .select("*", { count: "exact", head: true })
  .eq("status", "rejected");
---

<AdminLayout title="VAPORWAVE MAGAZINE // DUYỆT TRANH CỘNG ĐỒNG" userProfile={userProfile} activePath="/admin/submissions">
  <!-- Thông báo kết quả hành động -->
  {actionResult && (
    <div class={`win95-container mb-6 font-retro text-xs ${actionResult.success ? "border-vapor-green" : "border-red-600"}`}>
      <div class={`win95-header ${actionResult.success ? "bg-gradient-to-r from-green-700 to-green-600" : "bg-gradient-to-r from-red-800 to-red-600"}`}>
        <span>{actionResult.success ? "✅ SYSTEM_LOG.OK" : "❌ SYSTEM_ALERT.ERR"}</span>
      </div>
      <div class={`p-3 text-black font-bold ${actionResult.success ? "bg-green-100" : "bg-red-100"}`}>
        <span class="mr-2">{actionResult.success ? "🟢" : "🔴"}</span>
        {actionResult.message}
      </div>
    </div>
  )}

  <!-- Header -->
  <div class="text-center py-6">
    <h1 class="text-3xl font-extrabold uppercase tracking-widest text-vapor-pink font-retro">
      🖼️ GALLERY MODERATION
    </h1>
    <p class="text-xs tracking-wider text-vapor-blue mt-2 font-retro uppercase">
      -- KIỂM DUYỆT TÁC PHẨM TẢI LÊN TỪ CỘNG ĐỒNG NGHỆ THUẬT VAPORWAVE --
    </p>
  </div>

  <!-- Tab lọc theo trạng thái -->
  <div class="flex flex-wrap gap-1 mb-4 font-retro text-[11px]" role="tablist" aria-label="Lọc theo trạng thái">
    {[
      { key: "pending", label: "⏳ Chờ duyệt", count: pendingSubmissionsCount },
      { key: "approved", label: "🟢 Đã duyệt", count: approvedCount },
      { key: "rejected", label: "🔴 Đã từ chối", count: rejectedCount },
      { key: "", label: "🗂 Tất cả", count: (pendingSubmissionsCount || 0) + (approvedCount || 0) + (rejectedCount || 0) },
    ].map((tab) => (
      <a
        href={buildSubmissionUrl({ status: tab.key })}
        aria-current={statusTab === tab.key ? "true" : undefined}
        class:list={[
          "win95-btn no-underline font-bold",
          statusTab === tab.key ? "active" : "",
        ]}
      >
        {tab.label} ({tab.count ?? 0})
      </a>
    ))}
    <span class="ml-auto self-center text-[10px] text-text-secondary">Sắp xếp: cũ nhất trước để duyệt công bằng theo thứ tự gửi</span>
  </div>

  <!-- Submissions Gallery Layout -->
  <div class="win95-container font-retro text-black mb-6">
    <div class="win95-header">
      <span>SUBMISSION_ARCHIVE.DB</span>
      <span class="text-[10px] text-vapor-yellow font-bold uppercase">
        {statusTab === "" ? "TẤT CẢ" : statusTab.toUpperCase()}: {tabTotal || 0} · TRANG {page}/{subTotalPages}
      </span>
    </div>

    <div class="p-4 bg-[#c0c0c0] grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {!submissions || submissions.length === 0 ? (
        <div class="col-span-full p-12 text-center text-win-dark font-bold bg-white border border-win-dark shadow-inner">
          <span class="text-4xl block mb-2">📼</span>
          {statusTab === "pending"
            ? "KHÔNG CÒN TRANH NÀO CHỜ DUYỆT. TUYỆT VỜI!"
            : "KHÔNG CÓ TÁC PHẨM NÀO TRONG NHÃN NÀY."}
        </div>
      ) : (
        submissions.map((sub: any) => (
          <div class="win95-container bg-white flex flex-col justify-between p-2 shadow-sm border border-win-dark">
            <div>
              <div class="win95-header mb-2">
                <span class="break-all font-mono text-[10px]">{sub.id}</span>
                <span class="flex items-center gap-1">
                  {sub.is_featured && <span class="text-vapor-yellow text-[10px]" title="Đang nổi bật trên trang chủ">★</span>}
                  <span class={`px-1.5 py-0.2 border text-[10px] font-bold uppercase ${
                    sub.status === 'approved'
                      ? 'bg-green-100 text-green-800 border-green-300'
                      : sub.status === 'pending'
                      ? 'bg-yellow-100 text-yellow-800 border-yellow-300'
                      : 'bg-red-100 text-red-800 border-red-300'
                  }`}>
                    {sub.status}
                  </span>
                </span>
              </div>
              <div class="relative overflow-hidden border border-win-dark bg-black h-48 flex items-center justify-center">
                <img 
                  src={sub.image_url} 
                  alt={sub.title} 
                  class="w-full h-full object-contain filter saturate-150 contrast-110" 
                />
              </div>
              <div class="p-2 space-y-1">
                <h3 class="font-bold text-sm text-black truncate">{sub.title}</h3>
                <p class="text-[10px] text-black/85 leading-normal min-h-8 line-clamp-2">
                  {sub.description || "Không có mô tả..."}
                </p>
                <div class="border-t border-dashed border-win-dark/30 pt-2 flex items-center gap-1.5 text-[10px]">
                  <img src={sub.profiles?.avatar_url || "/images/default-avatar.png"} class="w-4 h-4 border border-win-dark" alt="" />
                  <span class="text-win-dark truncate">Tác giả: <strong>{sub.profiles?.full_name || "Anonymous"}</strong></span>
                </div>
                {sub.status === "rejected" && sub.rejection_reason && (
                  <p class="mt-1 p-1.5 bg-red-50 border border-red-200 text-[10px] text-red-800 leading-snug">
                    📋 Lý do từ chối: {sub.rejection_reason}
                  </p>
                )}
              </div>
            </div>
            
            {sub.status === 'pending' && (
              <div class="p-2 bg-[#f0f0f0] border-t border-win-dark space-y-2">
                <!-- Form từ chối với lý do soạn sẵn -->
                <form method="POST" class="m-0">
                  <input type="hidden" name="submissionId" value={sub.id} />
                  <input type="hidden" name="action" value="reject" />
                  <select name="rejectReasonPreset" class="w-full text-[10px] p-1 border border-win-dark bg-white font-retro mb-1"
                    onchange={`this.form.rejectReason.value = this.value`}>
                    <option value="">-- Chọn lý do từ chối --</option>
                    <option value="Hình ảnh không đạt chất lượng yêu cầu (độ phân giải thấp, mờ, hoặc bị hỏng).">Chất lượng hình ảnh</option>
                    <option value="Nội dung không phù hợp với chủ đề Vaporwave / Aesthetic của tạp chí.">Không phù hợp chủ đề</option>
                    <option value="Vi phạm bản quyền hoặc sử dụng hình ảnh không được phép.">Vi phạm bản quyền</option>
                    <option value="Nội dung không phù hợp hoặc vi phạm quy tắc cộng đồng.">Vi phạm quy tắc</option>
                    <option value="Trùng lặp với bài đã đăng trước đó.">Trùng lặp</option>
                  </select>
                  <textarea name="rejectReason" placeholder="Nhập lý do từ chối hoặc chọn mẫu câu ở trên..." rows="2" class="w-full text-[10px] p-1 border border-win-dark bg-white font-retro mb-1" style="resize:vertical;"></textarea>
                  <button type="submit" class="win95-btn w-full font-bold text-red-800 text-[10px] py-1 border-red-400">
                    🔴 TỪ CHỐI
                  </button>
                </form>
                <!-- Duyệt + Xóa -->
                <div class="flex gap-2">
                  <form method="POST" class="flex-1 m-0">
                    <input type="hidden" name="submissionId" value={sub.id} />
                    <input type="hidden" name="action" value="approve" />
                    <button type="submit" class="win95-btn w-full font-bold text-green-800 text-[10px] py-1 border-green-400">
                      🟢 DUYỆT
                    </button>
                  </form>
                  <form method="POST" class="flex-1 m-0" onsubmit="return confirm('⚠️ Xóa vĩnh viễn tranh này cùng toàn bộ dữ liệu liên quan?');">
                    <input type="hidden" name="submissionId" value={sub.id} />
                    <input type="hidden" name="action" value="delete" />
                    <button type="submit" class="win95-btn w-full font-bold text-red-900 text-[10px] py-1 bg-red-200 border-red-500">
                      ❌ XÓA
                    </button>
                  </form>
                </div>
              </div>
            )}

            {sub.status !== 'pending' && (
              <div class="p-2 bg-[#f0f0f0] border-t border-win-dark flex justify-between gap-2">
                <form method="POST" class="m-0">
                  <input type="hidden" name="submissionId" value={sub.id} />
                  <input type="hidden" name="action" value="toggle_featured" />
                  <button type="submit" class={`win95-btn text-[10px] px-2 py-1 font-bold ${sub.is_featured ? "text-vapor-purple" : ""}`}>
                    {sub.is_featured ? "★ Bỏ nổi bật" : "☆ Nổi bật"}
                  </button>
                </form>
                <form method="POST" class="m-0" onsubmit="return confirm('⚠️ Xóa vĩnh viễn tranh này cùng toàn bộ dữ liệu liên quan?');">
                  <input type="hidden" name="submissionId" value={sub.id} />
                  <input type="hidden" name="action" value="delete" />
                  <button type="submit" class="win95-btn font-bold text-red-900 text-[10px] py-1 px-3 bg-red-200 border-red-500">
                    ❌ XÓA
                  </button>
                </form>
              </div>
            )}
          </div>
        ))
      )}
    </div>
  </div>

  <!-- Pagination -->
  {subTotalPages > 1 && (
    <nav class="pagination-bar mb-8" aria-label="Phân trang tranh cộng đồng">
      {page > 1 ? (
        <a href={buildSubmissionUrl({ page: String(page - 1), status: statusTab })} class="win95-btn no-underline font-bold">◀ Trước</a>
      ) : (
        <span class="win95-btn text-win-dark">◀ Trước</span>
      )}
      <span class="page-info">Trang {page} / {subTotalPages}</span>
      {page < subTotalPages ? (
        <a href={buildSubmissionUrl({ page: String(page + 1), status: statusTab })} class="win95-btn no-underline font-bold">Sau ▶</a>
      ) : (
        <span class="win95-btn text-win-dark">Sau ▶</span>
      )}
    </nav>
  )}
</AdminLayout>
