---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { createSupabaseServerClient } from "../../lib/supabase";
import { searchCloudinaryImages, deleteCloudinaryImages, getCloudinaryPublicIdFromUrl, getCloudinaryPublicIdsFromText } from "../../lib/cloudinary";
import { logAdminAction } from "../../lib/adminAudit";
import { env } from "cloudflare:workers";

const runtimeEnv = env as unknown as Record<string, string | undefined>;

const supabase = createSupabaseServerClient({
  request: Astro.request,
  cookies: Astro.cookies
});

const { data: { user } } = await supabase.auth.getUser();
let userProfile: { role?: string } | null = null;
if (user) {
  const { data } = await supabase
    .from("profiles")
    .select("*")
    .eq("id", user.id)
    .single();
  userProfile = data;
}

if (!user || !userProfile || userProfile.role !== "admin") {
  return Astro.redirect("/admin?error=admin-only");
}

// ── Tên cloud để dựng URL delivery ──
const cloudName: string =
  runtimeEnv?.PUBLIC_CLOUDINARY_CLOUD_NAME
  || import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME
  || "";

function cdnUrl(publicId: string, transform?: string): string {
  const encoded = String(publicId).split("/").map(encodeURIComponent).join("/");
  return `https://res.cloudinary.com/${cloudName}/image/upload/${transform ? transform + "/" : ""}${encoded}`;
}

function formatBytes(bytes?: number): string {
  if (!bytes) return "—";
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1048576) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${(bytes / 1048576).toFixed(2)} MB`;
}

// ── Query params: lọc + phân trang con trỏ hai chiều ──
const url = new URL(Astro.request.url);
const q = url.searchParams.get("q")?.trim() || "";
const folder = url.searchParams.get("folder")?.trim() || "";
const minkbRaw = parseInt(url.searchParams.get("minkb") || "");
const minkb = isNaN(minkbRaw) || minkbRaw <= 0 ? undefined : minkbRaw;
const from = url.searchParams.get("from")?.trim() || "";
const sortParam = url.searchParams.get("sort") || "newest";
const sortKey = (["newest", "oldest", "largest", "smallest", "name"].includes(sortParam) ? sortParam : "newest") as
  | "newest" | "oldest" | "largest" | "smallest" | "name";
const sizeParam = parseInt(url.searchParams.get("size") || "");
const pageSize = [24, 48, 96].includes(sizeParam) ? sizeParam : 24;

const cur = url.searchParams.get("cur") || "";
const hist = (url.searchParams.get("hist") || "").split("|").filter(Boolean);

// Bộ lọc tình trạng sử dụng: "" | "used" | "orphan"
const usageParam = url.searchParams.get("usage") || "";
const usageFilter = (["used", "orphan"].includes(usageParam) ? usageParam : "") as "" | "used" | "orphan";

const savedMsg = url.searchParams.get("msg");
const savedType = url.searchParams.get("type");

function buildMediaUrl(overrides: Record<string, string>) {
  const u = new URL("/admin/media", Astro.url.origin);
  const base: Record<string, string> = { q, folder, sort: sortKey, size: String(pageSize), usage: usageFilter };
  if (minkb) base.minkb = String(minkb);
  if (from) base.from = from;
  Object.entries({ ...base, ...overrides }).forEach(([k, v]) => {
    if (v) u.searchParams.set(k, v);
    else u.searchParams.delete(k);
  });
  return u.pathname + u.search;
}

// ══════════════════════════════════════════════
// ORPHAN DETECTION — quét toàn bộ tham chiếu ảnh trong Supabase
// ══════════════════════════════════════════════
type UsageTag = "gallery" | "article" | "profile" | "orphan";

const usedGallery = new Set<string>();
const usedArticle = new Set<string>();
const usedProfile = new Set<string>();

try {
  const { data: subs } = await supabase.from("submissions").select("image_pid, image_url");
  (subs || []).forEach((s: { public_id?: string }) => {
    if (s.image_pid && typeof s.image_pid === "string") usedGallery.add(s.image_pid.trim());
    const fromUrl = getCloudinaryPublicIdFromUrl(s.image_url, runtimeEnv);
    if (fromUrl) usedGallery.add(fromUrl);
  });

  const { data: arts } = await supabase.from("articles").select("cover_url, body_md");
  (arts || []).forEach((a: { featured_img?: string }) => {
    const coverPid = getCloudinaryPublicIdFromUrl(a.cover_url, runtimeEnv);
    if (coverPid) usedArticle.add(coverPid);
    getCloudinaryPublicIdsFromText(a.body_md, runtimeEnv).forEach((pid: string) => usedArticle.add(pid));
  });

  const { data: profs } = await supabase.from("profiles").select("avatar_url, banner_url");
  (profs || []).forEach((p: { avatar_url?: string | null; banner_url?: string | null }) => {
    [p.avatar_url, p.banner_url].forEach((u: string | null | undefined) => {
      const pid = getCloudinaryPublicIdFromUrl(u, runtimeEnv);
      if (pid) usedProfile.add(pid);
    });
  });
} catch {
  // Nếu quét lỗi (mạng/RLS) → coi như không có tham chiếu nào, badge sẽ lệch nhưng trang vẫn chạy
}

function usageOf(pid: string): UsageTag {
  if (usedGallery.has(pid)) return "gallery";
  if (usedArticle.has(pid)) return "article";
  if (usedProfile.has(pid)) return "profile";
  return "orphan";
}

const USAGE_LABELS: Record<UsageTag, { text: string; cls: string }> = {
  gallery: { text: "🖼 Tranh đang dùng", cls: "badge-success" },
  article: { text: "📰 Dùng trong bài", cls: "badge-info" },
  profile: { text: "👤 Hồ sơ người dùng", cls: "badge-warning" },
  orphan: { text: "⚠ CHƯA được dùng", cls: "badge-error" },
};

// ── Gọi Cloudinary Search API (có lọc usage → quét gộp nhiều trang nội bộ) ──
const searchOpts = {
  q, folder,
  minBytes: minkb,
  uploadedAfter: from || undefined,
  sortKey,
  nextCursor: cur || undefined,
};

let resources: Array<{ public_id: string; secure_url?: string; bytes?: number; format?: string; created_at?: string; usageTag: string }> = [];
let nextCursor: string | null = null;
let totalCount: number | undefined = undefined;
let scanNote = "";
let resultError: string | null = null;

if (!usageFilter) {
  // Fast-path: một lần gọi duy nhất
  const result = await searchCloudinaryImages({ ...searchOpts, maxResults: pageSize }, runtimeEnv);
  if (result.error) {
    resources = [];
    resultError = result.error;
  } else {
    resources = result.resources.map((r) => ({ ...r, usageTag: usageOf(r.public_id) }));
    totalCount = result.totalCount;
    nextCursor = result.nextCursor;
  }
} else {
  // Quét gộp tối đa 8 trang × 100 ảnh để lấp đầy trang hiện tại theo usage
  let cursorVar: string | undefined = cur || undefined;
  const collected: Array<{ public_id: string }> = [];
  let scannedTotal = 0;
  let searchError: string | null = null;

  for (let page = 0; page < 8; page++) {
    const pr = await searchCloudinaryImages({ ...searchOpts, maxResults: 100, nextCursor: cursorVar }, runtimeEnv);
    if (pr.error) { searchError = pr.error; break; }

    scannedTotal += pr.resources.length;
    for (const r of pr.resources) {
      const tag = usageOf(r.public_id);
      const match = usageFilter === "used" ? tag !== "orphan" : tag === "orphan";
      if (match && collected.length < pageSize) collected.push({ ...r, usageTag: tag });
    }

    const hasMoreRaw = Boolean(pr.nextCursor);
    nextCursor = pr.nextCursor ?? null;
    if (!hasMoreRaw || collected.length >= pageSize) break;
    cursorVar = pr.nextCursor!;
  }

  resources = collected;
  scanNote = `đã quét ${scannedTotal.toLocaleString("vi-VN")} ảnh trong kho`;
  if (searchError) resultError = searchError;
}

// ── Xử lý xóa hàng loạt ──
if (Astro.request.method === "POST" && user) {
  const formData = await Astro.request.formData();
  const action = String(formData.get("action") || "");

  if (action === "bulk_delete") {
    const ids = Array.from(formData.getAll("selectedIds")).map(String).filter(Boolean);
    if (ids.length === 0) {
      return Astro.redirect(buildMediaUrl({ type: "err", msg: encodeURIComponent("Chưa tick chọn ảnh nào."), cur, hist: hist.join("|") }), 303);
    }
    const summary = await deleteCloudinaryImages(ids, runtimeEnv);
    await logAdminAction(supabase, {
      adminId: user.id,
      action: "media_delete",
      targetType: "profile",
      targetId: user.id,
      details: { attempted: summary.attempted, deleted: summary.deleted, skipped: summary.skipped },
    });
    const msg = `Đã xóa ${summary.deleted}/${summary.attempted} ảnh khỏi Cloudinary`
      + (summary.skipped > 0 ? ` (bỏ qua ${summary.skipped})` : "")
      + (summary.errors.length > 0 ? ` · lỗi đầu: ${summary.errors[0].slice(0, 90)}` : "");
    return Astro.redirect(
      buildMediaUrl({ type: summary.deleted > 0 ? "ok" : "err", msg: encodeURIComponent(msg.slice(0, 200)), cur, hist: hist.join("|") }),
      303
    );
  }
}

// Trang hiện tại = số mốc con trỏ đã đi qua + 1
const pageIndex = hist.length + 1;

// URL cho nút Trang sau: đẩy cursor hiện tại vào lịch sử
const nextUrl = nextCursor
  ? buildMediaUrl({ cur: nextCursor, hist: [...hist, cur].filter(Boolean).join("|") })
  : null;
// URL cho nút Trang trước: rút lại mốc cuối của lịch sử
const prevUrl = hist.length > 0
  ? buildMediaUrl({ cur: hist[hist.length - 1], hist: hist.slice(0, -1).join("|") })
  : null;

// Thống kê mồ côi trên trang hiện tại (cho statusbar)
const pageOrphans = resources.filter((r) => r.usageTag === "orphan").length;
const pageUsed = resources.length - pageOrphans;
---

<AdminLayout title="VAPORWAVE MAGAZINE // THƯ VIỆN ẢNH" userProfile={userProfile} activePath="/admin/media">
  {(savedType || savedMsg) && (
    <div class={`win95-container mb-5 font-retro text-xs ${savedType === "ok" ? "border-vapor-green" : "border-red-600"}`}>
      <div class={`win95-header ${savedType === "ok" ? "bg-gradient-to-r from-green-700 to-green-600" : "bg-gradient-to-r from-red-800 to-red-600"}`}>
        <span>{savedType === "ok" ? "✅ MEDIA_OP.OK" : "❌ SYSTEM_ALERT.ERR"}</span>
      </div>
      <div class={`p-3 text-black font-bold ${savedType === "ok" ? "bg-green-100" : "bg-red-100"}`}>{decodeURIComponent(savedMsg || "")}</div>
    </div>
  )}

  {resultError && (
    <div class="win95-container mb-5 max-w-3xl font-retro text-xs border-red-600">
      <div class="win95-header bg-gradient-to-r from-red-800 to-red-600"><span>❌ CLOUD_ERROR.ERR</span></div>
      <div class="p-3 bg-red-100 text-black font-bold">{resultError}</div>
    </div>
  )}

  <div class="text-center py-4 mb-4">
    <h1 class="text-2xl sm:text-3xl font-extrabold uppercase tracking-widest text-vapor-purple font-retro">
      🗃️ MEDIA LIBRARY EXPLORER
    </h1>
    <p class="text-[11px] tracking-wider text-text-secondary mt-1 font-retro uppercase">
      -- TÌM KIẾM · LỌC NÂNG CAO · PHÂN TRANG · DỌN DẸP KHO ẢNH --
    </p>
  </div>

  <!-- Quick filter: tình trạng sử dụng — giữ nguyên các filter khác -->
  <div class="flex flex-wrap items-center gap-2 mb-3 font-retro text-xs">
    <span class="font-bold uppercase text-[10px] text-win-dark mr-1">Tình trạng:</span>
    {[
      { v: "", label: "🌐 TẤT CẢ" },
      { v: "used", label: "🟢 ĐANG DÙNG" },
      { v: "orphan", label: "🔴 MỒ CÔI" },
    ].map((opt) => {
      const params = new URLSearchParams(Astro.url.searchParams);
      if (opt.v) params.set("usage", opt.v); else params.delete("usage");
      params.delete("cur");
      return (
        <a
          href={`/admin/media${params.toString() ? "?" + params.toString() : ""}`}
          class={`win95-btn no-underline font-bold px-3 py-1.5 ${
            usageFilter === opt.v ? "ring-2 ring-vapor-purple bg-vapor-purple/15" : ""
          }`}
          aria-current={usageFilter === opt.v ? "page" : undefined}
        >
          {opt.label}
          {opt.v === "orphan" && usageFilter !== "orphan" && pageOrphans > 0 ? ` (${pageOrphans})` : ""}
        </a>
      );
    })}
  </div>

  <!-- Thanh lọc nâng cao -->
  <form method="GET" action="/admin/media" class="win95-container font-retro text-black mb-4">
    <div class="win95-header">
      <span>🔍 FIND_ALL_FILES.DLL</span>
      <span class="text-[10px] text-vapor-yellow">
        {totalCount !== undefined
          ? `${totalCount.toLocaleString("vi-VN")} ảnh khớp`
          : usageFilter
            ? `${resources.length} ảnh khớp · ${scanNote}`
            : ""}
      </span>
    </div>
    <div class="p-3 bg-win-gray grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3 items-end">
      <div class="col-span-2">
        <label for="f-q" class="block text-[10px] font-bold uppercase mb-1">Tên file chứa...</label>
        <input id="f-q" name="q" value={q} placeholder="VD: vapor, banner, logo..."
          class="w-full px-2 py-1.5 border-2 bg-white text-xs font-retro" style="border-color:#808080 #fff #fff #808080;" />
      </div>
      <div class="col-span-2">
        <label for="f-folder" class="block text-[10px] font-bold uppercase mb-1">Trong thư mục</label>
        <input id="f-folder" name="folder" value={folder} placeholder="VD: YellowCatWeb"
          class="w-full px-2 py-1.5 border-2 bg-white text-xs font-retro" style="border-color:#808080 #fff #fff #808080;" />
      </div>
      <div>
        <label for="f-minkb" class="block text-[10px] font-bold uppercase mb-1">Dung lượng ≥ KB</label>
        <input id="f-minkb" name="minkb" type="number" min="1" value={minkb ?? ""}
          class="w-full px-2 py-1.5 border-2 bg-white text-xs font-retro" style="border-color:#808080 #fff #fff #808080;" />
      </div>
      <div>
        <label for="f-from" class="block text-[10px] font-bold uppercase mb-1">Tải từ ngày</label>
        <input id="f-from" name="from" type="date" value={from}
          class="w-full px-2 py-1.5 border-2 bg-white text-xs font-retro" style="border-color:#808080 #fff #fff #808080;" />
      </div>
      <div>
        <label for="f-usage" class="block text-[10px] font-bold uppercase mb-1">Tình trạng sử dụng</label>
        <select id="f-usage" name="usage" class="w-full px-2 py-1.5 border-2 bg-white text-xs font-retro" style="border-color:#808080 #fff #fff #808080;">
          <option value="" selected={!usageFilter}>Tất cả</option>
          <option value="orphan" selected={usageFilter === "orphan"}>🔴 Mồ côi (chưa dùng)</option>
          <option value="used" selected={usageFilter === "used"}>🟢 Đang sử dụng</option>
        </select>
      </div>
      <div>
        <label for="f-sort" class="block text-[10px] font-bold uppercase mb-1">Sắp xếp</label>
        <select id="f-sort" name="sort" class="w-full px-2 py-1.5 border-2 bg-white text-xs font-retro" style="border-color:#808080 #fff #fff #808080;">
          <option value="newest" selected={sortKey === "newest"}>Mới nhất</option>
          <option value="oldest" selected={sortKey === "oldest"}>Cũ nhất</option>
          <option value="largest" selected={sortKey === "largest"}>Nặng nhất</option>
          <option value="smallest" selected={sortKey === "smallest"}>Nhẹ nhất</option>
          <option value="name" selected={sortKey === "name"}>Theo tên A→Z</option>
        </select>
      </div>
      <div>
        <label for="f-size" class="block text-[10px] font-bold uppercase mb-1">Số ảnh/trang</label>
        <select id="f-size" name="size" class="w-full px-2 py-1.5 border-2 bg-white text-xs font-retro" style="border-color:#808080 #fff #fff #808080;">
          {[24, 48, 96].map((n) => (
            <option value={String(n)} selected={pageSize === n}>{n}</option>
          ))}
        </select>
      </div>
      <div class="col-span-2 md:col-span-4 lg:col-span-6 flex flex-wrap gap-2 justify-end">
        <a href="/admin/media" class="win95-btn no-underline font-bold text-xs px-3 py-1.5">🔄 XÓA LỌC</a>
        <button type="submit" class="win95-btn font-bold text-xs px-5 py-1.5 bg-vapor-purple/20">🔍 ÁP DỤNG BỘ LỌC</button>
      </div>
    </div>
  </form>

  <!-- Bulk bar + lưới ảnh -->
  <form method="POST" action={`/admin/media${url.search}`} id="media-form">
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1.5 mb-3 font-retro text-[11px]">
      <label class="flex items-center gap-1.5 win95-btn font-bold cursor-pointer no-underline">
        <input type="checkbox" id="check-all-media" class="checkbox-vapor" aria-label="Chọn tất cả" />
        Chọn hết
      </label>
      <span class="shrink-0">Đã chọn: <strong id="media-count">0</strong></span>
      <span class="hidden md:inline text-win-dark">
        · Trang {pageIndex}{nextCursor ? "+" : ""} · Hiển thị {resources.length}{totalCount !== undefined ? `/${totalCount}` : ""}
        {usageFilter === "orphan" && scanNote ? ` (${scanNote})` : ""}
      </span>
      {resources.length > 0 && (
        <span class="ml-2 flex gap-1">
          <span class="badge badge-success">🖼 {pageUsed} đang dùng</span>
          <span class={`badge ${pageOrphans > 0 ? "badge-error" : ""}`}>⚠ {pageOrphans} mồ côi (trang này)</span>
        </span>
      )}
      <span class="ml-auto"></span>
      <button
        type="submit"
        name="action"
        value="bulk_delete"
        disabled
        class="win95-btn bulk-del font-bold text-[10px] py-1 px-2 btn-danger shrink-0"
      >
        🗑 XÓA ẢNH ĐÃ CHỌN
      </button>
    </div>

    {!resultError && resources.length === 0 ? (
      <div class="win95-container font-retro text-black p-10 text-center mb-6">
        <span class="text-4xl block mb-3" aria-hidden="true">🗃️</span>
        <p class="font-bold text-sm">Không có ảnh nào khớp bộ lọc hiện tại.</p>
        <p class="text-[10px] text-black/70 mt-1">Thử nạp lại trang đầu hoặc bấm "XÓA LỌC".</p>
      </div>
    ) : (
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-3 mb-4">
        {resources.map((img) => (
          <div
            class="win95-container font-retro text-black relative"
            data-media-card
            data-pid={img.public_id}
            data-usage={img.usageTag}
            data-w={img.width || ""}
            data-h={img.height || ""}
            data-bytes={img.bytes || ""}
            data-date={img.created_at}
            data-fmt={img.format || ""}
            data-folder={img.folder || ""}
          >
            <div class="flex items-center justify-between gap-1 px-1.5 pt-1.5 pb-1">
              <label class="cursor-pointer shrink-0" title="Chọn để xóa">
                <input type="checkbox" name="selectedIds" value={img.public_id} class="checkbox-vapor media-check" />
              </label>
              <span class={`badge ${USAGE_LABELS[img.usageTag as UsageTag].cls} !text-[9px] px-1 py-0 truncate`}>
                {USAGE_LABELS[img.usageTag as UsageTag].text}
              </span>
              <button
                type="button"
                class="detail-btn win95-btn w-6 h-6 p-0 justify-center font-bold text-[11px] shrink-0"
                title="Xem chi tiết & copy link các loại"
                aria-label={`Chi tiết ${img.filename || img.public_id}`}
              >ℹ️</button>
            </div>

            <a
              href={cdnUrl(img.public_id, "f_auto,q_auto,w_800")}
              target="_blank"
              rel="noopener"
              class="block aspect-square overflow-hidden border-b border-win-dark bg-cosmic-black group"
              tabindex="-1"
            >
              <img
                src={cdnUrl(img.public_id, "f_auto,q_auto,w_320,h_240,c_fill")}
                alt={img.filename || img.public_id}
                loading="lazy"
                class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                style="filter:saturate(1.35);"
              />
            </a>

            <div class="p-1.5 space-y-1">
              <p class="text-[10px] font-bold truncate" title={img.filename || img.public_id}>
                📄 {img.filename || img.public_id.split("/").pop()}
              </p>
              <p class="text-[10px] text-win-darkest flex justify-between">
                <span>{img.width && img.height ? `${img.width}×${img.height}` : ""}</span>
                <span>{formatBytes(img.bytes)}</span>
              </p>
              <p class="text-[10px] text-win-dark truncate" title={img.folder || ""}>📁 {img.folder || "root"}</p>
              <div class="flex gap-1">
                <button type="button" class="copy-url-btn win95-btn flex-1 text-[10px] py-0.5 font-bold">🔗 URL</button>
                <button type="button" class="copy-md-btn win95-btn flex-1 text-[10px] py-0.5 font-bold">📝 MD</button>
              </div>
            </div>
          </div>
        ))}
      </div>
    )}

    <!-- Phân trang con trỏ hai chiều -->
    <nav class="pagination-bar mb-8" aria-label="Phân trang thư viện ảnh">
      {prevUrl ? (
        <a href={prevUrl} class="win95-btn no-underline font-bold">◀◀ Trang trước</a>
      ) : (
        <span class="win95-btn text-win-dark">◀◀ Trang trước</span>
      )}
      <span class="page-info">Trang {pageIndex}</span>
      {nextUrl ? (
        <a href={nextUrl} class="win95-btn no-underline font-bold">Trang sau ▶▶</a>
      ) : (
        <span class="win95-btn text-win-dark">{resources.length > 0 ? "Hết kết quả" : "Trang sau ▶▶"}</span>
      )}
    </nav>
  </form>

  <!-- Overlay chi tiết ảnh -->
  <div id="media-detail" hidden class="fixed inset-0 bg-black/80 z-[var(--z-modal)] flex items-center justify-center p-4 backdrop-blur-sm">
    <div role="dialog" aria-modal="true" aria-label="Chi tiết ảnh" class="win95-container max-w-2xl w-full max-h-[90vh] overflow-y-auto font-retro text-black max-h-[92vh] overflow-y-auto">
      <div class="win95-header">
        <span>🖼️ FILE_PROPERTIES.EXE</span>
        <button type="button" id="media-detail-close" class="win95-btn py-0 px-1.5 font-bold" aria-label="Đóng chi tiết">✕</button>
      </div>
      <div class="p-3 bg-win-gray space-y-3">
        <img id="md-preview" src="" alt="" class="w-full max-h-72 object-contain border-2 border-win-dark bg-cosmic-black" />
        <dl class="grid grid-cols-2 gap-x-3 gap-y-1 text-[11px] border-2 border-win-dark bg-white p-2">
          <dt class="font-bold uppercase text-[10px]">Public ID</dt><dd id="md-pid" class="break-all font-mono"></dd>
          <dt class="font-bold uppercase text-[10px]">Tên file</dt><dd id="md-name"></dd>
          <dt class="font-bold uppercase text-[10px]">Kích thước</dt><dd id="md-size"></dd>
          <dt class="font-bold uppercase text-[10px]">Định dạng</dt><dd id="md-fmt"></dd>
          <dt class="font-bold uppercase text-[10px]">Dung lượng</dt><dd id="md-bytes"></dd>
          <dt class="font-bold uppercase text-[10px]">Ngày tải</dt><dd id="md-date"></dd>
          <dt class="font-bold uppercase text-[10px]">Thư mục</dt><dd id="md-folder"></dd>
        </dl>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <button type="button" data-copy="full" class="copy-variant win95-btn text-[10px] py-1.5 font-bold whitespace-nowrap overflow-hidden text-ellipsis">🔗 COPY URL GỐC (1600px)</button>
          <button type="button" data-copy="thumb" class="copy-variant win95-btn text-[10px] py-1.5 font-bold whitespace-nowrap overflow-hidden text-ellipsis">🖼️ COPY URL THUMBNAIL</button>
          <button type="button" data-copy="md" class="copy-variant win95-btn text-[10px] py-1.5 font-bold whitespace-nowrap overflow-hidden text-ellipsis">📝 COPY MARKDOWN</button>
          <button type="button" data-copy="html" class="copy-variant win95-btn text-[10px] py-1.5 font-bold whitespace-nowrap overflow-hidden text-ellipsis">🌐 COPY THẺ HTML</button>
        </div>
      </div>
    </div>
  </div>

  <div id="media-toast" hidden class="fixed bottom-4 left-1/2 -translate-x-1/2 z-[var(--z-toast)] win95-container font-retro text-xs px-4 py-2 bg-win-gray text-black font-bold shadow-xl">
    ✅ Đã copy vào clipboard!
  </div>

  <script is:inline define:vars={{ cloudName }}>
    (function () {
      const toast = document.getElementById("media-toast");
      let toastTimer = null;
      function showToast() {
        if (!toast) return;
        toast.hidden = false;
        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = setTimeout(function () { toast.hidden = true; }, 1800);
      }
      function copyText(text) {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(showToast).catch(function () {});
        }
      }
      function fmtBytes(b) {
        if (!b) return "—";
        if (b < 1024) return b + " B";
        if (b < 1048576) return (b / 1024).toFixed(1) + " KB";
        return (b / 1048576).toFixed(2) + " MB";
      }

      // ── Copy nhanh trên thẻ ──
      document.querySelectorAll("[data-media-card]").forEach(function (card) {
        const pid = card.getAttribute("data-pid");
        const urlBtn = card.querySelector(".copy-url-btn");
        const mdBtn = card.querySelector(".copy-md-btn");

        function delivery(t) {
          const enc = pid.split("/").map(encodeURIComponent).join("/");
          return "https://res.cloudinary.com/" + cloudName + "/image/upload/" + (t ? t + "/" : "") + enc;
        }

        if (urlBtn) urlBtn.addEventListener("click", function () {
          copyText(delivery("f_auto,q_auto,w_1200"));
        });
        if (mdBtn) mdBtn.addEventListener("click", function () {
          const name = (card.querySelector("p[title]") || {}).getAttribute ? card.querySelector("p[title]").textContent.trim() : pid;
          copyText("![" + name.replace(/[[\]]/g, "") + "](" + delivery("f_auto,q_auto,w_1200") + ")");
        });

        // ── Overlay chi tiết ──
        const infoBtn = card.querySelector(".detail-btn");
        if (infoBtn) {
          infoBtn.addEventListener("click", function () {
            const overlay = document.getElementById("media-detail");
            if (!overlay) return;
            const w = card.getAttribute("data-w"), h = card.getAttribute("data-h");
            document.getElementById("md-preview").src = delivery("f_auto,q_auto,w_900");
            document.getElementById("md-pid").textContent = pid;
            document.getElementById("md-name").textContent = card.getAttribute("data-fmt")
              ? ((card.querySelector("p[title]") || { textContent: "" }).textContent.trim() + "." + card.getAttribute("data-fmt"))
              : pid.split("/").pop();
            document.getElementById("md-size").textContent = (w && h) ? w + " × " + h + " px" : "—";
            document.getElementById("md-fmt").textContent = (card.getAttribute("data-fmt") || "").toUpperCase() || "—";
            document.getElementById("md-bytes").textContent = fmtBytes(parseInt(card.getAttribute("data-bytes")));
            const d = new Date(card.getAttribute("data-date"));
            document.getElementById("md-date").textContent = isNaN(d.getTime()) ? "—" : d.toLocaleString("vi-VN");
            document.getElementById("md-folder").textContent = card.getAttribute("data-folder") || "root";
            overlay.dataset.currentPid = pid;
            overlay.hidden = false;
          });
        }
      });

      // ── Đóng overlay chi tiết ──
      const overlay = document.getElementById("media-detail");
      if (overlay) {
        document.getElementById("media-detail-close")?.addEventListener("click", function () { overlay.hidden = true; });
        overlay.addEventListener("click", function (e) { if (e.target === overlay) overlay.hidden = true; });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && !overlay.hidden) overlay.hidden = true;
        });
        overlay.querySelectorAll(".copy-variant").forEach(function (btn) {
          btn.addEventListener("click", function () {
            const pid = overlay.dataset.currentPid;
            if (!pid) return;
            const enc = pid.split("/").map(encodeURIComponent).join("/");
            const base = "https://res.cloudinary.com/" + cloudName + "/image/upload/";
            const kind = btn.getAttribute("data-copy");
            if (kind === "full") copyText(base + "f_auto,q_auto,w_1600/" + enc);
            else if (kind === "thumb") copyText(base + "f_auto,q_auto,w_400,h_300,c_fill/" + enc);
            else if (kind === "md") copyText("![" + pid.split("/").pop() + "](" + base + "f_auto,q_auto,w_1200/" + enc + ")");
            else if (kind === "html") copyText('<img src="' + base + 'f_auto,q_auto,w_1200/' + enc + '" alt="' + pid.split("/").pop() + '" />');
          });
        });
      }

      // ── Chọn tất cả + đếm + xác nhận xóa hàng loạt ──
      const checkAll = document.getElementById("check-all-media");
      const countEl = document.getElementById("media-count");
      function refreshCount() {
        const boxes = Array.prototype.slice.call(document.querySelectorAll(".media-check"));
        const n = boxes.filter(function (b) { return b.checked; }).length;
        if (countEl) countEl.textContent = String(n);
        const delBtn = document.querySelector(".bulk-del");
        if (delBtn) delBtn.disabled = n === 0;
      }
      if (checkAll) {
        checkAll.addEventListener("change", function () {
          document.querySelectorAll(".media-check").forEach(function (b) { b.checked = checkAll.checked; });
          refreshCount();
        });
      }
      document.querySelectorAll(".media-check").forEach(function (b) {
        b.addEventListener("change", refreshCount);
      });
      const delBtn = document.querySelector(".bulk-del");
      if (delBtn) delBtn.addEventListener("click", function (e) {
        const checked = Array.prototype.slice.call(document.querySelectorAll(".media-check")).filter(function (b) { return b.checked; });
        if (checked.length === 0) return;
        const usedCount = checked.filter(function (b) {
      return b.closest("[data-media-card]")?.getAttribute("data-usage") !== "orphan";
    }).length;

        let msg = "🗑 XÓA VĨNH VIỄN " + checked.length + " ảnh khỏi Cloudinary?\n(Thao tác không thể hoàn tác)";
        if (usedCount > 0) {
          msg = "⚠️ CẢNH BÁO NGHIÊM TRỌNG!\n\n" + usedCount + "/" + checked.length + " ảnh đang ĐƯỢC SỬ DỤNG trong tranh/bài viết/hồ sơ.\nXóa sẽ làm GÃY LINK hiển thị công khai!\n\n" + msg;
        }
        // v5: dialogService thay confirm() native (ADR-0002) — 1 dialog duy nhất
        e.preventDefault();
        import("../../ui/wm95/dialogService").then(function (m) {
          m.uiConfirm(msg).then(function (ok) {
            if (ok) form.submit();
          });
        });
      });
      refreshCount();
    })();
  </script>
</AdminLayout>
