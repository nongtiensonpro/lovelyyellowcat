---
import { SearchModal } from "./SearchModal";
import { NotificationBell } from "./NotificationBell";

interface Props {
  userProfile?: { full_name?: string; role?: string; avatar_url?: string } | null;
}

const { userProfile = null } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header class="win95-container w-full mb-6 font-retro site-header relative z-50 select-none">
  <!-- Desktop & Base Header (Win95 Taskbar & Menu) -->
  <div class="flex justify-between items-center bg-win-gray p-1 gap-2 min-h-[44px]">
    <!-- Left Navigation Group with Website Logo -->
    <div class="flex gap-1.5 sm:gap-2 items-center">
      <!-- Website Brand Logo -->
      <a
        href="/"
        class="flex items-center gap-1.5 px-1.5 py-0.5 no-underline group hover:opacity-95 shrink-0"
        title="Lovely Yellow Cat // Vaporwave Art Journal"
      >
        <img
          src="/logo.svg"
          alt="Lovely Yellow Cat Logo"
          class="w-7 h-7 sm:w-8 sm:h-8 object-contain filter drop-glow-pink group-hover:scale-105 transition-transform"
        />
        <div class="hidden sm:flex flex-col leading-none font-retro">
          <span class="font-black text-xs text-black tracking-wider uppercase group-hover:text-vapor-pink transition-colors">
            YELLOW CAT
          </span>
          <span class="text-[10px] font-mono text-win-darkest font-bold tracking-tighter">
            VAPOR_JOURNAL
          </span>
        </div>
      </a>

      <div class="border-l border-win-darkest border-r border-r-win-light h-6 my-auto mx-0.5"></div>

      <!-- Start Button with active press state -->
      <a
        href="/"
        class={`win95-btn font-bold px-2.5 py-1 flex items-center gap-1.5 text-black no-underline ${currentPath === '/' ? 'win95-sunken bg-white/60' : ''}`}
        style="min-height: 32px;"
      >
        <span class="w-3.5 h-3.5 flex items-center justify-center font-mono text-xs">💾</span>
        <span class="tracking-wider">Start</span>
      </a>
      
      <div class="border-l border-win-darkest border-r border-r-win-light h-6 my-auto mx-0.5 hidden md:block"></div>
      
      <!-- Desktop Nav Link Group -->
      <nav class="hidden md:flex gap-1.5 items-center">
        <a
          href="/gallery"
          class={`win95-btn font-bold px-3 py-1 flex items-center gap-1 text-black no-underline ${currentPath.startsWith('/gallery') ? 'win95-sunken bg-vapor-pink/20 text-vapor-pink' : ''}`}
          style="min-height: 32px;"
        >
          <span>🖼️</span> Triển Lãm
        </a>
        <a
          href="/artists"
          class={`win95-btn font-bold px-3 py-1 flex items-center gap-1 text-black no-underline ${currentPath.startsWith('/artists') ? 'win95-sunken bg-vapor-green/20' : ''}`}
          style="min-height: 32px;"
        >
          <span>👥</span> Nghệ Sĩ
        </a>
        <a
          href="/ai"
          class={`win95-btn font-bold px-3 py-1 flex items-center gap-1 text-black no-underline ${currentPath.startsWith('/ai') ? 'win95-sunken bg-vapor-yellow/30 text-black font-extrabold border-2 border-black' : ''}`}
          style="min-height: 32px;"
        >
          <span>🐱</span> Mèo Vàng AI
        </a>
        <a
          href="/about"
          class={`win95-btn font-bold px-3 py-1 flex items-center gap-1 text-black no-underline ${currentPath.startsWith('/about') ? 'win95-sunken bg-vapor-blue/20 text-black font-extrabold border-2 border-black' : ''}`}
          style="min-height: 32px;"
        >
          <span>🛰️</span> Hệ Thống
        </a>
        {userProfile && (
          <a
            href="/favorites"
            class={`win95-btn font-bold px-3 py-1 flex items-center gap-1 text-black no-underline ${currentPath.startsWith('/favorites') ? 'win95-sunken bg-vapor-purple/20' : ''}`}
            style="min-height: 32px;"
          >
            <span>💜</span> Yêu Thích
          </a>
        )}
      </nav>
      
      <div class="border-l border-win-darkest border-r border-r-win-light h-6 my-auto mx-0.5 hidden lg:block"></div>
      <span class="text-[10px] text-win-darkest font-mono font-bold tracking-widest hidden lg:inline bg-win-light/50 px-1.5 py-0.5 border border-win-dark">
        SYS_V2.0 // ONLINE
      </span>
    </div>

    <!-- Right Controls (Desktop System Tray) -->
    <div class="hidden md:flex gap-2 items-center flex-wrap justify-end">
      <!-- Search Modal -->
      <SearchModal client:load />

      <!-- Notification Bell -->
      {userProfile && <NotificationBell client:load currentUser={userProfile} />}

      <!-- Submit Artwork CTA -->
      {userProfile && (
        <a
          href="/submit"
          class={`win95-btn text-xs font-bold text-black no-underline py-1 px-3 bg-vapor-green/25 border-2 border-black ${currentPath === '/submit' ? 'win95-sunken bg-vapor-green/50' : ''}`}
          style="min-height: 32px;"
        >
          <span>🎨</span> Gửi Tranh
        </a>
      )}

      <!-- Admin Panel CTA -->
      {userProfile && (userProfile.role === 'admin' || userProfile.role === 'editor') && (
        <a
          href="/admin"
          class="win95-btn text-xs font-bold text-black no-underline py-1 px-3 bg-vapor-yellow/40 border-2 border-black"
          style="min-height: 32px;"
        >
          <span>⚙️</span> Bảng Quản Trị
        </a>
      )}

      <!-- User Management (Admin Only) -->
      {userProfile && userProfile.role === 'admin' && (
        <a
          href="/admin/users"
          class="win95-btn text-xs font-bold text-black no-underline py-1 px-3 bg-vapor-pink/25 border-2 border-black"
          style="min-height: 32px;"
        >
          <span>👥</span> Người Dùng
        </a>
      )}

      <div class="border-l border-win-darkest border-r border-r-win-light h-6 my-auto mx-0.5"></div>

      <!-- User Profile / Auth State -->
      {userProfile ? (
        <div class="flex gap-2 items-center win95-sunken bg-white/40 px-2 py-0.5">
          <a href={`/profile/${userProfile.id}`} class="flex gap-1.5 items-center no-underline hover:underline text-black">
            <img
              src={userProfile.avatar_url || "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=100&auto=format&fit=crop"}
              alt="Avatar"
              class="w-5 h-5 border border-win-dark object-cover filter saturate-150"
            />
            <span class="text-xs font-bold truncate max-w-[110px]">{userProfile.full_name}</span>
          </a>
          <form action="/api/auth/signout" method="POST" class="m-0">
            <button type="submit" class="win95-btn text-[10px] py-0 px-1 font-bold" style="min-height: 22px;">
              Đăng xuất
            </button>
          </form>
        </div>
      ) : (
        <a href="/api/auth/signin" class="win95-btn text-xs font-bold text-black no-underline py-1 px-3 bg-white" style="min-height: 32px;">
          🔑 Đăng Nhập
        </a>
      )}

      <!-- Realtime Clock Tray -->
      <div id="tray-clock" class="win95-sunken px-2 py-1 text-[10px] font-mono font-bold bg-white text-black shrink-0">
        00:00:00
      </div>
    </div>

    <!-- Mobile Navigation Controls (Hamburger) -->
    <div class="flex md:hidden items-center gap-2">
      {userProfile && <NotificationBell client:load currentUser={userProfile} />}
      <button 
        id="hamburger-btn" 
        class="hamburger-btn win95-btn text-black py-1 px-3 flex items-center justify-center font-bold" 
        aria-label="Mở menu hệ thống" 
        aria-expanded="false"
        aria-controls="mobile-menu-drawer"
        style="min-height: 38px;"
      >
        <span class="mr-1">📂</span> Menu
      </button>
    </div>
  </div>

  <!-- Mobile Menu Drawer (Win95 Popup Window) -->
  <div 
    id="mobile-menu-drawer" 
    class="mobile-menu absolute top-[48px] left-0 right-0 hidden bg-win-gray p-1 win95-window z-50 text-black font-retro shadow-2xl"
    aria-hidden="true"
  >
    <!-- Thanh tiêu đề cửa sổ Win95 của Menu di động -->
    <div class="win95-header bg-gradient-to-r from-vapor-pink to-vapor-purple mb-2">
      <span class="flex items-center gap-1.5 font-bold">
        <img src="/logo.svg" alt="Logo" class="w-4 h-4 object-contain" />
        LOVELY_YELLOW_CAT.EXE
      </span>
      <button id="close-menu-btn" class="win95-btn py-0 px-1.5 font-bold" style="min-height: 20px; font-size: 10px;" aria-label="Đóng thực đơn">✕</button>
    </div>

    <!-- Nội dung Menu điều hướng bên trong cửa sổ sunken -->
    <div class="win95-sunken bg-cosmic-black text-white p-3 space-y-4 max-h-[70vh] overflow-y-auto" style="-webkit-overflow-scrolling: touch;">
      <!-- Brand Header inside Mobile Menu -->
      <div class="flex items-center gap-2 p-2 bg-win-gray text-black win95-raised">
        <img src="/logo.svg" alt="Yellow Cat Logo" class="w-8 h-8 object-contain" />
        <div>
          <h4 class="text-xs font-black uppercase leading-tight font-retro">LOVELY YELLOW CAT</h4>
          <p class="text-[10px] text-win-darkest font-mono font-bold">// VAPORWAVE ART JOURNAL //</p>
        </div>
      </div>

      <!-- Menu Links -->
      <div class="space-y-2">
        <a href="/" class={`block win95-btn text-black font-bold py-2.5 w-full text-center no-underline ${currentPath === '/' ? 'bg-vapor-pink/20 border-vapor-pink text-white font-extrabold' : 'bg-win-gray text-black'}`}>
          💾 TRANG CHỦ (START)
        </a>
        <a href="/gallery" class={`block win95-btn text-black font-bold py-2.5 w-full text-center no-underline ${currentPath.startsWith('/gallery') ? 'bg-vapor-pink/20 border-vapor-pink text-white font-extrabold' : 'bg-win-gray text-black'}`}>
          🖼️ PHÒNG TRIỂN LÃM
        </a>
        <a href="/artists" class={`block win95-btn text-black font-bold py-2.5 w-full text-center no-underline ${currentPath.startsWith('/artists') ? 'bg-vapor-green/20 border-vapor-green text-white font-extrabold' : 'bg-win-gray text-black'}`}>
          👥 DANH SÁCH NGHỆ SĨ
        </a>
        <a href="/ai" class={`block win95-btn text-black font-bold py-2.5 w-full text-center no-underline ${currentPath.startsWith('/ai') ? 'bg-vapor-yellow/40 border-2 border-black text-black font-extrabold' : 'bg-win-gray text-black'}`}>
          🐱 TRẠM AI MÈO VÀNG (1995)
        </a>
        <a href="/about" class={`block win95-btn text-black font-bold py-2.5 w-full text-center no-underline ${currentPath.startsWith('/about') ? 'bg-vapor-blue/30 border-2 border-black text-black font-extrabold' : 'bg-win-gray text-black'}`}>
          🛰️ BẢN ĐỒ HỆ THỐNG
        </a>
        {userProfile && (
          <a href="/favorites" class={`block win95-btn text-black font-bold py-2.5 w-full text-center no-underline ${currentPath.startsWith('/favorites') ? 'bg-vapor-purple/20 border-vapor-purple text-white font-extrabold' : 'bg-win-gray text-black'}`}>
            💜 TRÊN KỆ YÊU THÍCH
          </a>
        )}
      </div>

      <hr class="border-t border-win-dark opacity-40 my-2" />

      <!-- Quick Actions -->
      <div class="space-y-3">
        <div class="win95-container bg-win-gray p-2 text-black space-y-2">
          <span class="block text-[10px] font-bold text-win-dark uppercase">🔍 Tìm kiếm dữ liệu</span>
          <div class="w-full flex justify-center">
            <SearchModal client:load />
          </div>
        </div>

        {userProfile && (
          <>
            <div class="flex gap-2">
              <a href="/submit" class="win95-btn flex-1 text-center py-2.5 text-black font-bold bg-vapor-green/30 border-2 border-black no-underline">
                🎨 Gửi Tranh
              </a>
              {(userProfile.role === 'admin' || userProfile.role === 'editor') && (
                <a href="/admin" class="win95-btn flex-1 text-center py-2.5 text-black font-bold bg-vapor-yellow/40 border-2 border-black no-underline">
                  ⚙️ Admin
                </a>
              )}
            </div>
            {userProfile.role === 'admin' && (
              <a href="/admin/users" class="block win95-btn text-center py-2.5 text-black font-bold bg-vapor-pink/30 border-2 border-black no-underline">
                👥 Quản Lý Người Dùng
              </a>
            )}
          </>
        )}
      </div>

      <hr class="border-t border-win-dark opacity-40 my-2" />

      <!-- User Profile & Session Controls -->
      <div class="p-2 win95-container bg-win-gray text-black flex flex-col items-center gap-3">
        {userProfile ? (
          <>
            <div class="flex items-center gap-2">
              <img src={userProfile.avatar_url || "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=100&auto=format&fit=crop"} alt="Ảnh đại diện" class="w-10 h-10 border border-win-dark filter saturate-150 object-cover" />
              <div class="font-retro leading-tight">
                <span class="block font-bold text-xs">{userProfile.full_name}</span>
                <span class="block text-[10px] text-win-dark font-semibold uppercase">● Vai trò: {userProfile.role}</span>
              </div>
            </div>
            <div class="flex gap-2 w-full">
              <a href={`/profile/${userProfile.id}`} class="win95-btn flex-1 text-center py-2 text-black font-bold no-underline uppercase text-[10px]">
                📁 Hồ sơ
              </a>
              <form action="/api/auth/signout" method="POST" class="m-0 flex-1">
                <button type="submit" class="win95-btn w-full text-center py-2 text-black font-bold uppercase text-[10px]" style="min-height: auto;">
                  🚪 Đăng xuất
                </button>
              </form>
            </div>
          </>
        ) : (
          <a href="/api/auth/signin" class="win95-btn w-full text-center py-2.5 text-black font-bold no-underline uppercase text-xs bg-white">
            🔑 ĐĂNG NHẬP VỚI GOOGLE
          </a>
        )}
      </div>
    </div>
  </div>
</header>

<script>
  // Cập nhật đồng hồ thời gian thực ở Taskbar Tray (tạm dừng khi tab ẩn để tiết kiệm CPU)
  const clockEl = document.getElementById("tray-clock");
  let clockInterval: ReturnType<typeof setInterval> | null = null;

  function updateClock() {
    if (clockEl) {
      clockEl.textContent = new Date().toLocaleTimeString("vi-VN", { hour12: false });
    }
  }
  function startClock() {
    if (!clockInterval) {
      updateClock();
      clockInterval = setInterval(updateClock, 1000);
    }
  }
  function stopClock() {
    if (clockInterval) {
      clearInterval(clockInterval);
      clockInterval = null;
    }
  }
  document.addEventListener("visibilitychange", () => {
    if (document.hidden) { stopClock(); } else { startClock(); }
  });
  startClock();

  // Quản lý đóng/mở Mobile Menu Drawer (khóa scroll nền + Escape + trả focus)
  const hamburgerBtn = document.getElementById('hamburger-btn');
  const closeMenuBtn = document.getElementById('close-menu-btn');
  const mobileMenuDrawer = document.getElementById('mobile-menu-drawer');

  function openMenu() {
    if (hamburgerBtn && mobileMenuDrawer) {
      hamburgerBtn.setAttribute('aria-expanded', 'true');
      mobileMenuDrawer.setAttribute('aria-hidden', 'false');
      mobileMenuDrawer.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      closeMenuBtn?.focus();
    }
  }

  function closeMenu() {
    if (hamburgerBtn && mobileMenuDrawer) {
      hamburgerBtn.setAttribute('aria-expanded', 'false');
      mobileMenuDrawer.setAttribute('aria-hidden', 'true');
      mobileMenuDrawer.classList.add('hidden');
      document.body.style.overflow = '';
      hamburgerBtn.focus();
    }
  }

  if (hamburgerBtn && mobileMenuDrawer) {
    hamburgerBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = hamburgerBtn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeMenu();
      } else {
        openMenu();
      }
    });
  }

  if (closeMenuBtn) {
    closeMenuBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      closeMenu();
    });
  }

  // Phím Escape đóng menu khi đang mở
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileMenuDrawer && !mobileMenuDrawer.classList.contains('hidden')) {
      closeMenu();
    }
  });

  // Click ra ngoài để đóng menu
  document.addEventListener('click', (e) => {
    if (mobileMenuDrawer && !mobileMenuDrawer.classList.contains('hidden')) {
      const target = e.target as HTMLElement;
      if (mobileMenuDrawer && !mobileMenuDrawer.contains(target) && hamburgerBtn && !hamburgerBtn.contains(target)) {
        closeMenu();
      }
    }
  });
</script>
