<script is:inline>
  (function() {
    try {
      const params = new URLSearchParams(window.location.search);
      const reason = params.get("reason");
      const at = params.get("at");
      
      const reasonEl = document.getElementById("banned-reason-text");
      const dateEl = document.getElementById("banned-date-text");
      
      if (reasonEl) {
        if (reason && reason.trim()) {
          reasonEl.textContent = reason.trim();
        } else {
          reasonEl.textContent = "Vi phạm quy tắc cộng đồng / Quyết định của quản trị viên";
        }
      }
      
      if (dateEl) {
        if (at) {
          try {
            const d = new Date(at);
            if (!isNaN(d.getTime())) {
              dateEl.textContent = d.toLocaleString("vi-VN", { 
                day: '2-digit', month: '2-digit', year: 'numeric',
                hour: '2-digit', minute: '2-digit'
              });
            } else {
              dateEl.textContent = at;
            }
          } catch {
            dateEl.textContent = at;
          }
        } else {
          dateEl.textContent = new Date().toLocaleString("vi-VN");
        }
      }
    } catch {}
  })();
</script>

