---
// GameDock.astro — ARCADE.SYS: dock 2 game retro + overlay toàn màn hình.
// Pure logic nằm ở src/lib/games/{pongCore,snakeCore}.ts (test riêng); file này
// chỉ markup + wiring (open/close/focus/input/rAF). CSS-only animation, token colors.
const GAMES = [
  {
    id: "pong",
    file: "PONG.SYS",
    icon: "🏓",
    title: "VAPOR PONG",
    desc: "Máy 1972 gọi lại — paddle chống bóng, hoàng hôn synthwave. BEST lưu máy bạn.",
    hud: "P1 vs CPU · ESC THOÁT",
  },
  {
    id: "snake",
    file: "SNAKE.EXE",
    icon: "🐍",
    title: "NEON SNAKE",
    desc: "Rắn neon ăn ⭐ trên lưới phát sáng. Chạm tường = game over. BEST lưu máy bạn.",
    hud: "MŨI TÊN / WASD · ESC THOÁT",
  },
] as const;
---
<div class="arcade-dock" id="arcade-dock">
  {
    GAMES.map((g) => (
      <button type="button" class="win95-btn arcade-card" data-game={g.id} aria-haspopup="dialog">
        <span class="arcade-card-art" aria-hidden="true">
          <canvas class="arcade-attract" width="480" height="160" data-attract={g.id} aria-hidden="true"></canvas>
          <span class="arcade-card-icon">{g.icon}</span>
        </span>
        <span class="block p-2.5 space-y-1">
          <span class="arcade-card-title text-vapor-purple">
            <span aria-hidden="true">{g.icon}</span> {g.title}
          </span>
          <span class="arcade-card-desc block">{g.desc}</span>
          <span class="arcade-card-desc block text-vapor-blue">▶ CHƠI NGAY — {g.file}</span>
        </span>
      </button>
    ))
  }
</div>

{
  GAMES.map((g) => (
    <div
      class="arcade-overlay"
      id={`arcade-overlay-${g.id}`}
      role="dialog"
      aria-modal="true"
      aria-label={`${g.title} — ${g.file}`}
      data-opener-token="arcade"
      hidden
    >
      <div class={`win95-window arcade-window arcade-window-${g.id}`}>
        <div class="win95-header bg-gradient-to-r from-vapor-purple to-vapor-blue">
          <span class="font-bold text-[11px] flex items-center gap-1.5">
            <span aria-hidden="true">{g.icon}</span> {g.file} — {g.hud}
          </span>
          <button
            type="button"
            class="win95-btn py-0 px-1.5 text-[10px] font-bold"
            data-arcade-close
            aria-label="Đóng game">✕</button
          >
        </div>
        <div class="arcade-canvas-wrap">
          <canvas
            class="arcade-canvas"
            width="960"
            height="540"
            data-arcade-canvas={g.id}
            aria-label={`Bàn chơi ${g.title}`}
          ></canvas>
        </div>
        <div class="arcade-hud">
          <span data-arcade-status={`score-${g.id}`}>SCORE 0</span>
          <span data-arcade-status={`best-${g.id}`}>BEST 0</span>
          <span class="text-vapor-yellow hidden sm:inline">ĐIỂM: BÓNG VƯỢT CPU / ⭐ ĂN ĐƯỢC</span>
          <button type="button" class="win95-btn text-[10px] font-bold py-0.5 px-2" data-arcade-close>
            ESC — THOÁT
          </button>
        </div>
      </div>
    </div>
  ))
}

<script>
  // Wiring overlay + input; physics import từ pure cores (tách test).
  import { init as pongInit, step as pongStep, type PongState } from "../../lib/games/pongCore";
  import { init as snakeInit, step as snakeStep, queueDir as snakeQueueDir, type SnakeState } from "../../lib/games/snakeCore";

  type Cleanup = () => void;
  const cleanups: Record<string, Cleanup | null> = { pong: null, snake: null };
  let lastOpener: HTMLElement | null = null;

  function bestKey(id: string): string {
    return `lyc_arcade_best_${id}`;
  }
  function readBest(id: string): number {
    try {
      return parseInt(localStorage.getItem(bestKey(id)) || "0", 10) || 0;
    } catch {
      return 0;
    }
  }
  function writeBest(id: string, v: number): void {
    try {
      localStorage.setItem(bestKey(id), String(v));
    } catch {
      /* ignore */
    }
  }

  function setStatus(id: string, key: string, text: string): void {
    const el = document.querySelector<HTMLElement>(`[data-arcade-status="${key}"]`);
    if (el) el.textContent = text;
  }

  function openGame(id: string, opener: HTMLElement): void {
    const overlay = document.getElementById(`arcade-overlay-${id}`);
    if (!overlay) return;
    lastOpener = opener;
    overlay.removeAttribute("hidden");
    overlay.classList.add("is-open");
    const canvas = overlay.querySelector<HTMLCanvasElement>(`[data-arcade-canvas="${id}"]`);
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    // ✕ button trong header là nút đầu; nút footer ESC — cả hai đóng.
    const closeBtns = overlay.querySelectorAll<HTMLElement>("[data-arcade-close]");
    closeBtns[0]?.focus();
    const onKey = (e: KeyboardEvent) => {
      if (e.key === "Escape") closeGame(id);
    };
    document.addEventListener("keydown", onKey);
    closeBtns.forEach((b) => b.addEventListener("click", () => closeGame(id)));
    let raf = 0;
    let disposed = false;
    let visibilityHandler: (() => void) | null = null;
    let lastScore = -1;
    let best = readBest(id);

    function loop(): void {
      if (disposed) return;
      // step + render theo game
      if (id === "pong") {
        tickPong();
      } else {
        tickSnake();
      }
      raf = requestAnimationFrame(loop);
    }
    // ── PONG wiring ──
    let pong: PongState | null = null;
    let pongUp = false;
    let pongDown = false;
    let pongMouseY: number | null = null;
    // ── SNAKE wiring ──
    let snake: SnakeState | null = null;
    let snakeAcc = 0;
    let lastTs = 0;

    function tickPong(): void {
      if (!pong) return;
      const input = { up: pongUp, down: pongDown, mouseY: pongMouseY };
      pongStep(pong, input);
      if (pong.score > best) {
        best = pong.score;
        writeBest("pong", best);
      }
      if (pong.score !== lastScore) {
        lastScore = pong.score;
        setStatus("pong", "score-pong", `SCORE ${pong.score}`);
        setStatus("pong", "best-pong", `BEST ${best}`);
      }
      renderPong(ctx!, pong);
    }
    function tickSnake(): void {
      if (!snake) return;
      const now = performance.now();
      const dt = Math.min(120, now - (lastTs || now));
      lastTs = now;
      snakeAcc += dt;
      const cellMs = 110;
      while (snakeAcc >= cellMs) {
        snakeAcc -= cellMs;
        snakeStep(snake);
      }
      if (snake.score > best) {
        best = snake.score;
        writeBest("snake", best);
      }
      if (snake.score !== lastScore) {
        lastScore = snake.score;
        setStatus("snake", "score-snake", `SCORE ${snake.score}`);
        setStatus("snake", "best-snake", `BEST ${best}`);
      }
      renderSnake(ctx!, snake);
    }
    function renderPong(c: CanvasRenderingContext2D, s: PongState): void {
      const W = 960;
      const H = 540;
      const HORIZON = 330;
      const t = s.t;
      // ── nền trời + hoàng hôn gradient
      c.fillStyle = "#0b001a";
      c.fillRect(0, 0, W, H);
      const grad = c.createLinearGradient(0, 0, 0, HORIZON);
      grad.addColorStop(0, "#fffb96");
      grad.addColorStop(0.5, "#ff71ce");
      grad.addColorStop(1, "#b967ff");
      c.fillStyle = grad;
      c.fillRect(0, 0, W, HORIZON);
      // ── SAO nhấp nháy (sin theo thời gian, 3 lớp màu)
      const stars: Array<[number, number, number, string]> = [
        [80, 50, 1.1, "#fffb96"], [220, 110, 0.7, "#01cdfe"], [360, 40, 1.3, "#fffb96"],
        [500, 90, 0.9, "#b967ff"], [640, 55, 1.2, "#ff71ce"], [780, 120, 0.8, "#01cdfe"],
        [880, 45, 1.4, "#fffb96"], [150, 160, 0.6, "#05ffa1"], [430, 150, 1.0, "#fffb96"],
        [700, 170, 0.7, "#b967ff"], [920, 150, 0.9, "#05ffa1"], [300, 85, 0.5, "#ff71ce"],
      ];
      for (let k = 0; k < stars.length; k++) {
        const [sx, sy, sz, col] = stars[k];
        const tw = 0.45 + 0.55 * Math.abs(Math.sin(t * 0.04 + k * 1.7));
        c.globalAlpha = tw;
        c.fillStyle = col;
        c.fillRect(sx, sy, sz * 2, sz * 2);
      }
      c.globalAlpha = 1;
      // ── MẶT TRỜI glow "thở" + sọc cắt
      const sunPulse = 1 + 0.03 * Math.sin(t * 0.03);
      const sunR = 96 * sunPulse;
      c.save();
      c.shadowColor = "#ff71ce";
      c.shadowBlur = 44 + 14 * Math.sin(t * 0.05);
      c.beginPath();
      c.arc(W / 2, 236, sunR, 0, Math.PI * 2);
      c.clip();
      c.fillStyle = grad;
      c.fillRect(W / 2 - sunR, 236 - sunR, sunR * 2, sunR * 2);
      c.restore();
      c.save();
      c.beginPath();
      c.arc(W / 2, 236, sunR + 2, 0, Math.PI * 2);
      c.clip();
      c.fillStyle = "#0b001a";
      for (let y = 216; y < 236 + sunR; y += 13) c.fillRect(W / 2 - sunR, y, sunR * 2, 5);
      c.restore();
      // sọc cắt phần trời dưới mặt trời
      c.fillStyle = "#0b001a";
      for (let y = 236; y < HORIZON; y += 15) c.fillRect(0, y, W, 6);
      // ── LƯỚI SYNTHWAVE chạy về phía người xem
      const gridScroll = (t * 1.6) % 26;
      c.strokeStyle = "rgba(1, 205, 254, 0.45)";
      c.lineWidth = 1;
      for (let i2 = -14; i2 <= 14; i2++) {
        c.beginPath();
        c.moveTo(W / 2, HORIZON);
        c.lineTo(W / 2 + i2 * 90, H);
        c.stroke();
      }
      for (let y = HORIZON + 8; y < H; y += 26) {
        const yy = y + gridScroll;
        if (yy < H) {
          c.beginPath();
          c.moveTo(0, yy);
          c.lineTo(W, yy);
          c.stroke();
        }
      }
      // ── TRAIL bóng mờ dần
      for (let k2 = 0; k2 < s.trail.length; k2++) {
        const p2 = s.trail[k2];
        const a = (k2 / s.trail.length) * 0.34;
        c.globalAlpha = a;
        c.fillStyle = "#fffb96";
        c.fillRect(p2.x - 5, p2.y - 5, 10, 10);
      }
      c.globalAlpha = 1;
      // ── NET đứt đoạn
      c.setLineDash([10, 12]);
      c.strokeStyle = "#e8d5ff";
      c.lineWidth = 2;
      c.beginPath();
      c.moveTo(W / 2, HORIZON);
      c.lineTo(W / 2, H);
      c.stroke();
      c.setLineDash([]);
      // ── PADDLE neon glow (+ flash khi chặn)
      const flashStr = s.flash;
      c.save();
      c.shadowColor = "#05ffa1";
      c.shadowBlur = 16 + flashStr * 26;
      c.fillStyle = "#05ffa1";
      c.fillRect(24, s.playerY, 12, 80);
      c.restore();
      c.save();
      c.shadowColor = "#ff71ce";
      c.shadowBlur = 16 + flashStr * 26;
      c.fillStyle = "#ff71ce";
      c.fillRect(W - 36, s.cpuY, 12, 80);
      c.restore();
      // ── BÓNG glow
      c.save();
      c.shadowColor = "#fffb96";
      c.shadowBlur = 22;
      c.fillStyle = "#fffb96";
      c.fillRect(s.ballX - 6, s.ballY - 6, 12, 12);
      c.restore();
      // ── ĐIỂM lớn giữa trời
      c.fillStyle = "#e8d5ff";
      c.font = "bold 44px monospace";
      c.textAlign = "center";
      c.fillText(String(s.score), W / 2, 64);
      c.textAlign = "left";
      // ── SCANLINE CRT
      c.fillStyle = "rgba(11, 0, 26, 0.16)";
      for (let y = 0; y < H; y += 4) c.fillRect(0, y, W, 2);
    }

    function renderSnake(c: CanvasRenderingContext2D, s: SnakeState): void {
      const W = 960;
      const H = 540;
      const CELL = 30; // 32×18 cell = 960×540
      const t = s.score * 7 + performance.now() * 0.004;
      c.fillStyle = "#0b001a";
      c.fillRect(0, 0, W, H);
      // ── LƯỚI pulse dịu
      const gridA = 0.10 + 0.05 * Math.sin(t * 0.7);
      c.strokeStyle = `rgba(185, 103, 255, ${gridA.toFixed(3)})`;
      c.lineWidth = 1;
      for (let x = 0; x <= W; x += CELL) {
        c.beginPath();
        c.moveTo(x, 0);
        c.lineTo(x, H);
        c.stroke();
      }
      for (let y = 0; y <= H; y += CELL) {
        c.beginPath();
        c.moveTo(0, y);
        c.lineTo(W, y);
        c.stroke();
      }
      // ── THÂN RẮN sóng sáng theo index + thời gian
      s.body.forEach((seg, i3) => {
        const wave = 0.55 + 0.45 * Math.sin(t * 1.6 - i3 * 0.55);
        const glow = i3 === 0 ? "#05ffa1" : i3 % 2 ? "#01cdfe" : "#05ffa1";
        c.save();
        c.globalAlpha = 0.35 + 0.65 * wave;
        c.shadowColor = glow;
        c.shadowBlur = 10 + 10 * wave;
        c.fillStyle = glow;
        const inset = i3 === 0 ? 1 : 2 + (1 - wave) * 2;
        c.fillRect(seg.x * CELL + inset, seg.y * CELL + inset, CELL - inset * 2, CELL - inset * 2);
        c.restore();
      });
      // ── ĐẦU RẮN có MẮT theo hướng
      const head = s.body[0];
      c.save();
      c.translate(head.x * CELL + CELL / 2, head.y * CELL + CELL / 2);
      const rot = s.dir === "right" ? 0 : s.dir === "down" ? Math.PI / 2 : s.dir === "left" ? Math.PI : -Math.PI / 2;
      c.rotate(rot);
      c.fillStyle = "#0b001a";
      c.fillRect(-6, -9, 4.5, 5);
      c.fillRect(-6, 4, 4.5, 5);
      c.restore();
      // ── MỒI ⭐ phồng/xẹp + tia sáng quay
      const pulse = 1 + 0.16 * Math.sin(t * 3);
      c.save();
      c.translate(s.food.x * CELL + CELL / 2, s.food.y * CELL + CELL / 2);
      c.rotate(Math.sin(t * 1.2) * 0.3);
      c.scale(pulse, pulse);
      c.shadowColor = "#fffb96";
      c.shadowBlur = 18;
      c.font = "24px serif";
      c.textAlign = "center";
      c.textBaseline = "middle";
      c.fillStyle = "#fffb96";
      c.fillText("⭐", 0, 1);
      c.restore();
      // ── GAME OVER nhấp đỏ dịu
      if (s.over) {
        c.globalAlpha = 0.72 + 0.28 * Math.sin(t * 4);
        c.fillStyle = "#ff4444";
        c.font = "bold 40px monospace";
        c.textAlign = "center";
        c.fillText("GAME OVER — NHẤN SPACE", W / 2, H / 2 - 10);
        c.globalAlpha = 1;
        c.textAlign = "left";
        c.textBaseline = "alphabetic";
      }
      // ── SCANLINE CRT
      c.fillStyle = "rgba(11, 0, 26, 0.16)";
      for (let y = 0; y < H; y += 4) c.fillRect(0, y, W, 2);
    }

    function onKeyDown(e: KeyboardEvent): void {
      if (id === "pong") {
        if (e.key === "ArrowUp") pongUp = true;
        if (e.key === "ArrowDown") pongDown = true;
      } else {
        const map: Record<string, string> = {
          ArrowUp: "up", ArrowDown: "down", ArrowLeft: "left", ArrowRight: "right",
          w: "up", s: "down", a: "left", d: "right",
        };
        const dir = map[e.key];
        if (dir && snake) snakeQueueDir(snake, dir);
        if (e.key === " " && snake?.over) snake = snakeInit();
      }
    }
    function onKeyUp(e: KeyboardEvent): void {
      if (id === "pong") {
        if (e.key === "ArrowUp") pongUp = false;
        if (e.key === "ArrowDown") pongDown = false;
      }
    }
    function onMouseMove(e: MouseEvent): void {
      if (id !== "pong") return;
      const rect = canvas!.getBoundingClientRect();
      pongMouseY = ((e.clientY - rect.top) / rect.height) * 540;
    }

    if (id === "pong") {
      pong = pongInit();
      pongMouseY = 240;
      document.addEventListener("keydown", onKeyDown);
      document.addEventListener("keyup", onKeyUp);
      canvas.addEventListener("mousemove", onMouseMove);
    } else {
      snake = snakeInit();
      document.addEventListener("keydown", onKeyDown);
    }
    visibilityHandler = () => {
      if (document.hidden && !disposed) {
        // pause: hủy rAF, resume khi visible lại
        cancelAnimationFrame(raf);
        lastTs = 0;
      } else if (!document.hidden && !disposed) {
        lastTs = 0;
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(loop);
      }
    };
    document.addEventListener("visibilitychange", visibilityHandler);
    raf = requestAnimationFrame(loop);

    cleanups[id] = () => {
      disposed = true;
      cancelAnimationFrame(raf);
      document.removeEventListener("keydown", onKey);
      document.removeEventListener("keydown", onKeyDown);
      document.removeEventListener("keyup", onKeyUp);
      canvas.removeEventListener("mousemove", onMouseMove);
      if (visibilityHandler) document.removeEventListener("visibilitychange", visibilityHandler);
      closeBtns.forEach((b) => (b.onclick = null));
    };
  }

  function closeGame(id: string): void {
    const overlay = document.getElementById(`arcade-overlay-${id}`);
    if (!overlay || !overlay.classList.contains("is-open")) return;
    cleanups[id]?.();
    cleanups[id] = null;
    overlay.classList.remove("is-open");
    overlay.setAttribute("hidden", "");
    lastOpener?.focus();
    lastOpener = null;
  }

  document.querySelectorAll<HTMLElement>("[data-game]").forEach((card) => {
    card.addEventListener("click", () => {
      const id = card.getAttribute("data-game") || "";
      openGame(id, card);
    });
  });

  // ── ATTRACT MODE: canvas demo tự chơi trên card (như màn attract máy arcade) ──
  // Pong: 2 AI đối đánh · Snake: AI tham lam đi về ⭐. Chỉ render card trong viewport (IO) + pause khi tab ẩn.
  const AW = 480;
  const AH = 160;
  const attractState: Record<string, { visible: boolean; pong?: Record<string, number>; snake?: { body: Array<{ x: number; y: number }>; dir: string; food: { x: number; y: number }; acc: number; dead: number } }> = {};
  let attractAnyVisible = false;

  function attractRenderPong(c: CanvasRenderingContext2D, s: Record<string, number>): void {
    const HZ = 112;
    c.fillStyle = "#0b001a";
    c.fillRect(0, 0, AW, AH);
    const grad = c.createLinearGradient(0, 0, 0, HZ);
    grad.addColorStop(0, "#fffb96");
    grad.addColorStop(0.5, "#ff71ce");
    grad.addColorStop(1, "#b967ff");
    c.fillStyle = grad;
    c.fillRect(0, 0, AW, HZ);
    c.fillStyle = "#0b001a";
    for (let y = 88; y < HZ; y += 12) c.fillRect(0, y, AW, 4);
    c.strokeStyle = "rgba(1, 205, 254, 0.4)";
    c.lineWidth = 1;
    for (let i = -8; i <= 8; i++) {
      c.beginPath();
      c.moveTo(AW / 2, HZ);
      c.lineTo(AW / 2 + i * 46, AH);
      c.stroke();
    }
    for (let y = HZ + 5; y < AH; y += 11) {
      c.beginPath();
      c.moveTo(0, y);
      c.lineTo(AW, y);
      c.stroke();
    }
    c.setLineDash([5, 6]);
    c.strokeStyle = "#e8d5ff";
    c.beginPath();
    c.moveTo(AW / 2, HZ);
    c.lineTo(AW / 2, AH);
    c.stroke();
    c.setLineDash([]);
    c.save();
    c.shadowColor = "#05ffa1";
    c.shadowBlur = 10;
    c.fillStyle = "#05ffa1";
    c.fillRect(10, s.y1, 7, 30);
    c.restore();
    c.save();
    c.shadowColor = "#ff71ce";
    c.shadowBlur = 10;
    c.fillStyle = "#ff71ce";
    c.fillRect(AW - 17, s.y2, 7, 30);
    c.restore();
    c.save();
    c.shadowColor = "#fffb96";
    c.shadowBlur = 12;
    c.fillStyle = "#fffb96";
    c.fillRect(s.bx - 4, s.by - 4, 8, 8);
    c.restore();
    c.fillStyle = "rgba(11, 0, 26, 0.15)";
    for (let y = 0; y < AH; y += 3) c.fillRect(0, y, AW, 1);
  }

  function attractTickPong(s: Record<string, number>): void {
    if (s.cool > 0) {
      s.cool -= 1;
      return;
    }
    s.y1 += Math.max(-2.3, Math.min(2.3, (s.by - 15 - s.y1) * 0.12));
    s.y2 += Math.max(-2.1, Math.min(2.1, (s.by - 15 - s.y2) * 0.1));
    s.y1 = Math.max(0, Math.min(AH - 30, s.y1));
    s.y2 = Math.max(0, Math.min(AH - 30, s.y2));
    s.bx += s.vx;
    s.by += s.vy;
    if (s.by < 4) { s.by = 4; s.vy = Math.abs(s.vy); }
    if (s.by > AH - 4) { s.by = AH - 4; s.vy = -Math.abs(s.vy); }
    if (s.vx < 0 && s.bx - 4 <= 17 && s.bx - 4 >= 10 && s.by >= s.y1 - 4 && s.by <= s.y1 + 34) {
      s.bx = 21;
      s.vx = Math.abs(s.vx) * 1.03;
      s.vy += ((s.by - (s.y1 + 15)) / 15) * 1.1;
    }
    if (s.vx > 0 && s.bx + 4 >= AW - 17 && s.bx + 4 <= AW - 10 && s.by >= s.y2 - 4 && s.by <= s.y2 + 34) {
      s.bx = AW - 21;
      s.vx = -Math.abs(s.vx) * 1.03;
      s.vy += ((s.by - (s.y2 + 15)) / 15) * 1.1;
    }
    s.vy = Math.max(-3.4, Math.min(3.4, s.vy));
    if (s.bx > AW + 6 || s.bx < -6) {
      s.bx = AW / 2;
      s.by = AH / 2;
      s.vx = 3.4;
      s.vy = (Math.random() - 0.5) * 2.2;
      s.cool = 30;
    }
  }

  function attractRenderSnake(c: CanvasRenderingContext2D, s: { body: Array<{ x: number; y: number }>; food: { x: number; y: number } }): void {
    const CELL = 16;
    c.fillStyle = "#0b001a";
    c.fillRect(0, 0, AW, AH);
    c.strokeStyle = "rgba(185, 103, 255, 0.18)";
    for (let x = 0; x <= AW; x += CELL) {
      c.beginPath();
      c.moveTo(x, 0);
      c.lineTo(x, AH);
      c.stroke();
    }
    for (let y = 0; y <= AH; y += CELL) {
      c.beginPath();
      c.moveTo(0, y);
      c.lineTo(AW, y);
      c.stroke();
    }
    s.body.forEach((seg, k) => {
      const glow = k === 0 ? "#05ffa1" : k % 2 ? "#01cdfe" : "#05ffa1";
      c.save();
      c.shadowColor = glow;
      c.shadowBlur = 8;
      c.fillStyle = glow;
      c.fillRect(seg.x * CELL + 1, seg.y * CELL + 1, CELL - 2, CELL - 2);
      c.restore();
    });
    const head = s.body[0];
    c.fillStyle = "#0b001a";
    c.fillRect(head.x * CELL + 4, head.y * CELL + 5, 3, 4);
    c.fillRect(head.x * CELL + 9, head.y * CELL + 5, 3, 4);
    c.save();
    c.shadowColor = "#fffb96";
    c.shadowBlur = 10;
    c.font = "13px serif";
    c.fillText("⭐", s.food.x * CELL + 2, s.food.y * CELL + 13);
    c.restore();
    c.fillStyle = "rgba(11, 0, 26, 0.15)";
    for (let y = 0; y < AH; y += 3) c.fillRect(0, y, AW, 1);
  }

  function attractTickSnake(s: { body: Array<{ x: number; y: number }>; dir: string; food: { x: number; y: number }; dead: number }): void {
    const CW = AW / 16;
    const CH = AH / 16;
    if (s.dead > 0) {
      s.dead -= 1;
      if (s.dead === 0) {
        s.body = [{ x: 15, y: 5 }, { x: 14, y: 5 }, { x: 13, y: 5 }];
        s.dir = "right";
        s.food = { x: 22, y: 4 };
      }
      return;
    }
    const head = s.body[0];
    const dx = s.food.x - head.x;
    const dy = s.food.y - head.y;
    const prefs: string[] = [];
    if (Math.abs(dx) >= Math.abs(dy)) {
      if (dx > 0) prefs.push("right"); else if (dx < 0) prefs.push("left");
      if (dy > 0) prefs.push("down"); else if (dy < 0) prefs.push("up");
    } else {
      if (dy > 0) prefs.push("down"); else if (dy < 0) prefs.push("up");
      if (dx > 0) prefs.push("right"); else if (dx < 0) prefs.push("left");
    }
    const opp: Record<string, string> = { right: "left", left: "right", up: "down", down: "up" };
    const delta: Record<string, [number, number]> = { right: [1, 0], left: [-1, 0], up: [0, -1], down: [0, 1] };
    const blocked = (x: number, y: number): boolean =>
      x < 0 || y < 0 || x >= CW || y >= CH || s.body.some((b) => b.x === x && b.y === y);
    let dir = "";
    for (const d of prefs) {
      if (d === opp[s.dir]) continue;
      const [ex, ey] = delta[d];
      if (!blocked(head.x + ex, head.y + ey)) { dir = d; break; }
    }
    if (!dir) {
      for (const [d, [ex, ey]] of Object.entries(delta)) {
        if (d === opp[s.dir]) continue;
        if (!blocked(head.x + ex, head.y + ey)) { dir = d; break; }
      }
    }
    if (!dir) {
      s.dead = 40;
      return;
    }
    const [mx, my] = delta[dir];
    const nx = head.x + mx;
    const ny = head.y + my;
    s.dir = dir;
    s.body.unshift({ x: nx, y: ny });
    if (nx === s.food.x && ny === s.food.y) {
      for (let tries = 0; tries < 200; tries++) {
        const fx = Math.floor(Math.random() * CW);
        const fy = Math.floor(Math.random() * CH);
        if (!s.body.some((b) => b.x === fx && b.y === fy)) { s.food = { x: fx, y: fy }; break; }
      }
    } else {
      s.body.pop();
      if (s.body.length > 14) s.body.pop();
    }
  }

  function attractFrame(): void {
    requestAnimationFrame(attractFrame);
    if (document.hidden || !attractAnyVisible) return;
    for (const cv of document.querySelectorAll<HTMLCanvasElement>("[data-attract]")) {
      const id = cv.getAttribute("data-attract") || "";
      const st = attractState[id];
      if (!st || !st.visible) continue;
      const ctx = cv.getContext("2d");
      if (!ctx) continue;
      if (id === "pong" && st.pong) {
        attractTickPong(st.pong);
        attractRenderPong(ctx, st.pong);
      } else if (id === "snake" && st.snake) {
        st.snake.acc += 1;
        if (st.snake.acc >= 6) {
          st.snake.acc = 0;
          attractTickSnake(st.snake);
        }
        attractRenderSnake(ctx, st.snake);
      }
    }
  }

  function startAttract(): void {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const id = (e.target as HTMLElement).getAttribute("data-attract") || "";
          const st = attractState[id];
          if (st) st.visible = e.isIntersecting;
        }
        attractAnyVisible = Object.values(attractState).some((s) => s.visible);
      },
      { threshold: 0.05 },
    );
    for (const cv of document.querySelectorAll<HTMLCanvasElement>("[data-attract]")) {
      const id = cv.getAttribute("data-attract") || "";
      if (id === "pong") {
        attractState[id] = { visible: true, pong: { y1: 65, y2: 65, bx: AW / 2, by: AH / 2, vx: 3.4, vy: 1.4, score: 0, cool: 0 } };
      } else if (id === "snake") {
        attractState[id] = { visible: true, snake: { body: [{ x: 15, y: 5 }, { x: 14, y: 5 }, { x: 13, y: 5 }], dir: "right", food: { x: 22, y: 4 }, acc: 0, dead: 0 } };
      }
      io.observe(cv);
    }
    requestAnimationFrame(attractFrame);
  }

  startAttract();
</script>