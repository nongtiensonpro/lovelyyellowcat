---
import "../styles/global.css";
import { createSupabaseServerClient } from "../lib/supabase";
import HeaderNav from "../components/HeaderNav.astro";
import BootSplash from "../components/BootSplash.astro";
import MarqueeTicker from "../components/MarqueeTicker.astro";
import CassettePlayer from "../components/CassettePlayer.astro";
import AppShell from "../ui/shell/AppShell.astro";
import DialogHost from "../ui/wm95/DialogHost";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  articleJsonLd?: Record<string, unknown>;
  userProfile?: { role?: string } | null;
  showMarquee?: boolean;
}

const {
  title,
  description = "Tạp chí nghệ thuật số phong cách Vaporwave cổ điển // A Cybernetic Oasis",
  ogImage = "https://images.unsplash.com/photo-1508739773434-c26b3d09e071?w=1200&h=630&fit=crop",
  canonicalUrl,
  articleJsonLd,
  userProfile = null,
  showMarquee = true,
} = Astro.props;

const currentUrl = canonicalUrl || Astro.url.href;

// ── Thông báo toàn site (WinPopup Station) ──
// Fetch tối đa 10 announcement active trong hạn, phân loại qua pure module:
// marquee → LIVE.SYS ticker; banner → dải nổi bật; popup → cửa sổ 1 lần/session.
import {
  partitionByType,
  dismissKey,
  safeIdToken,
  accentClassFor,
  fxClassFor,
  iconFor,
  type AnnouncementLike,
} from "../lib/announcementUtils";
import AnnouncementPopup from "../components/AnnouncementPopup.astro";

let annPartition: ReturnType<typeof partitionByType> = { marquee: null, banner: null, popup: null };
try {
  const annSupabase = createSupabaseServerClient({
    request: Astro.request,
    cookies: Astro.cookies,
  });
  const { data } = await annSupabase
    .from("site_announcements")
    .select("id, title, body, type, is_active, end_at, created_at")
    .eq("is_active", true)
    .gt("end_at", new Date().toISOString())
    .order("created_at", { ascending: false })
    .limit(10);
  annPartition = partitionByType((data || []) as AnnouncementLike[]);
} catch {
  // Chưa chạy migration upgrade_v3 → bỏ qua
}
const { marquee: marqueeAnn, banner: siteAnnouncement, popup: popupAnn } = annPartition;
// ANNOUNCE.FX v2 — class màu/hiệu ứng cho banner (null → hành vi cũ).
const bannerAccentClass = siteAnnouncement ? accentClassFor(siteAnnouncement.accent) : "";
const bannerFxClass = siteAnnouncement ? fxClassFor(siteAnnouncement.fx) : "";
const bannerHasFx = Boolean(bannerAccentClass || bannerFxClass);
const bannerIcon = siteAnnouncement ? iconFor(siteAnnouncement) : "🚩";
const bannerDismissKey = siteAnnouncement ? dismissKey(siteAnnouncement.id) : "";
const bannerIdToken = siteAnnouncement ? safeIdToken(siteAnnouncement.id) : "";
---

<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- SEO Canonical -->
    <link rel="canonical" href={currentUrl} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="LOVELYYELLOWCAT RSS Feed"
      href="/rss.xml"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={articleJsonLd ? "article" : "website"} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={currentUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data JSON-LD -->
    {
      articleJsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} is:inline />
      )
    }

    <!-- Google reCAPTCHA v2 Library — chỉ tải tại trang gửi tranh để giảm trọng lượng mọi trang khác -->
    {
      Astro.url.pathname.startsWith("/submit") && (
        <script
          src="https://www.google.com/recaptcha/api.js?render=6Lfn8vgsAAAAANOYL9Am9tLGE1dQteNn_3rKm8g5"
          async
          defer
        />
      )
    }
  </head>
  <body
    class="min-h-screen text-white font-body selection:bg-vapor-pink selection:text-black antialiased bg-cosmic-black"
  >
    <!-- Boot BIOS cho khách lần đầu (1 lần · bỏ qua được · reduced-motion tự ẩn) -->
    <BootSplash />
    <!-- Skip-to-content: điều hướng bàn phím/screen reader -->
    <AppShell
      crt={true}
      role={Astro.props.userProfile && Astro.props.userProfile.role === "admin"
        ? "admin"
        : Astro.props.userProfile
          ? "auth"
          : "public"}
    />
    <DialogHost client:idle />
    <a class="skip-link" href="#main-content">⏭ Bỏ qua tới nội dung chính</a>

    <!-- Outer Black Page Frame (DESIGN-dell-1996 Enterprise Catalog Style) -->
    <div class="min-h-screen bg-cosmic-black">
      <div
        class="w-full flex flex-col min-h-screen justify-between bg-gradient-to-b from-cosmic-black via-cosmic-deep to-cosmic-black px-2 sm:px-4 md:px-6 lg:px-8 relative z-10"
      >
        <!-- Top Banner: Marquee Ticker (ưu tiên thông báo type=marquee đang phát) -->
        {
          showMarquee && (
            <div class="mb-3">
              <MarqueeTicker announcement={marqueeAnn} />
            </div>
          )
        }

        <!-- Thanh điều hướng responsive chuẩn hóa Windows 95 Taskbar -->
        <HeaderNav userProfile={userProfile} />

        <!-- Banner thông báo toàn site (WinPopUp Station) — dismiss theo session -->
        {
          siteAnnouncement && (
            <div
              id={`ann-banner-${bannerIdToken}`}
              class="win95-container mb-3 font-retro text-black"
              role="status"
              data-dismiss-key={bannerDismissKey}
            >
              <div class="flex items-stretch">
                <div
                  class="win95-header bg-gradient-to-r from-vapor-orange to-vapor-pink px-3 py-2 flex items-center gap-2 shrink-0"
                >
                  <span aria-hidden="true">{bannerIcon}</span>
                  <span class="font-bold">THÔNG BÁO</span>
                </div>
                <div class="flex-1 bg-win-gray px-3 py-2 min-w-0 flex items-center gap-2">
                  <!-- Có FX: title thành "màn hình CRT mini" nền tối, chữ accent + hiệu ứng -->
                  {
                    bannerHasFx ? (
                      <p
                        class:list={[
                          "win95-sunken bg-cosmic-black px-2 py-0.5 text-xs font-bold truncate sm:whitespace-normal flex-1",
                          bannerAccentClass,
                          bannerFxClass,
                        ]}
                        title={siteAnnouncement.body || siteAnnouncement.title}
                      >
                        {siteAnnouncement.title}
                        {siteAnnouncement.body && (
                          <span class="hidden md:inline font-normal text-[10px] text-win-light/70">
                            {" "}— {siteAnnouncement.body}
                          </span>
                        )}
                      </p>
                    ) : (
                      <p
                        class="text-xs font-bold truncate sm:whitespace-normal flex-1"
                        title={siteAnnouncement.body || siteAnnouncement.title}
                      >
                        {siteAnnouncement.title}
                        {siteAnnouncement.body && (
                          <span class="hidden md:inline font-normal text-[10px] text-black/70">
                            {" "}— {siteAnnouncement.body}
                          </span>
                        )}
                      </p>
                    )
                  }
                  <button
                    type="button"
                    class="win95-btn px-1.5 py-0 text-[10px] font-bold shrink-0"
                    data-ann-banner-close
                    aria-label="Ẩn thông báo này"
                    style="min-height: 22px; min-width: 22px;"
                  >
                    ✕
                  </button>
                </div>
              </div>
            </div>
          )
        }

        <!-- Popup thông báo type=popup — một lần mỗi session -->
        {
          popupAnn && (
            <AnnouncementPopup announcement={popupAnn} />
          )
        }

        <!-- Nội dung chính -->
        <main id="main-content" class="flex-grow w-full py-2">
          <slot />
        </main>

        <!-- Footer hoài cổ Windows 95 kết hợp Catalog 1996 -->
        <footer
          class="win95-container mt-12 font-retro text-black bg-win-gray text-[10px] sm:text-xs"
        >
          <!-- FOOTER.SYS — băng nghệ thuật hoàng hôn vaporwave (CSS-only, aria-hidden) -->
          <div class="footer-art" aria-hidden="true">
            <div class="footer-art-stars"></div>
            <div class="footer-art-sun"></div>
            <div class="footer-art-grid"></div>
            <div class="footer-art-wordmark">LOVELY YELLOW CAT</div>
            <div class="footer-art-terminal">&gt; FOOTER.SYS LOADED — DỰ ÁN NGHỆ THUẬT SỐ HOÀI CỔ 1995-2026</div>
          </div>

          <!-- Top Footer Bar: Category & Site Links -->
          <div
            class="p-2 border-b border-win-dark flex flex-wrap justify-between items-center gap-2 bg-white/40"
          >
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 bg-vapor-green rounded-full inline-block animate-pulse"
              ></span>
              <span class="font-bold text-win-titlebar">CYBERSERVER: ONLINE // 99.9% UPTIME</span>
            </div>

            <div class="flex flex-wrap items-center gap-3">
              <button
                id="toggle-crt-btn"
                class="win95-btn text-[10px] py-0 px-2 font-bold"
                style="min-height: 22px;"
              >
                📺 CRT: BẬT
              </button>
              <a href="/" class="text-link-blue hover:underline font-bold">Trang Chủ</a>
              <span class="text-win-dark">|</span>
              <a href="/gallery" class="text-link-blue hover:underline font-bold">Triển Lãm</a>
              <span class="text-win-dark">|</span>
              <a href="/artists" class="text-link-blue hover:underline font-bold">Nghệ Sĩ</a>
              <span class="text-win-dark">|</span>
              <a href="/ai" class="text-link-blue hover:underline font-bold">Mèo Vàng AI</a>
              <span class="text-win-dark">|</span>
              <a href="/about" class="text-link-blue hover:underline font-bold">Hệ Thống</a>
              <span class="text-win-dark">|</span>
              <a href="/terms" class="text-link-blue hover:underline font-bold"
                >Điều Khoản (Terms)</a
              >
            </div>
          </div>

          <!-- Middle Footer Bar: Open Source & MIT License Announcement -->
          <div
            class="p-2.5 bg-black/5 border-b border-win-dark flex flex-col sm:flex-row items-center justify-between gap-2"
          >
            <div class="flex items-center gap-2 text-center sm:text-left">
              <span class="text-base">🔓</span>
              <p class="text-[10px] sm:text-[11px] text-black/85 leading-tight">
                <strong>Dự án Mã nguồn mở:</strong> Toàn bộ mã nguồn được công khai minh bạch tại
                <a
                  href="https://github.com/nongtiensonpro/lovelyyellowcat"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-link-blue underline font-bold inline-flex items-center gap-0.5 hover:text-vapor-pink"
                >
                  nongtiensonpro/lovelyyellowcat ↗
                </a>
                với điều khoản sử dụng là giấy phép <span
                  class="bg-win-dark/10 px-1 py-0.5 border border-win-dark font-mono font-bold text-[10px]"
                  >MIT LICENSE</span
                >
              </p>
            </div>
            <a
              href="https://github.com/nongtiensonpro/lovelyyellowcat"
              target="_blank"
              rel="noopener noreferrer"
              class="win95-btn font-bold text-[10px] py-1 px-2.5 flex items-center gap-1.5 text-black no-underline bg-white shrink-0 hover:bg-vapor-yellow/30"
              style="min-height: 26px;"
            >
              <span>🐙</span> GitHub Repository
            </a>
          </div>

          <!-- Bottom Footer Bar: Copyright & Contact -->
          <div class="flex flex-col md:flex-row justify-between items-center gap-2 p-2">
            <span
              class="text-center md:text-left text-black/80 font-mono text-[10px] sm:text-[10px]"
            >
              📼 LOVELY YELLOW CAT &copy; 1995-2026 // DỰ ÁN NGHỆ THUẬT SỐ PHI THƯƠNG MẠI (MIT)
            </span>
            <div class="flex items-center gap-2">
              <span class="text-win-dark font-mono text-[10px]">BEST VIEWED AT 1024x768</span>
              <span class="text-win-dark">|</span>
              <a
                href="mailto:nongtiensonpro@gmail.com"
                class="text-black font-bold no-underline hover:underline text-[10px]"
              >
                ✉️ nongtiensonpro@gmail.com
              </a>
            </div>
          </div>
        </footer>

        <!-- Floating Compact Cassette Player Widget on Bottom-Right -->
        <aside class="fixed bottom-4 right-4 z-40 hidden md:block" aria-label="Audio Player Widget">
          <CassettePlayer />
        </aside>
      </div>
    </div>

    <!-- Script điều khiển CRT Overlay Toggle -->
    <script>
      const crtBtn = document.getElementById("toggle-crt-btn");
      const crtLayer = document.getElementById("crt-overlay-layer");
      const crtLine = document.getElementById("crt-animated-line");

      let crtEnabled = localStorage.getItem("vapor_crt_mode") !== "disabled";

      function updateCrtDisplay() {
        if (crtLayer && crtLine && crtBtn) {
          if (crtEnabled) {
            crtLayer.classList.remove("crt-disabled");
            crtLine.classList.remove("hidden");
            crtBtn.textContent = "📺 CRT: BẬT";
          } else {
            crtLayer.classList.add("crt-disabled");
            crtLine.classList.add("hidden");
            crtBtn.textContent = "📺 CRT: TẮT";
          }
        }
      }

      if (crtBtn) {
        crtBtn.addEventListener("click", () => {
          crtEnabled = !crtEnabled;
          localStorage.setItem("vapor_crt_mode", crtEnabled ? "enabled" : "disabled");
          updateCrtDisplay();
        });
      }

      // Khởi tạo trạng thái ban đầu
      updateCrtDisplay();
    </script>

    <!-- 🎮 Easter egg: Konami Code → VAPOR MODE -->
    <script>
      (function () {
        const SEQUENCE = [
          "ArrowUp",
          "ArrowUp",
          "ArrowDown",
          "ArrowDown",
          "ArrowLeft",
          "ArrowRight",
          "ArrowLeft",
          "ArrowRight",
          "b",
          "a",
        ];
        let progress = 0;

        function showToast(text) {
          const el = document.createElement("div");
          el.className = "win95-container";
          el.style.cssText =
            "position:fixed;bottom:20px;left:50%;transform:translateX(-50%);" +
            "z-index:10001;padding:3px;font-family:'MS Sans Serif',Tahoma;font-size:12px;" +
            "font-weight:bold;color:#000;box-shadow:4px 4px 0 rgba(0,0,0,.6)";
          el.textContent = text;
          document.body.appendChild(el);
          setTimeout(function () {
            el.remove();
          }, 2600);
        }

        document.addEventListener("keydown", function (e) {
          const key = e.key.length === 1 ? e.key.toLowerCase() : e.key;
          if (key === SEQUENCE[progress]) {
            progress++;
            if (progress === SEQUENCE.length) {
              progress = 0;
              const on = document.documentElement.classList.toggle("vapor-mode");
              showToast(on ? "🎮 KONAMI CODE — VAPOR MODE: ON 🌈" : "🎮 VAPOR MODE: OFF");
            }
          } else {
            progress = key === SEQUENCE[0] ? 1 : 0;
          }
        });
      })();
    </script>
    <script>
      // Banner dismiss: sessionStorage theo id announcement (một lần mỗi session).
      (function () {
        document.querySelectorAll<HTMLElement>("[data-ann-banner-close]").forEach(function (btn) {
          const banner = btn.closest<HTMLElement>("[data-dismiss-key]");
          if (!banner) return;
          const key = banner.getAttribute("data-dismiss-key") || "";
          try {
            if (key && sessionStorage.getItem(key) === "1") {
              banner.remove();
              return;
            }
          } catch {
            /* storage bị chặn — vẫn hiện */
          }
          btn.addEventListener("click", function () {
            banner.remove();
            try {
              if (key) sessionStorage.setItem(key, "1");
            } catch {
              /* ignore */
            }
          });
        });
      })();
    </script>
  </body>
</html>
